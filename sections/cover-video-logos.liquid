{%- liquid
  assign block = section.blocks | where: 'type', 'video' | first
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign logos_size = logo_blocks | size

  assign title = block.settings.title
  assign subtitle = block.settings.subtitle
  assign text_paragraph = block.settings.text_paragraph
  assign button_label = block.settings.button_label
  assign button_link = block.settings.button_link
  assign video_desktop = block.settings.video_desktop
  assign poster = block.settings.poster

  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height

  assign desktop_align_x = section.settings.desktop_align_x
  assign desktop_align_y = section.settings.desktop_align_y
  assign desktop_text_align = section.settings.desktop_text_align
  assign mobile_align_x = section.settings.mobile_align_x
  assign mobile_align_y = section.settings.mobile_align_y
  assign mobile_text_align = section.settings.mobile_text_align

  assign button_exists = false
  if button_label != blank and button_link != blank
    assign button_exists = true
  endif

  assign uid = section.id | replace: '-', '' | downcase
-%}

<div class="cvl cvl-{{ uid }}"
     data-section-id="{{ section.id }}"
     data-section-type="cover-video-logos"
     style="
       --cvl-height-desktop: {{ desktop_height }}vh;
       --cvl-height-mobile: {{ mobile_height }}px;
       --cvl-align-x-desktop: {{ desktop_align_x }};
       --cvl-align-y-desktop: {{ desktop_align_y }};
       --cvl-text-align-desktop: {{ desktop_text_align }};
       --cvl-align-x-mobile: {{ mobile_align_x }};
       --cvl-align-y-mobile: {{ mobile_align_y }};
       --cvl-text-align-mobile: {{ mobile_text_align }};
       --cvl-logos-size: {{ logos_size }};
       --cvl-subtitle-color: {{ section.settings.subtitle_color }};
       --cvl-title-color: {{ section.settings.title_color }};
       --cvl-text-color: {{ section.settings.text_color }};
       --cvl-overlay-color: {{ section.settings.overlay_color }};
       --cvl-logos-bg: {{ section.settings.logos_bg_color }};
       --cvl-arrow-color: {{ section.settings.arrow_color }};
       --cvl-dot-color: {{ section.settings.dot_color }};
       --cvl-dot-active-color: {{ section.settings.dot_active_color }};
     ">

  {%- comment -%} ===== VIDEO ===== {%- endcomment -%}
  {%- if block != blank -%}
    <div class="cvl-video-stage">

      {%- if video_desktop != blank -%}
        <video class="cvl-video"
               autoplay
               loop
               muted
               playsinline
               preload="auto"
               {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% endif %}>
          {%- for source in video_desktop.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- else -%}
        <div class="cvl-video-placeholder">
          {%- if poster != blank -%}
            <img src="{{ poster | image_url: width: 1600 }}" alt="{{ poster.alt | escape }}" loading="lazy">
          {%- else -%}
            <p>Agrega un video desde el editor.</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cvl-overlay"></div>

      {%- comment -%} ===== TEXTO CENTRADO ===== {%- endcomment -%}
      <div class="cvl-info">
        <div class="cvl-info-inner">
          {%- unless subtitle == blank -%}
            <p class="cvl-subtitle">{{ subtitle }}</p>
          {%- endunless -%}

          {%- unless title == blank -%}
            <h2 class="cvl-title section-title-richtext">{{ title }}</h2>
          {%- endunless -%}

          {%- unless text_paragraph == blank -%}
            <p class="cvl-text">{{ text_paragraph }}</p>
          {%- endunless -%}

          {%- if button_exists -%}
            {%- capture target -%}
              {%- if button_link contains 'http' or button_link contains 'tel:' or button_link contains 'mailto:' -%}target="_blank" rel="noopener"{%- endif -%}
            {%- endcapture -%}
            <div class="cvl-button-wrapper">
              <a class="cvl-cta button primary-button" href="{{ button_link }}" {{ target }}>{{ button_label }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  {%- endif -%}

  {%- comment -%} ===== CARRUSEL DE LOGOS ===== {%- endcomment -%}
  {%- if logos_size > 0 -%}
    <div class="cvl-logos">
      <div class="cvl-logos-viewport">
        <div class="cvl-logos-track">
          {%- for logo in logo_blocks -%}
            <div class="cvl-logo" {{ logo.shopify_attributes }}>
              {%- if logo.settings.image != blank -%}
                {%- if logo.settings.link != blank -%}
                  <a href="{{ logo.settings.link }}" aria-label="{{ logo.settings.image.alt | default: 'Logo' | escape }}">
                {%- endif -%}
                <img class="cvl-logo-image"
                     src="{{ logo.settings.image | image_url: width: 320 }}"
                     alt="{{ logo.settings.image.alt | escape }}"
                     width="{{ logo.settings.image.width }}"
                     height="{{ logo.settings.image.height }}"
                     loading="lazy">
                {%- if logo.settings.link != blank -%}</a>{%- endif -%}
              {%- else -%}
                <div class="cvl-logo-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <button class="cvl-logos-arrow prev" type="button" aria-label="Logos anteriores">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="cvl-logos-arrow next" type="button" aria-label="Logos siguientes">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="cvl-logos-dots">
        {%- for logo in logo_blocks -%}
          <button class="cvl-logos-dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-index="{{ forloop.index0 }}"
                  aria-label="Ir al logo {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</div>

{% style %}
.cvl-{{ uid }} {
  --cvl-green: #2d7a3e;
  --cvl-green-soft: #a8c8a0;
}

/* ===== VIDEO ===== */
.cvl-{{ uid }} .cvl-video-stage {
  position: relative;
  width: 100%;
  height: var(--cvl-height-desktop, 100vh);
  overflow: hidden;
}

.cvl-{{ uid }} .cvl-video,
.cvl-{{ uid }} .cvl-video-placeholder img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cvl-{{ uid }} .cvl-video-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8efe2;
  color: var(--cvl-green);
}

.cvl-{{ uid }} .cvl-overlay {
  position: absolute;
  inset: 0;
  background: var(--cvl-overlay-color, rgba(255, 255, 255, 0.45));
  z-index: 1;
}

/* ===== TEXTO ===== */
.cvl-{{ uid }} .cvl-info {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: var(--cvl-align-y-desktop, center);
  justify-content: var(--cvl-align-x-desktop, center);
  padding: 40px var(--info-padding, 60px);
  box-sizing: border-box;
}

.cvl-{{ uid }} .cvl-info-inner {
  max-width: 640px;
  text-align: var(--cvl-text-align-desktop, center);
  color: var(--cvl-green);
}

.cvl-{{ uid }} .cvl-subtitle {
  font-family: var(--primary-font-bold);
  font-size: 16px;
  letter-spacing: 1.4px;
  margin-bottom: 8px;
  color: var(--cvl-subtitle-color, var(--cvl-green));
}

.cvl-{{ uid }} .cvl-title,
.cvl-{{ uid }} .cvl-title * {
  font-size: clamp(34px, calc(34px + (64 - 34) * ((100vw - 360px) / (1440 - 360))), 64px);
  line-height: 1.05;
  color: var(--cvl-title-color, var(--cvl-green));
}

.cvl-{{ uid }} .cvl-text {
  margin-top: 15px;
  line-height: 22px;
  color: var(--cvl-text-color, var(--cvl-green));
}

.cvl-{{ uid }} .cvl-button-wrapper {
  margin-top: 20px;
}

/* ===== CARRUSEL DE LOGOS ===== */
.cvl-{{ uid }} .cvl-logos {
  position: relative;
  background: var(--cvl-logos-bg, #eef4e7);
  padding: 36px 56px;
}

.cvl-{{ uid }} .cvl-logos-viewport {
  overflow: hidden;
}

.cvl-{{ uid }} .cvl-logos-track {
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  gap: 12px;
  transition: transform .4s ease;
}

.cvl-{{ uid }} .cvl-logo {
  flex: 0 0 auto;
  width: calc((100% - 12px * (var(--cvl-logos-size, 5) - 1)) / var(--cvl-logos-size, 5));
  display: flex;
  align-items: center;
  justify-content: center;
}

.cvl-{{ uid }} .cvl-logo-image {
  max-width: 100%;
  max-height: 110px;
  width: auto;
  height: auto;
  object-fit: contain;
}

.cvl-{{ uid }} .cvl-logo-placeholder {
  width: 100%;
  opacity: .4;
}

/* Flechas */
.cvl-{{ uid }} .cvl-logos-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  padding: 0;
  background: transparent;
  border: 0;
  color: var(--cvl-arrow-color, var(--cvl-green));
  cursor: pointer;
}

.cvl-{{ uid }} .cvl-logos-arrow svg {
  width: 22px;
  height: 22px;
}

.cvl-{{ uid }} .cvl-logos-arrow.prev { left: 12px; }
.cvl-{{ uid }} .cvl-logos-arrow.next { right: 12px; }

.cvl-{{ uid }} .cvl-logos-arrow:disabled {
  opacity: .3;
  cursor: default;
}

/* Flechas y dots: ocultos en desktop/tablet (grid fijo 1x5), solo en móvil */
.cvl-{{ uid }} .cvl-logos-arrow {
  display: none;
}

.cvl-{{ uid }} .cvl-logos-dots {
  display: none;
  justify-content: center;
  gap: 8px;
  margin-top: 18px;
}

.cvl-{{ uid }} .cvl-logos-dot {
  width: 9px;
  height: 9px;
  padding: 0;
  background: var(--cvl-dot-color, var(--cvl-green-soft));
  border: 0;
  border-radius: 50%;
  cursor: pointer;
  transition: background .2s ease;
}

.cvl-{{ uid }} .cvl-logos-dot.is-active {
  background: var(--cvl-dot-active-color, var(--cvl-green));
}

/* ===== TABLET: sigue 1x5, tamaños ajustados ===== */
@media (max-width: 1024px) {
  .cvl-{{ uid }} .cvl-logos {
    padding: 30px 32px;
  }
  .cvl-{{ uid }} .cvl-logos-track {
    gap: 8px;
  }
  .cvl-{{ uid }} .cvl-logo {
    width: calc((100% - 8px * (var(--cvl-logos-size, 5) - 1)) / var(--cvl-logos-size, 5));
  }
  .cvl-{{ uid }} .cvl-logo-image {
    max-height: 70px;
  }
}

/* ===== MOBILE ===== */
@media (max-width: 680px) {
  .cvl-{{ uid }} .cvl-video-stage {
    height: var(--cvl-height-mobile, 600px);
  }

  .cvl-{{ uid }} .cvl-info {
    align-items: var(--cvl-align-y-mobile, center);
    justify-content: var(--cvl-align-x-mobile, center);
    padding: 40px var(--header-mobile-padding, 20px);
  }

  .cvl-{{ uid }} .cvl-info-inner {
    text-align: var(--cvl-text-align-mobile, center);
  }

  .cvl-{{ uid }} .cvl-logos {
    padding: 28px 44px;
  }

  /* 1 logo a la vez */
  .cvl-{{ uid }} .cvl-logo {
    width: 100%;
  }

  .cvl-{{ uid }} .cvl-logo-image {
    max-height: 130px;
  }

  /* Flechas y dots visibles solo en móvil */
  .cvl-{{ uid }} .cvl-logos-arrow {
    display: flex;
  }

  .cvl-{{ uid }} .cvl-logos-dots {
    display: flex;
  }
}
{% endstyle %}

<script>
(function () {
  var root = document.querySelector('.cvl-{{ uid }}');
  if (!root) return;

  /* ===== VIDEO AUTOPLAY ===== */
  /* Refuerza la reproducción automática: algunos navegadores la difieren */
  var video = root.querySelector('.cvl-video');
  if (video) {
    video.muted = true;
    var tryPlay = function () {
      var p = video.play();
      if (p && typeof p.catch === 'function') {
        p.catch(function () { /* el navegador lo reintenta al interactuar */ });
      }
    };
    if (video.readyState >= 2) {
      tryPlay();
    } else {
      video.addEventListener('loadeddata', tryPlay, { once: true });
    }
  }

  /* ===== CARRUSEL DE LOGOS ===== */
  var logosWrap = root.querySelector('.cvl-logos');
  if (!logosWrap) return;

  var viewport = logosWrap.querySelector('.cvl-logos-viewport');
  var track    = logosWrap.querySelector('.cvl-logos-track');
  var slides   = Array.prototype.slice.call(logosWrap.querySelectorAll('.cvl-logo'));
  var prevBtn  = logosWrap.querySelector('.cvl-logos-arrow.prev');
  var nextBtn  = logosWrap.querySelector('.cvl-logos-arrow.next');
  var dots     = Array.prototype.slice.call(logosWrap.querySelectorAll('.cvl-logos-dot'));
  var index = 0;

  function gap() {
    return parseFloat(getComputedStyle(track).gap) || 0;
  }

  function step() {
    if (!slides.length) return 0;
    return slides[0].offsetWidth + gap();
  }

  function maxIndex() {
    var visible = Math.max(1, Math.round(viewport.offsetWidth / step()));
    return Math.max(0, slides.length - visible);
  }

  function isMobile() {
    return window.matchMedia('(max-width: 680px)').matches;
  }

  function update() {
    // En desktop/tablet: grid fijo 1x5, sin slider
    if (!isMobile()) {
      track.style.transform = 'translateX(0)';
      index = 0;
      logosWrap.classList.remove('has-overflow');
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === 0); });
      return;
    }

    // En móvil: slider 1 a la vez
    logosWrap.classList.add('has-overflow');
    if (index > maxIndex()) index = maxIndex();
    track.style.transform = 'translateX(' + (-index * step()) + 'px)';

    if (prevBtn) prevBtn.disabled = index <= 0;
    if (nextBtn) nextBtn.disabled = index >= maxIndex();

    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === index);
    });
  }

  function goTo(i) {
    if (!isMobile()) return;
    index = Math.max(0, Math.min(i, maxIndex()));
    update();
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(index - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(index + 1); });

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      goTo(parseInt(dot.dataset.index, 10));
    });
  });

  /* Swipe táctil */
  var startX = 0, dragging = false;
  viewport.addEventListener('touchstart', function (e) {
    startX = e.touches[0].clientX;
    dragging = true;
  }, { passive: true });

  viewport.addEventListener('touchend', function (e) {
    if (!dragging) return;
    dragging = false;
    var diff = e.changedTouches[0].clientX - startX;
    if (Math.abs(diff) > 40) {
      goTo(diff < 0 ? index + 1 : index - 1);
    }
  }, { passive: true });

  window.addEventListener('resize', update);
  slides.forEach(function (s) {
    var img = s.querySelector('img');
    if (img && !img.complete) img.addEventListener('load', update);
  });

  update();
})();
</script>

{% schema %}
{
  "name": "Portada video + logos",
  "tag": "section",
  "class": "cover-video-logos-section",
  "settings": [
    {
      "type": "header",
      "content": "Altura de la sección"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Altura en escritorio (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Altura en móvil (px)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "🎨 Colores"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del párrafo",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color del overlay (sobre el video)",
      "info": "Capa de color encima del video. Usa la transparencia (alpha) para que se vea el video debajo.",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "color",
      "id": "logos_bg_color",
      "label": "Fondo de la zona de logos",
      "default": "#eef4e7"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Color de las flechas (móvil)",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Color de los dots",
      "default": "#a8c8a0"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Color del dot activo",
      "default": "#2d7a3e"
    },
    {
      "type": "header",
      "content": "Posición del texto — Escritorio"
    },
    {
      "type": "select",
      "id": "desktop_align_x",
      "label": "Posición horizontal (escritorio)",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_align_y",
      "label": "Posición vertical (escritorio)",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_text_align",
      "label": "Alineación del texto (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Posición del texto — Móvil"
    },
    {
      "type": "select",
      "id": "mobile_align_x",
      "label": "Posición horizontal (móvil)",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_align_y",
      "label": "Posición vertical (móvil)",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Alineación del texto (móvil)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "name": "Video",
      "type": "video",
      "limit": 1,
      "settings": [
        {
          "type": "video",
          "id": "video_desktop",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Imagen de portada (poster)",
          "info": "Se muestra mientras el video carga."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text_paragraph",
          "label": "Párrafo descriptivo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        }
      ]
    },
    {
      "name": "Logo",
      "type": "logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portada video + logos",
      "category": "Colección",
      "blocks": [
        { "type": "video" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
