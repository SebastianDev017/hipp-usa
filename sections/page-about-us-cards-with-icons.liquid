{%- liquid 
  assign title_1 = section.settings.title_1
  assign title = section.settings.title
  assign text = section.settings.text
  assign uid = section.id | replace: '-', '' | downcase
-%}

{{- "css-page-about-us-cards-with-icons.css" | asset_url | stylesheet_tag -}}
<script defer src="{{- 'js-page-about-us-cards-with-icons.js' | asset_url -}}"></script>

<div class="pau-cwi-container pau-cwi-{{ uid }}" data-section-id="{{- section.id -}}" data-section-type="pau-cards-with-icons"
     style="
       --pau-cols-d: {{ section.settings.columns_desktop }};
       --pau-cols-m: {{ section.settings.columns_mobile }};
       --pau-card-bg: {{ section.settings.card_bg_color }};
       --pau-card-radius: {{ section.settings.card_radius }}px;
       --pau-back-text-color: {{ section.settings.back_text_color }};
       --pau-back-hl-color: {{ section.settings.back_highlight_color }};
       --pau-back-title-color: {{ section.settings.back_title_color }};
       --pau-fade-speed: {{ section.settings.fade_speed }}ms;
       --pau-logo-size-d: {{ section.settings.logo_size_desktop }}px;
       --pau-logo-size-m: {{ section.settings.logo_size_mobile }}px;
     ">

  <div class="pau-cwi-content">

    {%- if title != blank or text != blank or title_1 != blank -%}
      <div class="pau-cwi-header">
        <header class="pau-cwi-header-title-wrapper">
          {%- if title_1 != blank -%}
            <p class="pau-cwi-title-1 title-1">{{ title_1 }}</p>
          {%- endif -%}
          {%- if title != blank -%}
            <h2 class="pau-cwi-header-title section-title-richtext">{{ title }}</h2>
          {%- endif -%}
        </header>

        {%- if text != blank -%}
          <div class="pau-cwi-header-text-wrapper">
            <p class="pau-cwi-header-text">{{ text }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pau-cwi-items pau-cwi-flip-items">

      {%- for block in section.blocks -%}
        {%- liquid 
          assign card_logo = block.settings.card_logo
          assign card_title = block.settings.card_title
          assign card_back_text = block.settings.card_back_text
          assign card_url = block.settings.card_url
          assign has_back = false
          if card_back_text != blank or card_title != blank
            assign has_back = true
          endif
        -%}

        <div class="pau-cwi-item flip-card{% unless has_back %} no-flip{% endunless %}"
             {% if has_back %}data-flip tabindex="0" role="button" aria-label="{{ card_title | default: 'Ver más información' | escape }}"{% endif %}
             {{ block.shopify_attributes }}>
          <div class="flip-inner">

            <div class="flip-face flip-front">
              {%- if card_logo != blank -%}
                <picture class="picture-wrapper">
                  <img class="back-img pau-cwi-item-image" alt="{{ card_logo.alt | escape }}" loading="lazy" src="{{ card_logo | image_url: width: 800 }}">
                </picture>
              {%- else -%}
                <span class="pau-cwi-logo-ph">{{ 'image' | placeholder_svg_tag }}</span>
              {%- endif -%}
            </div>

            {%- if has_back -%}
              <div class="flip-face flip-back">
                {%- if card_title != blank -%}
                  <p class="flip-back-title">{{ card_title }}</p>
                {%- endif -%}
                {%- if card_back_text != blank -%}
                  <div class="flip-back-text">{{ card_back_text }}</div>
                {%- endif -%}
                {%- if card_url != blank -%}
                  <a class="flip-back-link" href="{{ card_url }}">{{ block.settings.card_url_label | default: 'Saber más' }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}

          </div>
        </div>

      {%- endfor -%}

    </div>

  </div>

</div>

{% style %}
.pau-cwi-{{ uid }} .pau-cwi-flip-items {
  display: grid;
  grid-template-columns: repeat(var(--pau-cols-m, 2), 1fr);
  gap: 16px;
  align-items: stretch;
}

.pau-cwi-{{ uid }} .pau-cwi-item.flip-card {
  height: 100%;
  width: 100%;
  outline: none;
}

.pau-cwi-{{ uid }} .flip-inner {
  position: relative;
  display: grid;
  height: 100%;
  background: var(--pau-card-bg, #ffffff);
  border-radius: var(--pau-card-radius, 22px);
  box-shadow: 0 6px 20px rgba(60, 90, 40, 0.12);
  padding: 26px 20px;
  box-sizing: border-box;
}
.pau-cwi-{{ uid }} .flip-card:not(.no-flip) .flip-inner { cursor: pointer; }

.pau-cwi-{{ uid }} .flip-face {
  grid-column: 1;
  grid-row: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: opacity var(--pau-fade-speed, 450ms) ease, visibility var(--pau-fade-speed, 450ms) ease;
}

.pau-cwi-{{ uid }} .flip-front { opacity: 1; visibility: visible; }
.pau-cwi-{{ uid }} .flip-back { opacity: 0; visibility: hidden; }

/* Frente: logo en caja uniforme */
.pau-cwi-{{ uid }} .picture-wrapper { width: 100%; display: flex; justify-content: center; }
.pau-cwi-{{ uid }} .flip-front .pau-cwi-item-image {
  width: var(--pau-logo-size-m, 150px);
  height: var(--pau-logo-size-m, 150px);
  max-width: 100%;
  object-fit: contain;
  display: block;
  margin: 0 auto;
}
.pau-cwi-{{ uid }} .pau-cwi-logo-ph { width: 60%; opacity: .35; }

/* Reverso: texto */
.pau-cwi-{{ uid }} .flip-back-title {
  font-weight: 700;
  color: var(--pau-back-title-color, #1f5a2c);
  margin: 0 0 8px;
  font-size: 1.05em;
}
.pau-cwi-{{ uid }} .flip-back-text {
  color: var(--pau-back-text-color, #2d7a3e);
  line-height: 1.5;
  font-size: 14px;
}
.pau-cwi-{{ uid }} .flip-back-text p { margin: 0 0 8px; }
.pau-cwi-{{ uid }} .flip-back-text p:last-child { margin-bottom: 0; }
.pau-cwi-{{ uid }} .flip-back-text strong,
.pau-cwi-{{ uid }} .flip-back-text b { color: var(--pau-back-hl-color, #1f5a2c); font-weight: 700; }
.pau-cwi-{{ uid }} .flip-back-link {
  display: inline-block;
  margin-top: 12px;
  color: var(--pau-back-hl-color, #1f5a2c);
  font-weight: 700;
  text-decoration: underline;
}

/* Hover escritorio → muestra reverso */
@media (hover: hover) {
  .pau-cwi-{{ uid }} .flip-card:not(.no-flip):hover .flip-front,
  .pau-cwi-{{ uid }} .flip-card:not(.no-flip):focus-visible .flip-front { opacity: 0; visibility: hidden; }
  .pau-cwi-{{ uid }} .flip-card:not(.no-flip):hover .flip-back,
  .pau-cwi-{{ uid }} .flip-card:not(.no-flip):focus-visible .flip-back { opacity: 1; visibility: visible; }
}

/* Tap (clase via JS) → muestra reverso */
.pau-cwi-{{ uid }} .flip-card.is-flipped .flip-front { opacity: 0; visibility: hidden; }
.pau-cwi-{{ uid }} .flip-card.is-flipped .flip-back { opacity: 1; visibility: visible; }

/* DESKTOP */
@media (min-width: 768px) {
  .pau-cwi-{{ uid }} .pau-cwi-flip-items {
    grid-template-columns: repeat(var(--pau-cols-d, 2), 1fr);
    gap: 22px;
  }
  .pau-cwi-{{ uid }} .flip-inner { padding: 32px 26px; }
  .pau-cwi-{{ uid }} .flip-front .pau-cwi-item-image {
    width: var(--pau-logo-size-d, 180px);
    height: var(--pau-logo-size-d, 180px);
  }
  .pau-cwi-{{ uid }} .flip-back-text { font-size: 15px; }
}
{% endstyle %}

<script>
(function () {
  var root = document.querySelector('.pau-cwi-{{ uid }}');
  if (!root) return;

  var isTouch = window.matchMedia('(hover: none)').matches;
  var cards = root.querySelectorAll('.flip-card[data-flip]');

  // Tap en touch: voltear
  if (isTouch) {
    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.target.closest('a')) return; // no voltear si tocan un enlace
        card.classList.toggle('is-flipped');
      });
    });
  }

  // Teclado: Enter/Espacio voltea (accesibilidad)
  cards.forEach(function (card) {
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('is-flipped');
      }
    });
  });
})();
</script>

{%- schema -%}
  {
    "name": "Nosotros - T/Íconos",
    "tag": "section",
    "class": "pau-cwi",
    "max_blocks": 12,
    "settings": [
      { "type": "header", "content": "Contenido" },
      { "type": "text", "id": "title_1", "label": "Título 1" },
      { "type": "text", "id": "title", "label": "Título" },
      { "type": "text", "id": "text", "label": "Texto" },
      { "type": "header", "content": "🔄 Flip-cards" },
      {
        "type": "paragraph",
        "content": "Cada tarjeta muestra el logo al frente y, al pasar el mouse (escritorio) o tocar (móvil), el texto del reverso aparece con un fundido. Las tarjetas sin texto de reverso no voltean."
      },
      {
        "type": "range",
        "id": "fade_speed",
        "label": "Velocidad del fundido",
        "min": 150,
        "max": 800,
        "step": 50,
        "unit": "ms",
        "default": 450
      },
      { "type": "header", "content": "📐 Columnas" },
      {
        "type": "range",
        "id": "columns_desktop",
        "label": "Columnas — Escritorio",
        "min": 1,
        "max": 4,
        "step": 1,
        "default": 2
      },
      {
        "type": "select",
        "id": "columns_mobile",
        "label": "Columnas — Móvil",
        "options": [
          { "value": "1", "label": "1 columna" },
          { "value": "2", "label": "2 columnas" }
        ],
        "default": "2"
      },
      { "type": "header", "content": "🎨 Tarjeta" },
      { "type": "color", "id": "card_bg_color", "label": "Fondo de la tarjeta", "default": "#ffffff" },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Redondeo de esquinas",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "logo_size_desktop",
        "label": "Tamaño del logo — Escritorio",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "default": 180
      },
      {
        "type": "range",
        "id": "logo_size_mobile",
        "label": "Tamaño del logo — Móvil",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "default": 150
      },
      { "type": "header", "content": "🎨 Texto del reverso" },
      { "type": "color", "id": "back_title_color", "label": "Color del título del reverso", "default": "#1f5a2c" },
      { "type": "color", "id": "back_text_color", "label": "Color del texto", "default": "#2d7a3e" },
      { "type": "color", "id": "back_highlight_color", "label": "Color del resaltado (negritas)", "default": "#1f5a2c" }
    ],
    "blocks": [
      {
        "name": "Tarjeta",
        "type": "card",
        "settings": [
          { "type": "header", "content": "Frente (logo)" },
          { "type": "image_picker", "id": "card_logo", "label": "Logo" },
          { "type": "header", "content": "Reverso (texto)" },
          { "type": "text", "id": "card_title", "label": "Título del reverso (opcional)" },
          { "type": "richtext", "id": "card_back_text", "label": "Texto del reverso", "info": "Usa negrita para resaltar. Si lo dejas vacío y no hay título, la tarjeta no voltea." },
          { "type": "url", "id": "card_url", "label": "URL (opcional)" },
          { "type": "text", "id": "card_url_label", "label": "Texto del enlace", "default": "Saber más" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Nosotros - T/Iconos",
        "category": "About us"
      }
    ]
  }
{% endschema %}
