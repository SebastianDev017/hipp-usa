{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif

  assign card_blocks = section.blocks | where: 'type', 'expert'
  assign cards_count = card_blocks | size
-%}

<section class="fvl-experts fvl-experts-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="formula-vs-leche-expertos"
         style="
           --fe-section-bg: {{ s.section_bg_color }};
           --fe-content-bg: {{ s.content_bg_color }};
           {% if s.wave_image_top != blank %}--fe-wave-top: url('{{ s.wave_image_top | image_url: width: 2400 }}');{% endif %}
           {% if s.wave_image_bottom != blank %}--fe-wave-bottom: url('{{ s.wave_image_bottom | image_url: width: 2400 }}');{% endif %}
           --fe-wave-h-d: {{ s.wave_height_desktop }}px;
           --fe-wave-h-m: {{ s.wave_height_mobile }}px;
           --fe-title-color: {{ s.title_color }};
           --fe-highlight-color: {{ s.highlight_color }};
           --fe-card-bg: {{ s.card_bg_color }};
           --fe-card-text-color: {{ s.card_text_color }};
           --fe-card-radius: {{ s.card_radius }}px;
           --fe-logo-bg: {{ s.logo_bg_color }};
           --fe-footer-color: {{ s.footer_color }};
           --fe-footer-link-color: {{ s.footer_link_color }};
           --fe-title-font: {{ title_font_var }};
           --fe-body-font: {{ body_font_var }};
           --fe-title-size-d: {{ s.title_size_desktop }}px;
           --fe-title-size-m: {{ s.title_size_mobile }}px;
           --fe-card-size-d: {{ s.card_size_desktop }}px;
           --fe-card-size-m: {{ s.card_size_mobile }}px;
           --fe-logo-size-d: {{ s.logo_size_desktop }}px;
           --fe-logo-size-m: {{ s.logo_size_mobile }}px;
           --fe-pad-top-d: {{ s.padding_top_desktop }}px;
           --fe-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --fe-pad-top-m: {{ s.padding_top_mobile }}px;
           --fe-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --fe-max-width: {{ s.content_max_width }}px;
           --fe-cols-d: {{ s.columns_desktop }};
           --fe-cols-m: {{ s.columns_mobile }};
           --fe-gap: {{ s.cards_gap }}px;
         ">

  {%- comment -%} Onda superior: tira de altura fija; su borde verde conecta con el relleno. {%- endcomment -%}
  {%- if s.wave_image_top != blank -%}
    <div class="fvl-experts-wave fvl-experts-wave-top" aria-hidden="true"></div>
  {%- endif -%}

  {%- comment -%} Relleno verde: SOLO detrás del contenido (no en toda la sección),
     así la onda transparente deja ver el blanco de la página. {%- endcomment -%}
  <div class="fvl-experts-fill">
    <div class="fvl-experts-inner">

      {%- if s.show_title and s.title != blank -%}
        <div class="fvl-experts-title">{{ s.title }}</div>
      {%- endif -%}

      {%- if cards_count > 0 -%}
        <div class="fvl-experts-grid">
          {%- for block in card_blocks -%}
            <div class="fvl-expert-card" {{ block.shopify_attributes }}>

              {%- if s.show_logos -%}
                <div class="fvl-expert-logo">
                  {%- if block.settings.logo != blank -%}
                    <img src="{{ block.settings.logo | image_url: width: 200 }}"
                         alt="{{ block.settings.logo.alt | default: block.settings.logo_alt | escape }}"
                         loading="lazy">
                  {%- else -%}
                    <span class="fvl-expert-logo-placeholder">{{ block.settings.logo_alt | default: 'LOGO' }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="fvl-expert-card-body">
                {%- if block.settings.text != blank -%}
                  <div class="fvl-expert-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.show_footer and s.footer_text != blank -%}
        <div class="fvl-experts-footer">{{ s.footer_text }}</div>
      {%- endif -%}

    </div>
  </div>

  {%- if s.wave_image_bottom != blank -%}
    <div class="fvl-experts-wave fvl-experts-wave-bottom" aria-hidden="true"></div>
  {%- endif -%}

</section>

{% style %}
.fvl-experts-{{ uid }} {
  position: relative;
  background-color: var(--fe-section-bg, transparent);
  text-align: center;
  overflow: hidden;
}

/* Ondas: tira de altura fija. La imagen (verde + transparente) se coloca pegada
   al borde y se ve entera a lo ancho. El borde verde toca el relleno verde. */
.fvl-experts-{{ uid }} .fvl-experts-wave {
  width: 100%;
  height: var(--fe-wave-h-m, 120px);
  /* Onda seamless (tile espejo): tamaño natural + repite en X sin costura. */
  background-repeat: repeat-x;
  background-size: 1000px;
  line-height: 0;
  overflow: hidden;
}
.fvl-experts-{{ uid }} .fvl-experts-wave-top {
  background-image: var(--fe-wave-top);
  background-position: top center;
}
.fvl-experts-{{ uid }} .fvl-experts-wave-bottom {
  background-image: var(--fe-wave-bottom);
  background-position: bottom center;
}

/* Relleno verde detrás del contenido */
.fvl-experts-{{ uid }} .fvl-experts-fill {
  background: var(--fe-content-bg, #e8efe2);
  padding: var(--fe-pad-top-m, 40px) 0 var(--fe-pad-bottom-m, 40px);
}

.fvl-experts-{{ uid }} .fvl-experts-inner {
  max-width: var(--fe-max-width, 760px);
  margin: 0 auto;
  padding: 0 20px;
}

.fvl-experts-{{ uid }} .fvl-experts-title {
  font-family: var(--fe-title-font);
  font-size: var(--fe-title-size-m, 22px);
  line-height: 1.3;
  color: var(--fe-title-color, #1f5a2c);
  font-weight: 700;
  max-width: 620px;
  margin: 0 auto 40px;
}

.fvl-experts-{{ uid }} .fvl-experts-title strong { color: var(--fe-highlight-color, #2d7a3e); }
.fvl-experts-{{ uid }} .fvl-experts-title p { margin: 0; }

.fvl-experts-{{ uid }} .fvl-experts-grid {
  display: grid;
  grid-template-columns: repeat(var(--fe-cols-m, 3), minmax(0, 1fr));
  gap: var(--fe-gap, 12px);
  align-items: start;
}

.fvl-experts-{{ uid }} .fvl-expert-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fvl-experts-{{ uid }} .fvl-expert-logo {
  width: var(--fe-logo-size-m, 70px);
  height: var(--fe-logo-size-m, 70px);
  border-radius: 50%;
  background: var(--fe-logo-bg, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  box-shadow: 0 2px 10px rgba(31, 90, 44, 0.12);
  position: relative;
  z-index: 3;
  margin-bottom: -28px;
  flex-shrink: 0;
}

.fvl-experts-{{ uid }} .fvl-expert-logo img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.fvl-experts-{{ uid }} .fvl-expert-logo-placeholder {
  font-size: 11px;
  font-weight: 700;
  color: var(--fe-card-text-color, #2d7a3e);
  letter-spacing: 1px;
}

.fvl-experts-{{ uid }} .fvl-expert-card-body {
  width: 100%;
  background: var(--fe-card-bg, #c8d9b6);
  border-radius: var(--fe-card-radius, 20px);
  padding: 46px 16px 28px;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fvl-experts-{{ uid }} .fvl-expert-text {
  font-family: var(--fe-body-font);
  font-size: var(--fe-card-size-m, 12px);
  line-height: 1.5;
  color: var(--fe-card-text-color, #2d7a3e);
}

.fvl-experts-{{ uid }} .fvl-expert-text p { margin: 0; }
.fvl-experts-{{ uid }} .fvl-expert-text strong { font-weight: 700; }

.fvl-experts-{{ uid }} .fvl-experts-footer {
  font-family: var(--fe-body-font);
  font-size: 13px;
  line-height: 1.5;
  color: var(--fe-footer-color, #2d7a3e);
  margin-top: 36px;
}

.fvl-experts-{{ uid }} .fvl-experts-footer a {
  color: var(--fe-footer-link-color, #1f5a2c);
  text-decoration: underline;
  font-weight: 700;
}

.fvl-experts-{{ uid }} .fvl-experts-footer p { margin: 0; }

@media (min-width: 768px) {
  .fvl-experts-{{ uid }} .fvl-experts-wave { height: var(--fe-wave-h-d, 160px); }

  .fvl-experts-{{ uid }} .fvl-experts-fill {
    padding: var(--fe-pad-top-d, 60px) 0 var(--fe-pad-bottom-d, 60px);
  }
  .fvl-experts-{{ uid }} .fvl-experts-inner { padding: 0 40px; }

  .fvl-experts-{{ uid }} .fvl-experts-title {
    font-size: var(--fe-title-size-d, 32px);
    margin-bottom: 56px;
  }

  .fvl-experts-{{ uid }} .fvl-experts-grid {
    grid-template-columns: repeat(var(--fe-cols-d, 3), minmax(0, 1fr));
  }

  .fvl-experts-{{ uid }} .fvl-expert-logo {
    width: var(--fe-logo-size-d, 90px);
    height: var(--fe-logo-size-d, 90px);
    margin-bottom: -34px;
  }

  .fvl-experts-{{ uid }} .fvl-expert-card-body {
    padding: 54px 22px 34px;
    min-height: 240px;
  }

  .fvl-experts-{{ uid }} .fvl-expert-text {
    font-size: var(--fe-card-size-d, 14px);
  }

  .fvl-experts-{{ uid }} .fvl-experts-footer {
    font-size: 14px;
    margin-top: 48px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "FvL · Expertos",
  "tag": "section",
  "class": "fvl-experts-section",
  "settings": [
    { "type": "header", "content": "📝 Título y textos" },
    { "type": "richtext", "id": "title", "label": "Título de la sección", "default": "<p>Si aún tienes duda si seguir con la fórmula de continuación HiPP o cambiarte a leche de vaca, te compartimos la opinión de los expertos</p>" },
    { "type": "richtext", "id": "footer_text", "label": "Texto de cierre", "info": "Para el enlace, selecciona la palabra y usa el botón de enlace del editor.", "default": "<p>Recuerda siempre consultarlo con tu pediatra, <a href=\"#\">descarga nuestras etiquetas aquí</a></p>" },

    { "type": "header", "content": "👁 Visibilidad de elementos" },
    { "type": "checkbox", "id": "show_title", "label": "Mostrar título", "default": true },
    { "type": "checkbox", "id": "show_logos", "label": "Mostrar logos", "default": true },
    { "type": "checkbox", "id": "show_footer", "label": "Mostrar texto de cierre", "default": true },

    { "type": "header", "content": "🌊 Ondas + fondo" },
    { "type": "paragraph", "content": "El verde va SOLO detrás del contenido (relleno), no en toda la sección. Así la onda (verde + transparente) deja ver el blanco de la página arriba/abajo. El verde del relleno debe ser el MISMO verde de tus PNG (#e8efe2) para que el borde de la onda conecte sin línea." },
    { "type": "image_picker", "id": "wave_image_top", "label": "Onda superior (PNG transparente)", "info": "Déjalo vacío si no quieres onda arriba." },
    { "type": "image_picker", "id": "wave_image_bottom", "label": "Onda inferior (PNG transparente)", "info": "Déjalo vacío si no quieres onda abajo." },
    { "type": "range", "id": "wave_height_desktop", "label": "Alto de la onda — Escritorio", "min": 60, "max": 360, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "wave_height_mobile", "label": "Alto de la onda — Móvil", "min": 40, "max": 260, "step": 10, "unit": "px", "default": 120 },
    { "type": "color", "id": "content_bg_color", "label": "Verde detrás del contenido", "default": "#e8efe2" },
    { "type": "color", "id": "section_bg_color", "label": "Color de toda la sección (opcional)", "info": "Déjalo vacío = transparente (recomendado). Si le pones color, tapará el blanco que deja ver la onda." },

    { "type": "header", "content": "🎨 Colores" },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1f5a2c" },
    { "type": "color", "id": "highlight_color", "label": "Color de texto resaltado en título", "default": "#2d7a3e" },
    { "type": "color", "id": "card_bg_color", "label": "Fondo de las tarjetas", "default": "#c8d9b6" },
    { "type": "color", "id": "card_text_color", "label": "Color del texto de las tarjetas", "default": "#2d7a3e" },
    { "type": "color", "id": "logo_bg_color", "label": "Fondo del círculo del logo", "default": "#ffffff" },
    { "type": "color", "id": "footer_color", "label": "Color del texto de cierre", "default": "#2d7a3e" },
    { "type": "color", "id": "footer_link_color", "label": "Color del enlace de cierre", "default": "#1f5a2c" },

    { "type": "header", "content": "🔤 Tipografía" },
    {
      "type": "select", "id": "title_font", "label": "Fuente del título",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select", "id": "body_font", "label": "Fuente de textos",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "title_size_desktop", "label": "Tamaño del título — Escritorio", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño del título — Móvil", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "card_size_desktop", "label": "Tamaño del texto de tarjetas — Escritorio", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_size_mobile", "label": "Tamaño del texto de tarjetas — Móvil", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "⭕ Logos" },
    { "type": "range", "id": "logo_size_desktop", "label": "Tamaño del círculo — Escritorio", "min": 50, "max": 140, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "logo_size_mobile", "label": "Tamaño del círculo — Móvil", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 70 },

    { "type": "header", "content": "📐 Diseño y espaciado" },
    { "type": "range", "id": "card_radius", "label": "Redondeo de las tarjetas", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "columns_desktop", "label": "Columnas — Escritorio", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columnas — Móvil", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "range", "id": "cards_gap", "label": "Espacio entre tarjetas", "min": 6, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "content_max_width", "label": "Ancho máximo del contenido", "min": 400, "max": 1100, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaciado superior del contenido — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaciado inferior del contenido — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaciado superior del contenido — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaciado inferior del contenido — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "name": "Experto",
      "type": "expert",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo de la organización" },
        { "type": "text", "id": "logo_alt", "label": "Nombre / texto alternativo del logo", "default": "Organización" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Texto del experto u organización.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "FvL · Expertos",
      "category": "Formula vs Leche de Vaca",
      "blocks": [
        { "type": "expert", "settings": { "logo_alt": "INP", "text": "<p>Se recomienda el consumo de fórmulas de continuación desde los 6 meses hasta los 72 meses de vida.</p>" } },
        { "type": "expert", "settings": { "logo_alt": "AAP", "text": "<p>Las \"fórmulas\" para bebés mayores y niños pequeños se pueden utilizar de forma segura como parte de una dieta variada.</p>" } },
        { "type": "expert", "settings": { "logo_alt": "ESPGHAN", "text": "<p>Las fórmulas infantiles pueden usarse como parte de las estrategias para aumentar la ingesta de hierro, vitamina D y ácidos grasos poliinsaturados Omega 3.</p>" } }
      ]
    }
  ]
}
{% endschema %}
