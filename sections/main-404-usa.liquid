{%- comment -%}
  HiPP USA — página 404.

  Reemplaza a sections/main-404.liquid, que era el bloque .page/.page-content
  del tema mexicano con el boton generico de "seguir comprando".

  Importa mas de lo que parece: aca cae CUALQUIER URL equivocada y tambien las
  paginas de politicas que todavia no se escribieron en el admin. Por eso lleva
  atajos y no solo una disculpa.
{%- endcomment -%}

<div class="hp-404">
  <div class="hp-wrap hp-wrap--narrow">
    {%- if section.settings.kicker != blank -%}
      <p class="hp-kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    <h1 class="hp-h1 hp-404__title">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        {{ 'templates.404.title' | t }}
      {%- endif -%}
    </h1>

    <p class="hp-lead hp-404__text">
      {%- if section.settings.text != blank -%}
        {{ section.settings.text }}
      {%- else -%}
        {{ 'templates.404.subtext' | t }}
      {%- endif -%}
    </p>

    <div class="hp-404__cta">
      <a class="hp-btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
        {{ section.settings.primary_label }}
      </a>
      <a class="hp-btn hp-btn--ghost" href="{{ routes.root_url }}">
        {{ section.settings.secondary_label }}
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="hp-404__links" aria-label="{{ section.settings.links_title | escape }}">
        <p class="hp-404__links-title">{{ section.settings.links_title }}</p>
        <ul role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_hill -%}
  {%- render 'hipp-hill', fill: '#FFD9BE', above: '#FFFFFF' -%}
{%- endif -%}

{% schema %}
{
  "name": "404",
  "tag": "section",
  "class": "hp-404-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Lost a page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty falls back to the theme translation.",
      "default": "This one is not on the shelf."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you were looking for moved or never existed. The formulas did not go anywhere."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop the formulas"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Back home"
    },
    {
      "type": "checkbox",
      "id": "show_hill",
      "label": "Hill divider",
      "default": true
    },
    {
      "type": "text",
      "id": "links_title",
      "label": "Shortcut list title",
      "default": "Or jump straight to"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Shortcut",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Subscription"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
