{{- 'css-cover.css' | asset_url | stylesheet_tag -}}
<script src="{{- 'js-cover.js' | asset_url -}}" defer></script>

{%- liquid 
  assign float_asset = section.settings.float_asset
  assign block = section.blocks[0]
  assign block_type = block.type
  assign title = block.settings.title
  assign subtitle = block.settings.subtitle
  assign button_label = block.settings.button_label
  assign button_link = block.settings.button_link
  assign bottom_paragraph = section.settings.bottom_paragraph
  assign button_exists = false

  if button_label != blank and button_link != blank
    assign button_exists = true
  endif

  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height

  assign desktop_align_x = section.settings.desktop_align_x
  assign desktop_align_y = section.settings.desktop_align_y
  assign desktop_text_align = section.settings.desktop_text_align

  assign mobile_align_x = section.settings.mobile_align_x
  assign mobile_align_y = section.settings.mobile_align_y
  assign mobile_text_align = section.settings.mobile_text_align
-%}

{%- capture open_tag -%}
  {%- if button_label == blank and button_link != blank -%}
    <a class="cover-content" href="{{ button_link }}">
  {%- else -%}
    <div class="cover-content">  
  {%- endif -%}
{%- endcapture -%}

{%- capture close_tag -%}
  {%- if button_label == blank and button_link != blank -%}
    </a>
  {%- else -%}
    </div>  
  {%- endif -%}
{%- endcapture -%}

<div class="cover-wrapper">
  <div class="cover block-type-{{- block_type -}}" 
       data-section-id="{{- section.id -}}" 
       data-section-type="cover"
       style="
         --cover-height-desktop: {{ desktop_height }}vh;
         --cover-height-mobile: {{ mobile_height }}px;
         --cover-align-x-desktop: {{ desktop_align_x }};
         --cover-align-y-desktop: {{ desktop_align_y }};
         --cover-text-align-desktop: {{ desktop_text_align }};
         --cover-align-x-mobile: {{ mobile_align_x }};
         --cover-align-y-mobile: {{ mobile_align_y }};
         --cover-text-align-mobile: {{ mobile_text_align }};
       ">
    {{- open_tag -}}

      {%- unless float_asset == blank -%}
        <div class="cover-asset no-touch">
          <div class="cover-asset-image-wrapper">
            <img class="cover-asset-image" src="{{ float_asset | image_url }}" alt="{{ float_asset.alt | escape }}" fetchpriority="high" data-aos="fade-up" data-aos-delay="300">
          </div>
        </div>
      {%- endunless -%}
      
      {%- case block_type -%}
        {%- when 'image' -%}
          <div class="cover-background cover-background--image">
            <div class="cover-overlay"></div>
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url }}">
              {%- endif -%}
              {%- if block.settings.desktop_image != blank -%}
                <img src="{{ block.settings.desktop_image | image_url }}" alt="Portada imagen" loading="lazy" style="width:100%;">
              {%- endif -%}
            </picture>
          </div>

        {%- when 'video' -%}
          <div class="cover-background cover-background--image" data-aos="fade-up" data-aos-delay="300">
            <div class="cover-overlay"></div>
            {%- if block.settings.video_desktop != blank -%}
              {%- assign video = block.settings.video_desktop -%}
              {%- comment -%}
                preload="none" con autoplay se contradice: varios navegadores no arrancan
                la reproduccion si no hay nada precargado. metadata es el punto medio.
              {%- endcomment -%}
              <video
                autoplay
                loop
                muted
                playsinline
                class="cover-video"
                preload="metadata"
                poster="{{ block.settings.poster_image | image_url: width: 1500 }}"
              >
                {%- for source in video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- elsif block.settings.poster_image != blank -%}
              {%- comment -%}
                Sin video, se cae a la imagen poster. Antes esta rama imprimia
                <p style="color:red">No se ha proporcionado un video.</p> DIRECTO AL
                CLIENTE en el storefront.
              {%- endcomment -%}
              <img
                class="cover-video"
                src="{{ block.settings.poster_image | image_url: width: 1500 }}"
                srcset="{{ block.settings.poster_image | image_url: width: 750 }} 750w, {{ block.settings.poster_image | image_url: width: 1500 }} 1500w"
                sizes="100vw"
                alt="{{ block.settings.poster_image.alt | escape }}"
                width="{{ block.settings.poster_image.width }}"
                height="{{ block.settings.poster_image.height }}"
                fetchpriority="high"
              >
            {%- endif -%}
          </div>
      {%- endcase -%}

      <article class="cover-info" data-aos="fade-up">
        <div class="cover-info-inner color-white">
          {%- unless subtitle == blank -%}
            <p class="cover-subtitle primary-font-bold">{{ subtitle }}</p>
          {%- endunless -%}

          {%- unless title == blank -%}
            <header class="cover-title-container">
              <h2 class="cover-title section-title-richtext">{{ title }}</h2>
            </header>
          {%- endunless -%}
          
          {%- unless block.settings.text_paragraph == blank -%}
            <p class="tii-text" style="margin-top:15px;line-height:20px;">{{ block.settings.text_paragraph }}</p>
          {%- endunless -%}

          {%- if button_exists -%}
            <div class="cover-button-container">
              {%- capture target -%}
                {%- if button_link contains 'http' or button_link contains 'tel:' or button_link contains 'maps/' or button_link contains 'mailto:' -%}
                  target="_blank"
                {%- endif -%}
              {%- endcapture -%}
              <a class="cover-button button primary-button" href="{{ button_link }}" {{ target }}>{{ button_label }}</a>
            </div>
          {%- endif -%}
        </div>
      </article>

      <p class="cover-bottom-paragraph">{{ section.settings.bottom_paragraph }}</p>

    {{- close_tag -}}
  </div>
</div>

{% schema %}
{
  "name": "Portada",
  "tag": "section",
  "class": "cover-section",
  "settings": [
    {
      "type": "header",
      "content": "Altura de la sección"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Altura en escritorio (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Altura en móvil (px)",
      "min": 100,
      "max": 1000,
      "step": 10,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Posición del texto — Escritorio"
    },
    {
      "type": "select",
      "id": "desktop_align_x",
      "label": "Posición horizontal (escritorio)",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "desktop_align_y",
      "label": "Posición vertical (escritorio)",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_text_align",
      "label": "Alineación del texto (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Posición del texto — Móvil"
    },
    {
      "type": "select",
      "id": "mobile_align_x",
      "label": "Posición horizontal (móvil)",
      "options": [
        { "value": "flex-start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_align_y",
      "label": "Posición vertical (móvil)",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Alineación del texto (móvil)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Imagen flotante"
    },
    {
      "type": "image_picker",
      "id": "float_asset",
      "label": "Imagen flotante"
    },
    {
      "type": "text",
      "id": "bottom_paragraph",
      "label": "Texto inferior del banner"
    }
  ],
  "max_blocks": 1,
  "blocks": [
    {
      "name": "Imagen",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Imagen para escritorio"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Imagen para móvil"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text_paragraph",
          "label": "Párrafo descriptivo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        }
      ]
    },
    {
      "name": "Video",
      "type": "video",
      "settings": [
        {
          "type": "video",
          "id": "video_desktop",
          
          "label": "Video para escritorio"
        },
        {
  "type": "image_picker",
  "id": "poster_image",
  "label": "Imagen poster (mientras carga el video)"
},
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text_paragraph",
          "label": "Párrafo descriptivo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portada",
      "category": "Homepage"
    }
  ]
}
{% endschema %}

{% style %}
.cover-wrapper {
  position: relative;
  z-index: 10;
}

.cover-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}

.cover-background--image {
  position: relative;
  width: 100%;
  height: var(--cover-height-desktop, 100vh);
  overflow: hidden;
}

.cover {
  position: relative;
}

.cover-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 1;
}

.cover-info {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: var(--cover-align-y-desktop, center);
  justify-content: var(--cover-align-x-desktop, flex-start);
  padding: 40px var(--info-padding, 60px);
  overflow: hidden;
  z-index: 2;
  box-sizing: border-box;
}

.cover-info-inner {
  max-width: 600px;
  text-align: var(--cover-text-align-desktop, left);
}

.cover-bottom-paragraph {
  text-align: center;
  bottom: 40px;
  z-index: 2;
  color: white;
  position: relative;
}

@media (max-width: 680px) {
  .cover-background--image {
    height: var(--cover-height-mobile, 600px);
  }

  .cover-info {
    align-items: var(--cover-align-y-mobile, center);
    justify-content: var(--cover-align-x-mobile, center);
    padding: 40px var(--header-mobile-padding, 20px);
  }

  .cover-info-inner {
    text-align: var(--cover-text-align-mobile, center);
  }
}
{% endstyle %}
