{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif

  assign has_bg_image = false
  if s.background_image != blank
    assign has_bg_image = true
  endif

  assign item_blocks = section.blocks | where: 'type', 'item'
  assign items_count = item_blocks | size
-%}

<section class="fvl-benefits fvl-benefits-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="formula-vs-leche-beneficios"
         style="
           {% if s.use_bg_color %}--fb-bg: {{ s.background_color }};{% else %}--fb-bg: transparent;{% endif %}
           {% if has_bg_image %}--fb-bg-image: url('{{ s.background_image | image_url: width: 2000 }}');{% endif %}
           --fb-half-top-color: {{ s.half_top_color }};
           --fb-half-bottom-color: {{ s.half_bottom_color }};
           --fb-title-color: {{ s.title_color }};
           --fb-highlight-color: {{ s.highlight_color }};
           --fb-icon-color: {{ s.icon_color }};
           --fb-item-text-color: {{ s.item_text_color }};
           --fb-divider-color: {{ s.divider_color }};
           --fb-title-font: {{ title_font_var }};
           --fb-body-font: {{ body_font_var }};
           --fb-title-size-d: {{ s.title_size_desktop }}px;
           --fb-title-size-m: {{ s.title_size_mobile }}px;
           --fb-item-size-d: {{ s.item_size_desktop }}px;
           --fb-item-size-m: {{ s.item_size_mobile }}px;
           --fb-icon-size-d: {{ s.icon_size_desktop }}px;
           --fb-icon-size-m: {{ s.icon_size_mobile }}px;
           --fb-cols-d: {{ s.columns_desktop }};
           --fb-cols-t: {{ s.columns_tablet }};
           --fb-cols-m: {{ s.columns_mobile }};
           --fb-gap: {{ s.items_gap }}px;
           --fb-pad-top-d: {{ s.padding_top_desktop }}px;
           --fb-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --fb-pad-top-m: {{ s.padding_top_mobile }}px;
           --fb-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --fb-max-width: {{ s.content_max_width }}px;
         ">

  {%- if s.show_half_top -%}
    <div class="fvl-benefits-half fvl-benefits-half-top" aria-hidden="true"></div>
  {%- endif -%}
  {%- if s.show_half_bottom -%}
    <div class="fvl-benefits-half fvl-benefits-half-bottom" aria-hidden="true"></div>
  {%- endif -%}

  {%- if s.wave_image_top != blank -%}
    <div class="fvl-benefits-wave fvl-benefits-wave-top" aria-hidden="true">
      <img src="{{ s.wave_image_top | image_url: width: 2400 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

  <div class="fvl-benefits-inner">

    {%- if s.show_title and s.title != blank -%}
      <div class="fvl-benefits-title">{{ s.title }}</div>
    {%- endif -%}

    {%- if items_count > 0 -%}
      <div class="fvl-benefits-grid{% if s.show_dividers %} has-dividers{% endif %}">
        {%- for block in item_blocks -%}
          <div class="fvl-benefit-item" {{ block.shopify_attributes }}>

            {%- if s.show_icons -%}
              <div class="fvl-benefit-icon">
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 220 }}" alt="{{ block.settings.icon.alt | escape }}" loading="lazy">
                {%- else -%}
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="32" cy="32" r="20"/><path d="M24 32l6 6 12-12"/></svg>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="fvl-benefit-text">{{ block.settings.text }}</div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  {%- if s.wave_image_bottom != blank -%}
    <div class="fvl-benefits-wave fvl-benefits-wave-bottom" aria-hidden="true">
      <img src="{{ s.wave_image_bottom | image_url: width: 2400 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

</section>

{% style %}
.fvl-benefits-{{ uid }} {
  position: relative;
  background-color: var(--fb-bg, transparent);
  {% if has_bg_image %}
  background-image: var(--fb-bg-image);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {% endif %}
  padding: var(--fb-pad-top-m, 48px) 20px var(--fb-pad-bottom-m, 48px);
  text-align: center;
  overflow: hidden;
}

.fvl-benefits-{{ uid }} .fvl-benefits-half {
  position: absolute; left: 0; width: 100%; height: 50%; z-index: 0; pointer-events: none;
}
.fvl-benefits-{{ uid }} .fvl-benefits-half-top { top: 0; background: var(--fb-half-top-color, #c8d9b6); }
.fvl-benefits-{{ uid }} .fvl-benefits-half-bottom { bottom: 0; background: var(--fb-half-bottom-color, #c8d9b6); }

.fvl-benefits-{{ uid }} .fvl-benefits-wave {
  position: absolute; left: 0; width: 100%; line-height: 0; pointer-events: none; z-index: 1;
}
.fvl-benefits-{{ uid }} .fvl-benefits-wave img { width: 100%; height: auto; display: block; }
.fvl-benefits-{{ uid }} .fvl-benefits-wave-top { top: 0; }
.fvl-benefits-{{ uid }} .fvl-benefits-wave-bottom { bottom: 0; }

.fvl-benefits-{{ uid }} .fvl-benefits-inner {
  position: relative; z-index: 2;
  max-width: var(--fb-max-width, 1080px);
  margin: 0 auto;
}

.fvl-benefits-{{ uid }} .fvl-benefits-title {
  font-family: var(--fb-title-font);
  font-size: var(--fb-title-size-m, 20px);
  line-height: 1.3;
  color: var(--fb-title-color, #1f5a2c);
  font-weight: 700;
  max-width: 620px;
  margin: 0 auto 36px;
}
.fvl-benefits-{{ uid }} .fvl-benefits-title strong { color: var(--fb-highlight-color, #2d7a3e); }
.fvl-benefits-{{ uid }} .fvl-benefits-title p { margin: 0; }

/* GRID responsivo: móvil 1xN por defecto */
.fvl-benefits-{{ uid }} .fvl-benefits-grid {
  display: grid;
  grid-template-columns: repeat(var(--fb-cols-m, 1), minmax(0, 1fr));
  gap: var(--fb-gap, 28px);
}

.fvl-benefits-{{ uid }} .fvl-benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
}

.fvl-benefits-{{ uid }} .fvl-benefit-icon {
  height: var(--fb-icon-size-m, 64px);
  margin-bottom: 14px;
  color: var(--fb-icon-color, #2d7a3e);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fvl-benefits-{{ uid }} .fvl-benefit-icon img,
.fvl-benefits-{{ uid }} .fvl-benefit-icon svg {
  height: 100%;
  width: auto;
  max-width: 100%;
  object-fit: contain;
}

.fvl-benefits-{{ uid }} .fvl-benefit-text {
  font-family: var(--fb-body-font);
  font-size: var(--fb-item-size-m, 13px);
  line-height: 1.5;
  color: var(--fb-item-text-color, #2d7a3e);
  max-width: 320px;
}
.fvl-benefits-{{ uid }} .fvl-benefit-text p { margin: 0; }
.fvl-benefits-{{ uid }} .fvl-benefit-text strong { font-weight: 700; }

/* TABLET */
@media (min-width: 768px) {
  .fvl-benefits-{{ uid }} {
    padding: var(--fb-pad-top-d, 72px) 40px var(--fb-pad-bottom-d, 72px);
  }
  .fvl-benefits-{{ uid }} .fvl-benefits-title {
    font-size: var(--fb-title-size-d, 30px);
    margin-bottom: 48px;
  }
  .fvl-benefits-{{ uid }} .fvl-benefits-grid {
    grid-template-columns: repeat(var(--fb-cols-t, 2), minmax(0, 1fr));
    gap: calc(var(--fb-gap, 28px) * 1.2);
  }
  .fvl-benefits-{{ uid }} .fvl-benefit-icon { height: var(--fb-icon-size-d, 80px); }
  .fvl-benefits-{{ uid }} .fvl-benefit-text { font-size: var(--fb-item-size-d, 14px); }
}

/* DESKTOP */
@media (min-width: 1024px) {
  .fvl-benefits-{{ uid }} .fvl-benefits-grid {
    grid-template-columns: repeat(var(--fb-cols-d, 4), minmax(0, 1fr));
  }

  /* Divisores verticales entre columnas (solo desktop) */
  .fvl-benefits-{{ uid }} .fvl-benefits-grid.has-dividers .fvl-benefit-item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 6%;
    right: calc(var(--fb-gap, 28px) * -0.5);
    height: 88%;
    width: 1px;
    background: var(--fb-divider-color, rgba(45,122,62,0.25));
  }
}
{% endstyle %}

{% schema %}
{
  "name": "FvL · Beneficios",
  "tag": "section",
  "class": "fvl-benefits-section",
  "settings": [
    {
      "type": "header",
      "content": "📝 Título"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título de la sección",
      "info": "Usa negrita para resaltar con el color de acento.",
      "default": "<p>La fórmula de continuación HiPP contiene <strong>micronutrimentos clave</strong> para el correcto crecimiento y desarrollo de los niños</p>"
    },
    {
      "type": "header",
      "content": "👁 Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Mostrar título",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Mostrar íconos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Mostrar divisores entre columnas (solo escritorio)",
      "default": false
    },
    {
      "type": "header",
      "content": "🖼 Fondo"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "checkbox",
      "id": "use_bg_color",
      "label": "Usar color de fondo sólido",
      "info": "Apagado = fondo transparente.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#e8efe2"
    },
    {
      "type": "header",
      "content": "🟩 Fondo por mitades"
    },
    {
      "type": "checkbox",
      "id": "show_half_top",
      "label": "Fondo en la mitad superior",
      "default": false
    },
    {
      "type": "color",
      "id": "half_top_color",
      "label": "Color mitad superior",
      "default": "#c8d9b6"
    },
    {
      "type": "checkbox",
      "id": "show_half_bottom",
      "label": "Fondo en la mitad inferior",
      "default": false
    },
    {
      "type": "color",
      "id": "half_bottom_color",
      "label": "Color mitad inferior",
      "default": "#c8d9b6"
    },
    {
      "type": "header",
      "content": "🌊 Ondas de leche"
    },
    {
      "type": "image_picker",
      "id": "wave_image_top",
      "label": "Onda superior (SVG/PNG)"
    },
    {
      "type": "image_picker",
      "id": "wave_image_bottom",
      "label": "Onda inferior (SVG/PNG)"
    },
    {
      "type": "header",
      "content": "🎨 Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#1f5a2c"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Color de texto resaltado",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color de íconos (por defecto)",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Color del texto de los ítems",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color de los divisores",
      "default": "#b9d1a3"
    },
    {
      "type": "header",
      "content": "🔤 Tipografía"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Fuente del título",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Fuente de textos",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamaño del título — Escritorio",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño del título — Móvil",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_size_desktop",
      "label": "Tamaño texto de ítems — Escritorio",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_size_mobile",
      "label": "Tamaño texto de ítems — Móvil",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "⭕ Íconos"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Alto de íconos — Escritorio",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Alto de íconos — Móvil",
      "min": 32,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "📐 Grid y espaciado"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas — Escritorio",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columnas — Tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columnas — Móvil",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "items_gap",
      "label": "Espacio entre ítems",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 400,
      "max": 1300,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Espaciado superior — Escritorio",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Espaciado inferior — Escritorio",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espaciado superior — Móvil",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaciado inferior — Móvil",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "name": "Ítem",
      "type": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Ícono / ilustración"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Texto del beneficio.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "FvL · Beneficios",
      "category": "Formula vs Leche de Vaca",
      "blocks": [
        { "type": "item", "settings": { "text": "<p>La fórmula de continuación HiPP está fortificada con <strong>hierro</strong>, ayudando a cubrir requerimientos clave para el desarrollo cognitivo.</p>" } },
        { "type": "item", "settings": { "text": "<p>También está diseñada para aportar <strong>vitamina D</strong> (clave para huesos), zinc, ácido fólico y cantidades adecuadas de calcio.</p>" } },
        { "type": "item", "settings": { "text": "<p>Mayor aminoácidos circulando por su cuerpo que podrían activar la insulina, lo cual puede llevarlos a ganar peso rápidamente y acumular grasa en el cuerpo.</p>" } },
        { "type": "item", "settings": { "text": "<p>La leche de vaca es baja en hierro y puede favorecer la anemia.</p>" } }
      ]
    }
  ]
}
{% endschema %}
