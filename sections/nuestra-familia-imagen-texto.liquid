{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif
-%}

<section class="nf-block nf-block-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="nuestra-familia-imagen-texto"
         style="
           {% if s.use_bg_color %}--nf-bg: {{ s.background_color }};{% else %}--nf-bg: transparent;{% endif %}
           --nf-circle-color: {{ s.circle_color }};
           --nf-media-size-d: {{ s.media_size_desktop }}px;
           --nf-media-size-m: {{ s.media_size_mobile }}px;
           --nf-title-color: {{ s.title_color }};
           --nf-highlight-color: {{ s.highlight_color }};
           --nf-text-color: {{ s.text_color }};
           --nf-title-font: {{ title_font_var }};
           --nf-body-font: {{ body_font_var }};
           --nf-title-size-d: {{ s.title_size_desktop }}px;
           --nf-title-size-m: {{ s.title_size_mobile }}px;
           --nf-text-size-d: {{ s.text_size_desktop }}px;
           --nf-text-size-m: {{ s.text_size_mobile }}px;
           --nf-pad-top-d: {{ s.padding_top_desktop }}px;
           --nf-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --nf-pad-top-m: {{ s.padding_top_mobile }}px;
           --nf-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --nf-max-width: {{ s.content_max_width }}px;
         ">

  <div class="nf-block-inner">

    {%- comment -%} ===== IMAGEN CIRCULAR ===== {%- endcomment -%}
    {%- if s.show_image -%}
      <div class="nf-block-media-wrap">
        <div class="nf-block-media">
          {%- if s.image != blank -%}
            <img class="nf-block-image"
                 src="{{ s.image | image_url: width: 1000 }}"
                 alt="{{ s.image.alt | escape }}"
                 loading="lazy">
          {%- else -%}
            <div class="nf-block-media-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== TEXTO ===== {%- endcomment -%}
    {%- if s.title != blank -%}
      <h2 class="nf-block-title">{{ s.title }}</h2>
    {%- endif -%}

    {%- if s.text != blank -%}
      <div class="nf-block-text">{{ s.text }}</div>
    {%- endif -%}

  </div>

</section>

{% style %}
.nf-block-{{ uid }} {
  position: relative;
  background-color: var(--nf-bg, transparent);
  padding: var(--nf-pad-top-m, 40px) 20px var(--nf-pad-bottom-m, 48px);
  overflow: hidden;
}

.nf-block-{{ uid }} .nf-block-inner {
  position: relative; z-index: 2;
  max-width: var(--nf-max-width, 640px);
  margin: 0 auto;
  text-align: center;
}

/* ===== Imagen circular ===== */
.nf-block-{{ uid }} .nf-block-media-wrap {
  position: relative;
  width: var(--nf-media-size-m, 280px);
  margin: 0 auto 28px;
}

.nf-block-{{ uid }} .nf-block-circle {
  position: absolute;
  top: -12%;
  left: -16%;
  width: 132%;
  height: 132%;
  border-radius: 50%;
  background: var(--nf-circle-color, #cfe0bf);
  z-index: 0;
}

.nf-block-{{ uid }} .nf-block-media {
  position: relative;
  z-index: 1;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  overflow: hidden;
}

.nf-block-{{ uid }} .nf-block-image,
.nf-block-{{ uid }} .nf-block-media-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.nf-block-{{ uid }} .nf-block-media-placeholder { opacity: .4; display: flex; align-items: center; justify-content: center; }

/* ===== Texto ===== */
.nf-block-{{ uid }} .nf-block-title {
  font-family: var(--nf-title-font);
  font-size: var(--nf-title-size-m, 30px);
  line-height: 1.15;
  font-weight: 400;
  color: var(--nf-title-color, #2d7a3e);
  margin: 0 0 18px;
}
.nf-block-{{ uid }} .nf-block-title strong,
.nf-block-{{ uid }} .nf-block-title b {
  font-weight: 700;
  color: var(--nf-highlight-color, #1f5a2c);
}
.nf-block-{{ uid }} .nf-block-title p { margin: 0; }

.nf-block-{{ uid }} .nf-block-text {
  font-family: var(--nf-body-font);
  font-size: var(--nf-text-size-m, 15px);
  line-height: 1.6;
  color: var(--nf-text-color, #2d7a3e);
}
.nf-block-{{ uid }} .nf-block-text p { margin: 0 0 16px; }
.nf-block-{{ uid }} .nf-block-text p:last-child { margin-bottom: 0; }

@media (min-width: 768px) {
  .nf-block-{{ uid }} {
    padding: var(--nf-pad-top-d, 64px) 40px var(--nf-pad-bottom-d, 72px);
  }
  .nf-block-{{ uid }} .nf-block-media-wrap {
    width: var(--nf-media-size-d, 340px);
    margin-bottom: 36px;
  }
  .nf-block-{{ uid }} .nf-block-title { font-size: var(--nf-title-size-d, 40px); }
  .nf-block-{{ uid }} .nf-block-text { font-size: var(--nf-text-size-d, 17px); }
}
{% endstyle %}

{% schema %}
{
  "name": "NF · Imagen + Texto",
  "tag": "section",
  "class": "nf-block-section",
  "settings": [
    {
      "type": "header",
      "content": "🖼 Imagen circular"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar imagen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "checkbox",
      "id": "show_circle",
      "label": "Mostrar círculo decorativo detrás",
      "default": true
    },
    {
      "type": "header",
      "content": "📝 Textos"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "info": "Usa negrita para resaltar (ej. 'nutrición orgánica').",
      "default": "<p>Pioneros en <strong>nutrición orgánica</strong> desde 1899</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Párrafos",
      "default": "<p>Para nosotros la alimentación orgánica no es una tendencia, es la esencia de nuestra familia.</p><p>Creamos productos de calidad superior con la mejor y más natural materia prima, sin pesticidas, sin saborizantes ni hormonas, libre de azúcares añadidos y químicos nocivos que pueden afectar el desarrollo y la salud de tu bebé.</p>"
    },
    {
      "type": "header",
      "content": "🖼 Fondo"
    },
    {
      "type": "checkbox",
      "id": "use_bg_color",
      "label": "Usar color de fondo sólido",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#e8efe2"
    },
    {
      "type": "header",
      "content": "🎨 Colores"
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Color del círculo decorativo",
      "default": "#cfe0bf"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Color de texto resaltado",
      "default": "#1f5a2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del párrafo",
      "default": "#2d7a3e"
    },
    {
      "type": "header",
      "content": "🔤 Tipografía"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Fuente del título",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Fuente del párrafo",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamaño título — Escritorio",
      "min": 24,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño título — Móvil",
      "min": 18,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Tamaño párrafo — Escritorio",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Tamaño párrafo — Móvil",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "📐 Tamaños y espaciado"
    },
    {
      "type": "range",
      "id": "media_size_desktop",
      "label": "Tamaño de la imagen — Escritorio",
      "min": 200,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    {
      "type": "range",
      "id": "media_size_mobile",
      "label": "Tamaño de la imagen — Móvil",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Espaciado superior — Escritorio",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Espaciado inferior — Escritorio",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espaciado superior — Móvil",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaciado inferior — Móvil",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "NF · Imagen + Texto",
      "category": "Nuestra Familia"
    }
  ]
}
{% endschema %}
