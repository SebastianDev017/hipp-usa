{%- comment -%}theme-check-disable LiquidTag{%- endcomment -%}
{{- "css-main-page-blog-cover.css" | asset_url | stylesheet_tag -}}

{%- liquid 
  assign title = page.title
  assign image = section.settings.image
  assign text = section.settings.text
-%}

{% capture page_title %}
  {% assign splitted_title = title | split: ' ' %}
  {% for word in splitted_title %}
    {% unless forloop.last %}
      {{- word -}}
    {% endunless %}
    {% if forloop.last %}
      {% if forloop.index > 1 %}
        <span class="secondary-font-bold">{{- word -}}</span>
      {% else %}
        {{- word -}}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}

<div class="collection-cover blog-cover{% if image == blank %} no-image{%- endif -%}" data-section-id="{{- section.id -}}" data-section-type="blog-cover">
  {%- unless image == blank -%}
    <div class="collection-image-wrapper blog-cover-image-wrapper">
      <picture>
        <source media="(max-width: 450px)" srcset="{{- image | image_url: width: 600 -}}">
        <source media="(max-width: 834px)" srcset="{{- image | image_url: width: 800 -}}">
        <img class="collection-image blog-cover-image no-touch" alt="{{- image.alt -}}" fetchpriority="high" src="{{- image | image_url: width: 1000 -}}">
      </picture>
    </div>
  {%- endunless -%}
  <div class="blog-cover-info collection-info">
    <div class="blog-cover-info-inner-wrapper collection-info-inner-wrapper">
      <div class="blog-cover-info-inner collection-info-inner">
        <header class="blog-cover-title-wrapper collection-title-wrapper">
          <h1 class="collection-title color-green secondary-font">{{- page_title -}}</h1>
        </header>
        {%- unless text == blank -%}
          <div class="blog-cover-description collection-description color-green page-text">{{- text -}}</div>
        {%- endunless -%}
        {%- if section.settings.show_search -%}
          {%- render 'blog-search', placeholder: section.settings.search_placeholder -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  /* ── Buscador del blog: visible, on-brand y funcional ── */
  .blog-cover .blog-search { display: block; }
  .blog-cover .search-bar {
    display: grid;
    border: 1px solid #d4e3cd;
    box-shadow: 0 2px 10px rgba(31, 90, 44, .06);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .blog-cover .search-bar:focus-within {
    border-color: #2d7a3e;
    box-shadow: 0 0 0 3px rgba(45, 122, 62, .15);
  }

  /* Anula el "señuelo": permite escribir en el input */
  .blog-cover .blog-search-bar { cursor: auto; }
  .blog-cover .blog-search-bar-box { pointer-events: auto; color: #2f4a34; }

  /* Botón on-brand (verde HiPP) */
  .blog-cover .search-bar-button {
    --background-color: #2d7a3e;
    --hover-background-color: #1f5a2c;
    --text-color: #ffffff;
    --hover-text-color: #ffffff;
    background: #2d7a3e;
    color: #ffffff;
    cursor: pointer;
    transition: background .2s ease;
  }
  .blog-cover .search-bar-button:hover { background: #1f5a2c; }
  .blog-cover .search-bar-button svg,
  .blog-cover .search-bar-button svg path { fill: currentColor; }
  .blog-cover .search-bar-button svg { width: 18px; height: 18px; }
{% endstyle %}

{%- schema -%}
  {
    "name": "Blog - Portada",
    "tag": "section",
    "class": "blog-cover",
    "settings": [
      {
        "type": "header",
        "content": "Contenido"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Imagen"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Texto"
      },
      {
        "type": "header",
        "content": "🔍 Buscador"
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "Mostrar buscador",
        "default": true
      },
      {
        "type": "text",
        "id": "search_placeholder",
        "label": "Texto del buscador",
        "default": "Busca por palabra clave o tema"
      }
    ],
    "presets": [
      {
        "name": "Blog - Portada",
        "category": "Page"
      }
    ]
  }
{% endschema %}
