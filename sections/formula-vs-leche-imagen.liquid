{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings
-%}

<section class="fvl-image fvl-image-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="formula-vs-leche-imagen"
         style="
           {% if s.use_bg_color %}--fi-bg: {{ s.background_color }};{% else %}--fi-bg: transparent;{% endif %}
           --fi-max-width: {{ s.max_width }}px;
           --fi-pad-top-m: {{ s.padding_top_mobile }}px;
           --fi-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --fi-pad-top-d: {{ s.padding_top_desktop }}px;
           --fi-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
         ">

  {%- if s.image != blank -%}
    {%- if s.link != blank -%}
      <a href="{{ s.link }}" class="fvl-image-link">
    {%- endif -%}

    <img class="fvl-image-img"
         src="{{ s.image | image_url: width: 1600 }}"
         alt="{{ s.image.alt | default: s.alt_text | escape }}"
         width="{{ s.image.width }}"
         height="{{ s.image.height }}"
         {% if s.lazy %}loading="lazy"{% else %}loading="eager" fetchpriority="high"{% endif %}>

    {%- if s.link != blank -%}
      </a>
    {%- endif -%}
  {%- else -%}
    <div class="fvl-image-placeholder">
      {{ 'image' | placeholder_svg_tag }}
      <span>Sube la imagen desde el editor</span>
    </div>
  {%- endif -%}

</section>

{% style %}
.fvl-image-{{ uid }} {
  background-color: var(--fi-bg, transparent);
  padding: var(--fi-pad-top-m, 0px) 0 var(--fi-pad-bottom-m, 0px);
  line-height: 0;
}

.fvl-image-{{ uid }} .fvl-image-link {
  display: block;
}

.fvl-image-{{ uid }} .fvl-image-img {
  display: block;
  width: 100%;
  height: auto;
  max-width: var(--fi-max-width, 100%);
  margin: 0 auto;
}

.fvl-image-{{ uid }} .fvl-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 240px;
  background: #eef4e7;
  color: #2d7a3e;
  line-height: normal;
  font-family: var(--primary-font, sans-serif);
  font-size: 14px;
}
.fvl-image-{{ uid }} .fvl-image-placeholder svg { width: 60px; opacity: .5; }

@media (min-width: 768px) {
  .fvl-image-{{ uid }} {
    padding: var(--fi-pad-top-d, 0px) 0 var(--fi-pad-bottom-d, 0px);
  }
}
{% endstyle %}

{% schema %}
{
  "name": "FvL · Imagen",
  "tag": "section",
  "class": "fvl-image-section",
  "settings": [
    {
      "type": "header",
      "content": "🖼 Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Se muestra a ancho completo con altura automática (respeta su proporción)."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (accesibilidad / SEO)",
      "default": "Única fórmula orgánica de continuación en México"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al hacer clic (opcional)"
    },
    {
      "type": "checkbox",
      "id": "lazy",
      "label": "Carga diferida (lazy load)",
      "info": "Apágalo solo si esta imagen es lo primero que se ve al abrir la página.",
      "default": true
    },
    {
      "type": "header",
      "content": "📐 Diseño y espaciado"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo de la imagen",
      "info": "Déjalo alto para full-width. Bájalo si quieres limitar el ancho en escritorio.",
      "min": 400,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 2000
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "use_bg_color",
      "label": "Usar color de fondo",
      "info": "Apagado = transparente. Útil si limitas el ancho y queda espacio a los lados.",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espaciado superior — Móvil",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaciado inferior — Móvil",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Espaciado superior — Escritorio",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Espaciado inferior — Escritorio",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "FvL · Imagen",
      "category": "Formula vs Leche de Vaca"
    }
  ]
}
{% endschema %}
