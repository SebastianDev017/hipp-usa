{%- paginate collection.products by 36 -%}

  <section class="collection {{ collection_empty_class }}" data-section-id="{{- section.id -}}" data-section-type="main-collection">

    <div class="collection-container">

      {%- if has_products -%}
        <div class="collection-header">
          {%- render "main-collection-custom-sort", collection: collection, has_products: has_products -%}
        </div>
      {%- endif -%}

      <div class="collection-content-wrapper">
        <div class="collection-content section-content" id="ProductGridContainer">

          {%- if has_products -%}
						<div class="collection-grid products-grid js-product-cards-grid">
							{%- render "product-card" for collection.products as product -%}
						</div>
						{%- render "pagination", paginate: paginate, custom_class: "collection-pagination" -%}
          {%- else -%}
						<p class="collection-message page-text page-text-fit text-center">
							{{- "sections.collection_template.empty" | t -}}
						</p>
          {%- endif -%}

        </div>
      </div>

    </div>
   <h5 style="text-align:center;padding:20px 10px;font-family:Advert Bold;">Todos los precios mostrados son en moneda local MXN.00 <h6>

  </section>

{%- endpaginate -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}/collections/{{ collection.handle }}"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | json }},
  "url": "{{ shop.url }}/collections/{{ collection.handle }}",
  "image": {
    "@type": "ImageObject",
    "url": "{{ collection.image | image_url: width: 1200 | prepend: 'https:' }}"
  },
  "numberOfItems": {{ collection.products_count }},
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": "{{ shop.url }}"
  }
}
</script>
{%- schema -%}
  {
    "name": "Colección",
    "class": "collection-section content-hidden"
  }
{% endschema %}
