{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif

  assign bubbles = section.blocks | where: 'type', 'bubble'
  assign icons = section.blocks | where: 'type', 'icon'
-%}

<section class="pq pq-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="por-que-organica"
         style="
           --pq-bg: {{ s.bg_color }};
           --pq-title-color: {{ s.title_color }};
           --pq-highlight-color: {{ s.highlight_color }};
           --pq-subtitle-color: {{ s.subtitle_color }};
           --pq-body-color: {{ s.body_color }};
           --pq-title-font: {{ title_font_var }};
           --pq-body-font: {{ body_font_var }};
           --pq-mil-w: {{ s.mil_max_width }}px;
           --pq-bubble-size-d: {{ s.bubble_size_desktop }}px;
           --pq-bubble-size-m: {{ s.bubble_size_mobile }}px;
           --pq-bubbles-gap: {{ s.bubbles_gap }}px;
           --pq-bubble-text-d: {{ s.bubble_text_size_desktop }}px;
           --pq-bubble-text-m: {{ s.bubble_text_size_mobile }}px;
           --pq-icon-size-d: {{ s.icon_size_desktop }}px;
           --pq-icon-size-m: {{ s.icon_size_mobile }}px;
           --pq-icons-gap: {{ s.icons_gap }}px;
           --pq-title-size-d: {{ s.title_size_desktop }}px;
           --pq-title-size-m: {{ s.title_size_mobile }}px;
           --pq-subtitle-size-d: {{ s.subtitle_size_desktop }}px;
           --pq-subtitle-size-m: {{ s.subtitle_size_mobile }}px;
           --pq-body-size-d: {{ s.body_size_desktop }}px;
           --pq-body-size-m: {{ s.body_size_mobile }}px;
           --pq-max-width: {{ s.content_max_width }}px;
           --pq-pad-top-d: {{ s.padding_top_desktop }}px;
           --pq-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --pq-pad-top-m: {{ s.padding_top_mobile }}px;
           --pq-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --pq-gap-d: {{ s.block_gap_desktop }}px;
           --pq-gap-m: {{ s.block_gap_mobile }}px;
         ">

  <div class="pq-inner">

    {%- if s.title != blank -%}
      <div class="pq-title">{{ s.title }}</div>
    {%- endif -%}

    {%- comment -%} ===== 1000 + fila de burbujas debajo ===== {%- endcomment -%}
    {%- if s.image_1000 != blank or bubbles.size > 0 -%}
      <div class="pq-mil">
        {%- if s.image_1000 != blank -%}
          <img class="pq-mil-img" src="{{ s.image_1000 | image_url: width: 1200 }}"
               alt="{{ s.image_1000.alt | escape }}" loading="lazy">
        {%- endif -%}

        {%- if bubbles.size > 0 -%}
          <div class="pq-bubbles">
            {%- for block in bubbles -%}
              <div class="pq-bubble" style="--b-text-color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img class="pq-bubble-img" src="{{ block.settings.image | image_url: width: 500 }}"
                       alt="" loading="lazy">
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="pq-bubble-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.subtitle != blank -%}
      <div class="pq-subtitle">{{ s.subtitle }}</div>
    {%- endif -%}

    {%- comment -%} ===== Fila de íconos (el círculo ya viene en el PNG) ===== {%- endcomment -%}
    {%- if icons.size > 0 -%}
      <div class="pq-icons">
        {%- for block in icons -%}
          <div class="pq-icon" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="pq-body">{{ s.body }}</div>
    {%- endif -%}

  </div>

</section>

{% style %}
.pq-{{ uid }} {
  background-color: var(--pq-bg, #dfe9d3);
  padding: var(--pq-pad-top-m, 40px) 20px var(--pq-pad-bottom-m, 40px);
  text-align: center;
}

.pq-{{ uid }} .pq-inner {
  max-width: var(--pq-max-width, 460px);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--pq-gap-m, 28px);
}

/* Título */
.pq-{{ uid }} .pq-title {
  font-family: var(--pq-title-font);
  font-size: var(--pq-title-size-m, 22px);
  line-height: 1.25;
  color: var(--pq-title-color, #1f5a2c);
  font-weight: 700;
}
.pq-{{ uid }} .pq-title strong,
.pq-{{ uid }} .pq-title b { color: var(--pq-highlight-color, #2d7a3e); }
.pq-{{ uid }} .pq-title p { margin: 0; }

/* Bloque 1000 */
.pq-{{ uid }} .pq-mil { width: 100%; }
.pq-{{ uid }} .pq-mil-img {
  display: block;
  width: 100%;
  max-width: var(--pq-mil-w, 320px);
  height: auto;
  margin: 0 auto;
}

/* Fila de burbujas: SIEMPRE en fila (no se apila en móvil) */
.pq-{{ uid }} .pq-bubbles {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  gap: var(--pq-bubbles-gap, 10px);
  margin-top: 6px;
}
.pq-{{ uid }} .pq-bubble {
  position: relative;
  flex: 0 0 auto;
  width: var(--pq-bubble-size-m, 105px);
}
.pq-{{ uid }} .pq-bubble-img { display: block; width: 100%; height: auto; }
.pq-{{ uid }} .pq-bubble-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 14%;
  box-sizing: border-box;
  font-family: var(--pq-body-font);
  font-size: var(--pq-bubble-text-m, 9px);
  line-height: 1.2;
  color: var(--b-text-color, #1f5a2c);
}
.pq-{{ uid }} .pq-bubble-text p { margin: 0; }
.pq-{{ uid }} .pq-bubble-text strong { font-weight: 700; }

/* Subtítulo */
.pq-{{ uid }} .pq-subtitle {
  font-family: var(--pq-title-font);
  font-size: var(--pq-subtitle-size-m, 18px);
  line-height: 1.3;
  color: var(--pq-subtitle-color, #1f5a2c);
  font-weight: 700;
  max-width: 90%;
}
.pq-{{ uid }} .pq-subtitle strong,
.pq-{{ uid }} .pq-subtitle b { color: var(--pq-highlight-color, #2d7a3e); }
.pq-{{ uid }} .pq-subtitle p { margin: 0; }

/* Fila de íconos: SIEMPRE en fila */
.pq-{{ uid }} .pq-icons {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: center;
  gap: var(--pq-icons-gap, 20px);
  width: 100%;
}
.pq-{{ uid }} .pq-icon {
  flex: 0 0 auto;
  width: var(--pq-icon-size-m, 84px);
}
.pq-{{ uid }} .pq-icon img { display: block; width: 100%; height: auto; }

/* Cuerpo */
.pq-{{ uid }} .pq-body {
  font-family: var(--pq-body-font);
  font-size: var(--pq-body-size-m, 14px);
  line-height: 1.55;
  color: var(--pq-body-color, #1f5a2c);
}
.pq-{{ uid }} .pq-body strong,
.pq-{{ uid }} .pq-body b { color: var(--pq-highlight-color, #2d7a3e); font-weight: 700; }
.pq-{{ uid }} .pq-body p { margin: 0 0 14px; }
.pq-{{ uid }} .pq-body p:last-child { margin-bottom: 0; }

@media (min-width: 768px) {
  .pq-{{ uid }} { padding: var(--pq-pad-top-d, 64px) 40px var(--pq-pad-bottom-d, 64px); }
  .pq-{{ uid }} .pq-inner { gap: var(--pq-gap-d, 40px); }
  .pq-{{ uid }} .pq-title { font-size: var(--pq-title-size-d, 30px); }
  .pq-{{ uid }} .pq-bubble { width: var(--pq-bubble-size-d, 150px); }
  .pq-{{ uid }} .pq-bubble-text { font-size: var(--pq-bubble-text-d, 12px); }
  .pq-{{ uid }} .pq-subtitle { font-size: var(--pq-subtitle-size-d, 26px); }
  .pq-{{ uid }} .pq-icon { width: var(--pq-icon-size-d, 110px); }
  .pq-{{ uid }} .pq-body { font-size: var(--pq-body-size-d, 17px); }
}
{% endstyle %}

{% schema %}
{
  "name": "Por qué orgánica",
  "tag": "section",
  "class": "pq-section",
  "settings": [
    { "type": "header", "content": "📝 Título" },
    { "type": "richtext", "id": "title", "label": "Título", "info": "Usa negrita para resaltar con el color de acento.", "default": "<p>¿Por qué una <strong>alimentación orgánica</strong> es especialmente <strong>importante para bebés y niños?</strong></p>" },

    { "type": "header", "content": "🔢 Bloque 1000" },
    { "type": "image_picker", "id": "image_1000", "label": "Imagen del 1000 (PNG)" },
    { "type": "range", "id": "mil_max_width", "label": "Ancho del 1000", "min": 120, "max": 480, "step": 20, "unit": "px", "default": 320 },
    { "type": "paragraph", "content": "Las 3 burbujas van en fila DEBAJO del 1000. Agrégalas abajo con “Agregar burbuja”." },

    { "type": "header", "content": "🫧 Burbujas (fila)" },
    { "type": "range", "id": "bubble_size_desktop", "label": "Tamaño de burbuja — Escritorio", "min": 90, "max": 220, "step": 10, "unit": "px", "default": 150 },
    { "type": "range", "id": "bubble_size_mobile", "label": "Tamaño de burbuja — Móvil", "min": 70, "max": 160, "step": 5, "unit": "px", "default": 105 },
    { "type": "range", "id": "bubbles_gap", "label": "Espacio entre burbujas", "min": 4, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "bubble_text_size_desktop", "label": "Texto de burbuja — Escritorio", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "bubble_text_size_mobile", "label": "Texto de burbuja — Móvil", "min": 7, "max": 14, "step": 1, "unit": "px", "default": 9 },

    { "type": "header", "content": "📝 Subtítulo" },
    { "type": "richtext", "id": "subtitle", "label": "Subtítulo", "default": "<p>Los bebés y los niños son más vulnerables a los <strong>efectos tóxicos de los pesticidas</strong></p>" },

    { "type": "header", "content": "🧠 Íconos (fila)" },
    { "type": "paragraph", "content": "Cada ícono es un PNG que ya incluye su círculo de color. Agrégalos abajo con “Agregar ícono”." },
    { "type": "range", "id": "icon_size_desktop", "label": "Tamaño de ícono — Escritorio", "min": 60, "max": 180, "step": 10, "unit": "px", "default": 110 },
    { "type": "range", "id": "icon_size_mobile", "label": "Tamaño de ícono — Móvil", "min": 44, "max": 130, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "icons_gap", "label": "Espacio entre íconos", "min": 6, "max": 60, "step": 2, "unit": "px", "default": 20 },

    { "type": "header", "content": "📝 Cuerpo" },
    { "type": "richtext", "id": "body", "label": "Texto del cuerpo", "default": "<p><strong>El hígado, los riñones y el cerebro,</strong> no tienen la capacidad de eliminar los pesticidas y las sustancias químicas tóxicas del cuerpo de manera eficiente, ya que se encuentran inmaduros.</p><p>El consumo de <strong>alimentos orgánicos</strong> es una forma de minimizar la exposición dietética crónica a los pesticidas y así <strong>reducir el potencial de riesgos a la salud.</strong></p>" },

    { "type": "header", "content": "🎨 Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección", "default": "#dfe9d3" },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1f5a2c" },
    { "type": "color", "id": "highlight_color", "label": "Color de texto resaltado (negritas)", "default": "#2d7a3e" },
    { "type": "color", "id": "subtitle_color", "label": "Color del subtítulo", "default": "#1f5a2c" },
    { "type": "color", "id": "body_color", "label": "Color del cuerpo", "default": "#1f5a2c" },

    { "type": "header", "content": "🔤 Tipografía" },
    {
      "type": "select", "id": "title_font", "label": "Fuente de títulos",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select", "id": "body_font", "label": "Fuente de textos",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "title_size_desktop", "label": "Tamaño del título — Escritorio", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño del título — Móvil", "min": 16, "max": 34, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "subtitle_size_desktop", "label": "Tamaño del subtítulo — Escritorio", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "subtitle_size_mobile", "label": "Tamaño del subtítulo — Móvil", "min": 14, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "body_size_desktop", "label": "Tamaño del cuerpo — Escritorio", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "body_size_mobile", "label": "Tamaño del cuerpo — Móvil", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "📐 Espaciado" },
    { "type": "range", "id": "content_max_width", "label": "Ancho máximo del contenido", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 460 },
    { "type": "range", "id": "block_gap_desktop", "label": "Espacio entre bloques — Escritorio", "min": 12, "max": 72, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "block_gap_mobile", "label": "Espacio entre bloques — Móvil", "min": 8, "max": 56, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaciado superior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaciado inferior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaciado superior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaciado inferior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "name": "Burbuja",
      "type": "bubble",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen de la burbuja (PNG círculo)" },
        { "type": "richtext", "id": "text", "label": "Texto dentro de la burbuja", "default": "<p>Texto de la burbuja</p>" },
        { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#1f5a2c" }
      ]
    },
    {
      "name": "Ícono",
      "type": "icon",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ícono (PNG con círculo)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Por qué orgánica",
      "category": "Nuestra Familia",
      "blocks": [
        { "type": "bubble", "settings": { "text": "<p>Los primeros <strong>1,000 días</strong> son una etapa importante para el crecimiento adecuado desde la etapa fetal hasta los 2 años de vida.</p>" } },
        { "type": "bubble", "settings": { "text": "<p>Se han encontrado más de <strong>280 sustancias</strong> en la sangre del cordón umbilical de bebés al nacimiento.</p>" } },
        { "type": "bubble", "settings": { "text": "<p>Mejora el <strong>desarrollo cognitivo y disminuye</strong> la probabilidad de <strong>pubertad precoz y cáncer.</strong></p>" } },
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" }
      ]
    }
  ]
}
{% endschema %}
