{% comment %}theme-check-disable{% endcomment %}

{{- 'css-main-product.css' | asset_url | stylesheet_tag -}}

{%- liquid 
  assign metafields = product.metafields.custom
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign url_etiqueta = metafields.etiqueta.value
  assign has_only_default_variant = product.has_only_default_variant

  assign subscription_variant_price = false

  for variant in product.variants
    assign subscription = variant.metafields.custom.suscripcion.value | handleize
    if subscription == "si"
      assign subscription_variant_price = variant.price
      break
    endif
  endfor
-%}

{%- comment -%}
  ============================================================
  JSON-LD Schema markup - Product + AggregateRating
  Precios calculados con divided_by para evitar caracteres
  inválidos como $ o , que rompen el JSON
  ============================================================
{%- endcomment -%}
{%- assign jm_review_count = product.metafields.judgeme.badge.value.review_count | default: 0 -%}
{%- assign jm_review_average = product.metafields.judgeme.badge.value.average | default: 0 -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  "image": [
    {%- for image in product.images limit: 5 -%}
      {{ image | image_url: width: 1200 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  "sku": {{ selected_variant.sku | default: product.id | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "offers": {
    {%- if product.variants.size > 1 -%}
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "lowPrice": "{{ product.price_min | divided_by: 100.0 }}",
      "highPrice": "{{ product.price_max | divided_by: 100.0 }}",
      "offerCount": {{ product.variants.size }},
      "availability": {%- if product.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
      "url": {{ shop.url | append: product.url | json }}
    {%- else -%}
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": "{{ selected_variant.price | divided_by: 100.0 }}",
      "availability": {%- if selected_variant.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
      "url": {{ shop.url | append: product.url | json }}
    {%- endif -%}
  }
{%- if jm_review_count != blank and jm_review_count != 0 -%}  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ jm_review_average }}",
    "reviewCount": "{{ jm_review_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>

<div class="main-product" data-section-id="{{- section.id -}}" data-section-type="main-product">
  <div class="main-product-content">
    <div class="main-product-left">
      {% render 'main-product-carousel' with product %}
    </div>
    <div class="main-product-right">
      <div class="main-product-info">
        {%- if product.metafields.custom.producto_nuevo == true -%}
          {%- render 'new-product' -%}
        {%- endif -%}
        {%- render 'main-product-info-header', product: product -%}
        {%- render 'main-product-info-tabs', product: product -%}
        <div class="main-product-form">
          {%- render 'main-product-form', product: product, product_form_id: product_form_id, selected_variant: selected_variant, section: section -%}
        </div>
        {%- render 'main-product-etiqueta', product: product, custom_class: 'desktop' -%}
        {%- render 'main-product-accordions', product: product, section: section -%}
        {%- render 'main-product-etiqueta', product: product, custom_class: 'mobile' -%}
      </div>
    </div>
  </div>

  <script type="application/json" id="selectedVariant">
		{{ selected_variant | json }}
	</script>
  {% render 'reviews-collapse' %}
</div>

<script>
  window.productHasOnlyDefaultVariant = {{ has_only_default_variant }};
  window.subscriptionVariantPrice = {{ subscription_variant_price }};
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.type | json }},
      "item": "{{ shop.url }}/collections/{{ product.collections.first.handle }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
  ]
}
</script>
{% schema %}
{
  "name": "Producto",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Regalo"
    },
    {
      "type": "text",
      "id": "gift_label",
      "label": "Texto"
    },
    {
      "type": "header",
      "content": "🔒 Confianza (debajo del formulario)"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Mostrar garantías y métodos de pago",
      "default": true
    },
    {
      "type": "header",
      "content": "💳 Métodos de pago (sube cada logo)"
    },
    {
      "type": "paragraph",
      "content": "Sube cada logo de pago por separado. Los que dejes vacíos no se muestran."
    },
    { "type": "image_picker", "id": "payment_1", "label": "Logo de pago 1" },
    { "type": "image_picker", "id": "payment_2", "label": "Logo de pago 2" },
    { "type": "image_picker", "id": "payment_3", "label": "Logo de pago 3" },
    { "type": "image_picker", "id": "payment_4", "label": "Logo de pago 4" },
    { "type": "image_picker", "id": "payment_5", "label": "Logo de pago 5" },
    { "type": "image_picker", "id": "payment_6", "label": "Logo de pago 6" },
    {
      "type": "range",
      "id": "payment_size",
      "label": "Tamaño de los logos de pago",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "✅ Garantías (ícono + texto)"
    },
    {
      "type": "paragraph",
      "content": "Sube un ícono y escribe su texto para cada garantía. Las que dejes vacías no se muestran."
    },
    { "type": "image_picker", "id": "badge_1_icon", "label": "Ícono 1" },
    { "type": "text", "id": "badge_1_text", "label": "Texto 1", "default": "Empaque seguro" },
    { "type": "image_picker", "id": "badge_2_icon", "label": "Ícono 2" },
    { "type": "text", "id": "badge_2_text", "label": "Texto 2", "default": "Envío estándar gratis*" },
    { "type": "image_picker", "id": "badge_3_icon", "label": "Ícono 3" },
    { "type": "text", "id": "badge_3_text", "label": "Texto 3", "default": "Devolución gratuita*" },
    { "type": "image_picker", "id": "badge_4_icon", "label": "Ícono 4" },
    { "type": "text", "id": "badge_4_text", "label": "Texto 4", "default": "Productos 100% originales" },
    { "type": "image_picker", "id": "badge_5_icon", "label": "Ícono 5" },
    { "type": "text", "id": "badge_5_text", "label": "Texto 5", "default": "Atención 100% personalizada" },
    {
      "type": "range",
      "id": "badge_icon_size",
      "label": "Tamaño de los íconos",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "text",
      "id": "badges_footnote",
      "label": "Nota al pie",
      "default": "*Consulta términos y condiciones en nuestras políticas de envío."
    }
  ]
}
{% endschema %}
