{%- comment -%}
  HiPP USA — formulario de contacto.

  Reemplaza a sections/contact-form.liquid del tema mexicano.

  Es un {% form 'contact' %} nativo: hace POST y Shopify redirige a la misma URL
  con ?contact_posted=true. No hay JavaScript de por medio, asi que no se puede
  romper.

  El mensaje de exito va ARRIBA del formulario y con role="status": si va abajo,
  el usuario que acaba de enviar no lo ve sin hacer scroll y vuelve a mandar.
{%- endcomment -%}

<section class="hp-section hp-section--tight hp-contact" id="{{ section.settings.anchor_id | default: 'contact' }}">
  <div class="hp-wrap hp-wrap--narrow">
    {%- if section.settings.kicker != blank -%}
      <p class="hp-kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="hp-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.lead != blank -%}
      <div class="hp-lead hp-contact__lead">{{ section.settings.lead }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'hp-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="hp-formnote" role="status">
          {{ 'templates.contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="hp-formnote hp-formnote--error" role="alert">
          <p class="hp-formnote__title">{{ 'templates.contact.form.error_heading' | t }}</p>
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="hp-form__row">
        <div class="hp-field">
          <label for="ContactName">{{ 'templates.contact.form.name' | t }}</label>
          <input
            type="text"
            id="ContactName"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            autocomplete="name"
          >
        </div>

        <div class="hp-field">
          <label for="ContactEmail">{{ 'templates.contact.form.email' | t }}</label>
          <input
            type="email"
            id="ContactEmail"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            autocomplete="email"
            required
          >
        </div>
      </div>

      {%- if section.settings.show_phone -%}
        <div class="hp-field">
          <label for="ContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
          <input
            type="tel"
            id="ContactPhone"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            autocomplete="tel"
          >
        </div>
      {%- endif -%}

      <div class="hp-field">
        <label for="ContactBody">{{ 'templates.contact.form.comment' | t }}</label>
        <textarea id="ContactBody" name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <button type="submit" class="hp-btn">
        {%- if section.settings.button_label != blank -%}
          {{ section.settings.button_label }}
        {%- else -%}
          {{ 'templates.contact.form.send' | t }}
        {%- endif -%}
      </button>

      {%- if section.settings.note != blank -%}
        <p class="hp-form__note">{{ section.settings.note }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "hp-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Write to us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We are parents too."
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Lead",
      "default": "<p>Questions about a formula, an order or a subscription. A person reads every message and answers within one business day.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Ask for a phone number",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": "We answer within one business day, Monday to Friday."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "contact"
    }
  ]
}
{% endschema %}
