{%- comment -%}
  HiPP USA — las tres fórmulas.

  Cada bloque puede apuntar a un producto real. La precedencia es BLOCK-FIRST:
  lo que escribas en el bloque manda, y el producto solo rellena los campos que
  dejes vacios (imagen, precio, enlace, titulo). Es a proposito: la tienda
  todavia no tiene productos cargados y la home tiene que verse terminada igual,
  sin referencias rotas, pero el cliente tambien tiene que poder pisar un texto
  puntual sin desconectar el producto.

  ORDEN DE RESOLUCION DE LA IMAGEN
    1. imagen del bloque (image_picker)
    2. imagen destacada del producto
    3. archivo en assets/ (image_asset)
  El paso 3 existe porque un image_picker apunta a shopify://shop_images/... y
  esos archivos viven en los Files de la tienda mexicana, no en esta.
{%- endcomment -%}

{%- liquid
  assign cards = section.blocks | where: 'type', 'formula'
-%}

{%- if section.settings.show_hill -%}
  {%- render 'hipp-hill', fill: '#EBF3E3', above: section.settings.hill_above -%}
{%- endif -%}

<section class="hp-products hp-section{% if section.settings.show_hill %} hp-section--tight{% endif %}" {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handle }}"{% endif %}>
  <div class="hp-wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="hp-kicker hp-reveal">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hp-h2 hp-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <div class="hp-lead hp-reveal">{{ section.settings.lead }}</div>
    {%- endif -%}

    {%- if cards.size > 0 -%}
      <div class="hp-prod-grid" data-hp-stagger>
        {%- for block in cards -%}
          {%- liquid
            assign product = block.settings.product
            assign image = block.settings.image
            if image == blank and product != blank
              assign image = product.featured_image
            endif

            assign href = block.settings.link
            if href == blank and product != blank
              assign href = product.url
            endif

            assign title = block.settings.title
            if title == blank and product != blank
              assign title = product.title
            endif

            assign price = block.settings.price
            if price == blank and product != blank
              comment
                La tarjeta dice "From $X / box", pero product.price_min es el
                precio del BUNDLE mas barato: con el catalogo real (4 cajas a
                $116) imprimiria "From $116 / box". Se deriva el precio POR CAJA
                dividiendo el precio de cada variante por su cantidad de cajas,
                que es el valor de option1 ("4", "8", "16"). Si esa opcion no es
                numerica (producto sin bundles), boxes queda en 0, no se toma
                ninguna variante y cae al comportamiento anterior.
              endcomment
              assign per_box = 0
              for variant in product.variants
                assign boxes = variant.option1 | times: 1
                if boxes > 0
                  assign unit = variant.price | divided_by: boxes
                  if per_box == 0 or unit < per_box
                    assign per_box = unit
                  endif
                endif
              endfor

              if per_box > 0
                assign price = per_box | money_without_trailing_zeros
              else
                assign price = product.price_min | money_without_trailing_zeros
              endif
            endif
          -%}

          <a class="hp-prod" href="{{ href | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="hp-prod__tag{% if block.settings.tag_accent %} hp-prod__tag--clay{% endif %}">
                {{- block.settings.tag -}}
              </span>
            {%- else -%}
              <span class="hp-prod__tag hp-prod__tag--empty" aria-hidden="true">&nbsp;</span>
            {%- endif -%}

            <div class="hp-prod__photo">
              {%- if image != blank -%}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 760px) 250px, 70vw"
                  alt="{{ image.alt | default: title | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="lazy"
                >
              {%- elsif block.settings.image_asset != blank -%}
                <img
                  src="{{ block.settings.image_asset | asset_img_url: '600x' }}"
                  srcset="{{ block.settings.image_asset | asset_img_url: '400x' }} 400w, {{ block.settings.image_asset | asset_img_url: '600x' }} 600w"
                  sizes="(min-width: 760px) 250px, 70vw"
                  alt="{{ title | escape }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- endif -%}
            </div>

            {%- if title != blank -%}
              <h3>{{ title }}</h3>
            {%- endif -%}
            {%- if block.settings.for != blank -%}
              <p class="hp-prod__for">{{ block.settings.for }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="hp-prod__text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- if price != blank -%}
              <p class="hp-prod__from">
                {{- section.settings.price_prefix }} <strong>{{ price }}</strong> {{ section.settings.price_suffix -}}
              </p>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <span class="hp-btn hp-btn--ghost">{{ block.settings.button_label }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fórmulas",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo",
      "default": "Our formulas"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Three formulas. Every baby covered."
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Texto",
      "default": "<p>Start with Combiotik. If your little one needs something gentler, Comfort and AR are made for sensitive tummies and reflux.</p>"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancla",
      "default": "products"
    },
    {
      "type": "header",
      "content": "Precio"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Antes del precio",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Después del precio",
      "default": "/ box"
    },
    {
      "type": "header",
      "content": "Divisor"
    },
    {
      "type": "checkbox",
      "id": "show_hill",
      "label": "Colina arriba",
      "default": true
    },
    {
      "type": "color",
      "id": "hill_above",
      "label": "Fondo de la sección anterior",
      "default": "#FAF8F3"
    }
  ],
  "blocks": [
    {
      "type": "formula",
      "name": "Fórmula",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto",
          "info": "Rellena solo los campos que dejes vacíos: imagen, precio, enlace y título."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Combiotik"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Etiqueta"
        },
        {
          "type": "checkbox",
          "id": "tag_accent",
          "label": "Etiqueta en verde",
          "default": false
        },
        {
          "type": "text",
          "id": "for",
          "label": "Para quién",
          "default": "For every day, 0 to 12 months"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "header",
          "content": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Imagen del tema",
          "info": "Nombre de archivo dentro de assets/. Se usa solo si no hay imagen ni producto."
        },
        {
          "type": "header",
          "content": "Precio y enlace"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio manual",
          "info": "Si lo dejás vacío, se calcula el precio por caja del producto elegido."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fórmulas",
      "blocks": [
        {
          "type": "formula",
          "settings": {
            "title": "Combiotik",
            "tag": "Most popular",
            "tag_accent": true,
            "for": "For every day, 0 to 12 months",
            "text": "HiPP's flagship German organic formula with natural lactic acid cultures and prebiotic fibers, modeled on the gentle nutrition babies naturally thrive on.",
            "image_asset": "hipp-formula-combiotik.png",
            "price": "$29",
            "button_label": "Shop Combiotik"
          }
        },
        {
          "type": "formula",
          "settings": {
            "title": "Comfort",
            "tag": "Sensitive tummies",
            "for": "For colic, gas and constipation",
            "text": "A specially developed formula with reduced lactose and gently broken down proteins, designed to ease digestion when your baby needs extra comfort.",
            "image_asset": "hipp-formula-comfort.png",
            "price": "$29",
            "button_label": "Shop Comfort"
          }
        },
        {
          "type": "formula",
          "settings": {
            "title": "AR",
            "tag": "Reflux",
            "for": "For frequent spit up",
            "text": "Anti reflux formula naturally thickened with organic locust bean gum, helping feeds stay down so meals end in sleep instead of laundry.",
            "image_asset": "hipp-formula-ar.png",
            "price": "$29",
            "button_label": "Shop AR"
          }
        }
      ]
    }
  ]
}
{% endschema %}
