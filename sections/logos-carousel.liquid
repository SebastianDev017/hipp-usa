{{- 'css-logos-carousel.css' | asset_url | stylesheet_tag -}}
<script src="{{- 'js-logos-carousel.js' | asset_url -}}" defer></script>

{%- liquid 
  assign image_1 = section.settings.image_1
  assign video_1 = section.settings.video_1
  assign icon_1 = section.settings.icon_1
  assign image_2 = section.settings.image_2
  assign video_2 = section.settings.video_2
  assign icon_2 = section.settings.icon_2
  assign title = section.settings.title
  assign text = section.settings.text
  assign blocks = section.blocks
  assign blocks_size = blocks | size
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign has_assets = false
  assign has_button = false
  if image_1 != blank or video_1 != blank or icon_1 != blank or image_2 != blank or video_2 != blank or icon_2 != blank
    assign has_assets = true
  endif
  if button_label != blank and button_link != blank
    assign has_button = true
  endif
-%}

<div class="logos-carousel section" 
     style="--blocks-size: {{ blocks_size }};" 
     data-section-id="{{- section.id -}}" 
     data-section-type="logos-carousel">

  <div class="logos-carousel-content section-content text-center">

    {%- unless title == blank -%}
      <header class="logos-carousel-title-wrapper" data-aos="fade-up">
        <h2 class="logos-carousel-title section-title-richtext color-green">{{- title -}}</h2>
      </header>
    {%- endunless -%}

    {%- if blocks_size > 0 -%}
      <div class="logos-carousel-swiper-wrapper" data-aos="fade-up">
        <div class="logos-carousel-swiper swiper">
          <div class="swiper-wrapper">
            {%- render 'logos-carousel-item' for blocks as block -%}
          </div>
        </div>

        <button class="logos-carousel-swiper-button swiper-button prev transparent{% if blocks_size <= 3 %} hide-desktop{% endif %}" 
                type="button" role="button" aria-label="Anterior">
          {%- render 'icon', icon: 'arrow-prev' -%}
        </button>
        <button class="logos-carousel-swiper-button swiper-button next transparent{% if blocks_size <= 3 %} hide-desktop{% endif %}" 
                type="button" role="button" aria-label="Siguiente">
          {%- render 'icon', icon: 'arrow-next' -%}
        </button>

        <!-- Dots mobile -->
        <div class="logos-carousel-mobile-dots" data-section-id="{{ section.id }}">
          {%- for block in blocks -%}
            <span class="logos-carousel-mobile-dot{% if forloop.first %} is-active{% endif %}" 
                  data-index="{{ forloop.index0 }}"></span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- unless text == blank -%}
      <p class="logos-carousel-text color-green" data-aos="fade-up">{{- text -}}</p>
    {%- endunless -%}

    {%- if has_button -%}
      {%- capture target -%}
        {%- if button_link contains 'http' or button_link contains 'tel:' or button_link contains 'maps/' or button_link contains 'mailto:' -%}
          target="_blank"
        {%- endif -%}
      {%- endcapture -%}
      <div class="logos-carousel-button-wrapper" data-aos="fade-up">
        <a class="button" href="{{- button_link -}}" title="{{- button_label -}}" {{ target -}}>{{- button_label -}}</a>
      </div>
    {%- endif -%}
  </div>

  {%- if has_assets -%}
    <div class="logos-carousel-assets no-touch" data-aos="fade-up">
      {%- if image_1 != blank or video_1 != blank or icon_1 != blank -%}
        <div class="logos-carousel-asset asset-left">
          <div>
            <div class="logos-carousel-asset-image-wrapper square-image image-cover">
              {%- if video_1 != blank -%}
                <video class="logos-carousel-asset-video"
                       muted playsinline preload="metadata" data-autoplay-once
                       {% if video_1.preview_image != blank %}poster="{{ video_1.preview_image | image_url: width: 800 }}"{% endif %}>
                  {%- for source in video_1.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif image_1 != blank -%}
                <img class="logos-carousel-asset-image" src="{{- image_1 | image_url -}}" alt="{{- image_1.alt -}}" loading="lazy">
              {%- endif -%}
            </div>
            {%- unless icon_1 == blank -%}
              <div class="logos-carousel-asset-icon-wrapper square-image image-contain">
                <img class="logos-carousel-asset-icon icon-left" src="{{- icon_1 | image_url -}}" alt="{{- icon_1.alt -}}" loading="lazy">
              </div>
            {%- endunless -%}
          </div>
        </div>
      {%- endif -%}
      {%- if image_2 != blank or video_2 != blank or icon_2 != blank -%}
        <div class="logos-carousel-asset asset-right">
          <div>
            <div class="logos-carousel-asset-image-wrapper square-image image-cover">
              {%- if video_2 != blank -%}
                <video class="logos-carousel-asset-video"
                       muted playsinline preload="metadata" data-autoplay-once
                       {% if video_2.preview_image != blank %}poster="{{ video_2.preview_image | image_url: width: 800 }}"{% endif %}>
                  {%- for source in video_2.sources -%}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {%- endfor -%}
                </video>
              {%- elsif image_2 != blank -%}
                <img class="logos-carousel-asset-image" src="{{- image_2 | image_url -}}" alt="{{- image_2.alt -}}" loading="lazy">
              {%- endif -%}
            </div>
            {%- unless icon_2 == blank -%}
              <div class="logos-carousel-asset-icon-wrapper square-image image-contain">
                <img class="logos-carousel-asset-icon icon-right" src="{{- icon_2 | image_url -}}" alt="{{- icon_2.alt -}}" loading="lazy">
              </div>
            {%- endunless -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrusel de logos",
  "tag": "section",
  "class": "logos-section",
  "settings": [
    { "type": "header", "content": "Asset izquierdo" },
    { "type": "paragraph", "content": "Sube imagen O video (uno u otro). Si subes video, tiene prioridad y arranca solo al entrar a la sección, una vez, sin sonido." },
    { "type": "image_picker", "id": "image_1", "label": "Imagen 1" },
    { "type": "video", "id": "video_1", "label": "Video 1 (MP4)" },
    { "type": "image_picker", "id": "icon_1", "label": "Ícono 1" },
    { "type": "header", "content": "Asset derecho" },
    { "type": "paragraph", "content": "Sube imagen O video (uno u otro). Si subes video, tiene prioridad y arranca solo al entrar a la sección, una vez, sin sonido." },
    { "type": "image_picker", "id": "image_2", "label": "Imagen 2" },
    { "type": "video", "id": "video_2", "label": "Video 2 (MP4)" },
    { "type": "image_picker", "id": "icon_2", "label": "Ícono 2" },
    { "type": "header", "content": "Contenido" },
    { "type": "richtext", "id": "title", "label": "Título" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "button_label", "label": "Texto" },
    { "type": "url", "id": "button_link", "label": "Enlace" }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "name": "Logo",
      "type": "image",
      "settings": [
        { "type": "header", "content": "Imagen" },
        { "type": "image_picker", "id": "image", "label": "Imagen" }
      ]
    }
  ],
  "presets": [
    { "category": "Homepage", "name": "Carrusel de logos" }
  ]
}
{% endschema %}

{% style %}

/* ── Flechas verdes HiPP en TODAS las resoluciones ── */
.logos-carousel-swiper-button {
  opacity: 1 !important;
}
.logos-carousel-swiper-button svg path,
.logos-carousel-swiper-button svg polygon,
.logos-carousel-swiper-button svg line {
  stroke: #2d7a3e;
  fill: #2d7a3e;
}
.logos-carousel-swiper-button:hover svg path,
.logos-carousel-swiper-button:hover svg polygon,
.logos-carousel-swiper-button:hover svg line {
  stroke: #1e5a2a;
  fill: #1e5a2a;
}
.logos-carousel-swiper-button.swiper-button-disabled {
  opacity: 0.3 !important;
}

/* ── Video de los assets laterales: ocupa igual que la imagen ── */
.logos-carousel-asset-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Ocultar flechas en desktop cuando no hay carrusel ── */
@media (min-width: 681px) {
  .logos-carousel-swiper-button.hide-desktop {
    display: none !important;
  }
}

/* ── Dots mobile: ocultos por defecto ── */
.logos-carousel-mobile-dots {
  display: none;
}

/* ── MOBILE: 1 logo visible + flechas + dots ── */
@media (max-width: 680px) {

  /* Forzar slide a ancho completo */
  .logos-carousel {
    --slide-width: 100%;
    --slides-per-view: 1;
    --slides-gap: 0px;
  }
    .square-image{
	max-width:200px;
	width:100%;
  }

  .logos-carousel-swiper-wrapper {
    max-width: 100%;
    padding: 0 50px; /* espacio para las flechas */
  }

  .logos-carousel-slide {
    max-width: 100%;
    width: 100% !important;
    margin-right: 0 !important;
    display: flex !important;
    justify-content: center;
    align-items: center;
    min-height: 120px;
  }

  /* Asegurar que las imágenes dentro del slide se muestren */
  .logos-carousel-slide img {
    display: block;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Flechas sobrepuestas a los lados */
  .logos-carousel-swiper-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .logos-carousel-swiper-button.prev {
    left: 0;
  }
  .logos-carousel-swiper-button.next {
    right: 0;
  }

  /* Dots visibles */
  .logos-carousel-mobile-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }

  .logos-carousel-mobile-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #a8c8a0;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    display: inline-block;
  }

  .logos-carousel-mobile-dot.is-active {
    background-color: #2d7a3e;
    transform: scale(1.3);
  }

}
{% endstyle %}

<script>
(function() {
  var sectionId = '{{ section.id }}';

  function initMobileDots() {
    var container = document.querySelector('[data-section-id="' + sectionId + '"]');
    if (!container) return;

    var swiperEl = container.querySelector('.logos-carousel-swiper');
    if (!swiperEl || !swiperEl.swiper) {
      setTimeout(initMobileDots, 150);
      return;
    }

    var swiper = swiperEl.swiper;
    var dots = container.querySelectorAll('.logos-carousel-mobile-dot');

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.getAttribute('data-index'), 10);
        swiper.slideTo(idx);
      });
    });

    swiper.on('slideChange', function() {
      dots.forEach(function(d, i) {
        d.classList.toggle('is-active', i === swiper.activeIndex);
      });
    });
  }

  // ── Autoplay de videos (assets laterales) al entrar a la sección, una sola vez ──
  function initVideoAutoplay() {
    var container = document.querySelector('[data-section-id="' + sectionId + '"]');
    if (!container) return;

    var videos = container.querySelectorAll('video[data-autoplay-once]');
    if (!videos.length) return;

    function playOnce(video) {
      if (video.dataset.played) return;
      video.dataset.played = '1';
      video.muted = true;
      var p = video.play();
      if (p && typeof p.catch === 'function') { p.catch(function(){}); }
    }

    if (!('IntersectionObserver' in window)) {
      videos.forEach(playOnce);
      return;
    }

    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          playOnce(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    videos.forEach(function(v) { io.observe(v); });
  }

  function init() {
    initMobileDots();
    initVideoAutoplay();
  }

  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init);
  }
})();
</script>
