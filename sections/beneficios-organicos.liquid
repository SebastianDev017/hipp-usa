{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif
-%}

<section class="ben ben-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="beneficios-organicos"
         style="
           --ben-bg: {{ s.bg_color }};
           --ben-title-color: {{ s.title_color }};
           --ben-highlight-color: {{ s.highlight_color }};
           --ben-text-color: {{ s.text_color }};
           --ben-bullet-color: {{ s.bullet_color }};
           --ben-title-font: {{ title_font_var }};
           --ben-body-font: {{ body_font_var }};
           --ben-icon-size-d: {{ s.icon_size_desktop }}px;
           --ben-icon-size-m: {{ s.icon_size_mobile }}px;
           --ben-title-size-d: {{ s.title_size_desktop }}px;
           --ben-title-size-m: {{ s.title_size_mobile }}px;
           --ben-text-size-d: {{ s.text_size_desktop }}px;
           --ben-text-size-m: {{ s.text_size_mobile }}px;
           --ben-text-align: {{ s.text_align }};
           --ben-text-max: {{ s.text_max_width }}px;
           --ben-cols-d: {{ s.columns_desktop }};
           --ben-cols-m: {{ s.columns_mobile }};
           --ben-col-gap-d: {{ s.column_gap_desktop }}px;
           --ben-col-gap-m: {{ s.column_gap_mobile }}px;
           --ben-row-gap-d: {{ s.row_gap_desktop }}px;
           --ben-row-gap-m: {{ s.row_gap_mobile }}px;
           --ben-title-gap-d: {{ s.title_gap_desktop }}px;
           --ben-title-gap-m: {{ s.title_gap_mobile }}px;
           --ben-max-width: {{ s.content_max_width }}px;
           --ben-pad-top-d: {{ s.padding_top_desktop }}px;
           --ben-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --ben-pad-top-m: {{ s.padding_top_mobile }}px;
           --ben-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
         ">

  <div class="ben-inner">

    {%- if s.title != blank -%}
      <div class="ben-title">{{ s.title }}</div>
    {%- endif -%}

    <div class="ben-grid">
      {%- for block in section.blocks -%}
        <div class="ben-item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="ben-icon">
              <img src="{{ block.settings.image | image_url: width: 500 }}"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy">
            </div>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="ben-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

</section>

{% style %}
.ben-{{ uid }} {
  background-color: var(--ben-bg, #ffffff);
  padding: var(--ben-pad-top-m, 40px) 20px var(--ben-pad-bottom-m, 40px);
}

.ben-{{ uid }} .ben-inner {
  max-width: var(--ben-max-width, 900px);
  margin: 0 auto;
}

.ben-{{ uid }} .ben-title {
  font-family: var(--ben-title-font);
  font-size: var(--ben-title-size-m, 22px);
  line-height: 1.25;
  color: var(--ben-title-color, #1f5a2c);
  font-weight: 700;
  text-align: center;
  margin: 0 auto var(--ben-title-gap-m, 28px);
}
.ben-{{ uid }} .ben-title strong,
.ben-{{ uid }} .ben-title b { color: var(--ben-highlight-color, #2d7a3e); }
.ben-{{ uid }} .ben-title p { margin: 0; }

/* GRID: en móvil por defecto 1 columna (apilado); en desktop varias columnas */
.ben-{{ uid }} .ben-grid {
  display: grid;
  grid-template-columns: repeat(var(--ben-cols-m, 1), minmax(0, 1fr));
  column-gap: var(--ben-col-gap-m, 14px);
  row-gap: var(--ben-row-gap-m, 32px);
  align-items: start;
  justify-items: center;
}

/* Cada celda: ícono centrado + texto centrado debajo */
.ben-{{ uid }} .ben-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-width: 0;
}

.ben-{{ uid }} .ben-icon { line-height: 0; }
.ben-{{ uid }} .ben-icon img {
  display: block;
  width: var(--ben-icon-size-m, 96px);
  height: auto;
  margin: 0 auto;
}

/* Contenedor de texto: ancho máximo y CENTRADO (viñetas alineadas a la izq dentro del bloque) */
.ben-{{ uid }} .ben-text {
  font-family: var(--ben-body-font);
  font-size: var(--ben-text-size-m, 15px);
  line-height: 1.5;
  color: var(--ben-text-color, #1f5a2c);
  text-align: var(--ben-text-align, left);
  width: 100%;
  max-width: var(--ben-text-max, 340px);
  margin-left: auto;
  margin-right: auto;
}
.ben-{{ uid }} .ben-text p { margin: 0 0 8px; }
.ben-{{ uid }} .ben-text p:last-child { margin-bottom: 0; }
.ben-{{ uid }} .ben-text strong,
.ben-{{ uid }} .ben-text b { color: var(--ben-highlight-color, #2d7a3e); font-weight: 700; }

/* Viñetas con punto verde */
.ben-{{ uid }} .ben-text ul { list-style: none; margin: 0; padding: 0; }
.ben-{{ uid }} .ben-text li {
  position: relative;
  padding-left: 16px;
  margin: 0 0 7px;
}
.ben-{{ uid }} .ben-text li:last-child { margin-bottom: 0; }
.ben-{{ uid }} .ben-text li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.55em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ben-bullet-color, #2d7a3e);
}

@media (min-width: 768px) {
  .ben-{{ uid }} { padding: var(--ben-pad-top-d, 64px) 40px var(--ben-pad-bottom-d, 64px); }
  .ben-{{ uid }} .ben-title {
    font-size: var(--ben-title-size-d, 32px);
    margin-bottom: var(--ben-title-gap-d, 44px);
  }
  .ben-{{ uid }} .ben-grid {
    grid-template-columns: repeat(var(--ben-cols-d, 3), minmax(0, 1fr));
    column-gap: var(--ben-col-gap-d, 32px);
    row-gap: var(--ben-row-gap-d, 48px);
  }
  .ben-{{ uid }} .ben-icon img { width: var(--ben-icon-size-d, 100px); }
  .ben-{{ uid }} .ben-text { font-size: var(--ben-text-size-d, 15px); }
}
{% endstyle %}

{% schema %}
{
  "name": "Beneficios orgánicos",
  "tag": "section",
  "class": "ben-section",
  "settings": [
    { "type": "header", "content": "📝 Título" },
    { "type": "richtext", "id": "title", "label": "Título", "default": "<p>Beneficios de una <strong>alimentación orgánica</strong></p>" },
    { "type": "paragraph", "content": "Cada beneficio es un bloque: ícono (PNG) arriba + viñetas debajo. En móvil se apila en 1 columna (centrado) y en escritorio se acomoda en cuadrícula. Para las viñetas usa el botón de lista con viñetas del editor." },

    { "type": "header", "content": "🔲 Columnas (grid)" },
    { "type": "range", "id": "columns_desktop", "label": "Columnas — Escritorio", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columnas — Móvil", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "column_gap_desktop", "label": "Separación horizontal — Escritorio", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "column_gap_mobile", "label": "Separación horizontal — Móvil", "min": 6, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "row_gap_desktop", "label": "Separación vertical — Escritorio", "min": 12, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "row_gap_mobile", "label": "Separación vertical — Móvil", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 32 },

    { "type": "header", "content": "🖼 Íconos" },
    { "type": "range", "id": "icon_size_desktop", "label": "Tamaño del ícono — Escritorio", "min": 50, "max": 180, "step": 10, "unit": "px", "default": 100 },
    { "type": "range", "id": "icon_size_mobile", "label": "Tamaño del ícono — Móvil", "min": 40, "max": 160, "step": 2, "unit": "px", "default": 96 },

    { "type": "header", "content": "🎨 Colores" },
    { "type": "color", "id": "bg_color", "label": "Fondo de la sección", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1f5a2c" },
    { "type": "color", "id": "highlight_color", "label": "Color de texto resaltado (negritas)", "default": "#2d7a3e" },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#1f5a2c" },
    { "type": "color", "id": "bullet_color", "label": "Color de las viñetas", "default": "#2d7a3e" },

    { "type": "header", "content": "🔤 Tipografía" },
    {
      "type": "select", "id": "title_font", "label": "Fuente del título",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select", "id": "body_font", "label": "Fuente de textos",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "title_size_desktop", "label": "Tamaño del título — Escritorio", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño del título — Móvil", "min": 16, "max": 34, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "text_size_desktop", "label": "Tamaño del texto — Escritorio", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "text_size_mobile", "label": "Tamaño del texto — Móvil", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "📐 Diseño y espaciado" },
    {
      "type": "select", "id": "text_align", "label": "Alineación de las viñetas",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "text_max_width", "label": "Ancho máximo del bloque de texto", "min": 240, "max": 560, "step": 20, "unit": "px", "default": 340, "info": "Con 1 columna, esto centra las viñetas en un bloque angosto (como el ejemplo)." },
    { "type": "range", "id": "content_max_width", "label": "Ancho máximo del contenido", "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "title_gap_desktop", "label": "Espacio bajo el título — Escritorio", "min": 8, "max": 96, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "title_gap_mobile", "label": "Espacio bajo el título — Móvil", "min": 8, "max": 72, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaciado superior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaciado inferior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaciado superior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaciado inferior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "name": "Beneficio",
      "type": "beneficio",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ícono (PNG)" },
        { "type": "richtext", "id": "text", "label": "Viñetas / texto", "default": "<ul><li>Beneficio uno.</li><li>Beneficio dos.</li></ul>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Beneficios orgánicos",
      "category": "Nuestra Familia",
      "blocks": [
        { "type": "beneficio", "settings": { "text": "<ul><li>Mejor coordinación mano-ojo.</li><li>Mejor capacidad de concentración.</li><li>Mejor puntuación en IQ.</li></ul>" } },
        { "type": "beneficio", "settings": { "text": "<ul><li>Disminuye la posibilidad de presentar pubertad precoz.</li></ul>" } },
        { "type": "beneficio", "settings": { "text": "<ul><li>Consumir lácteos orgánicos puede ayudar a reducir hasta en un 36% las probabilidades de desarrollar eczema.</li></ul>" } },
        { "type": "beneficio", "settings": { "text": "<ul><li>Apoya el desarrollo hormonal de tus hijos de manera natural.</li></ul>" } },
        { "type": "beneficio", "settings": { "text": "<ul><li>La exposición a pesticidas está relacionada con el desarrollo de muchos tipos de cáncer infantil.</li><li>Los alimentos orgánicos disminuyen el riesgo de desarrollar tumores, leucemia y otros.</li></ul>" } },
        { "type": "beneficio", "settings": { "text": "<ul><li>Disminuye la probabilidad de padecer asma.</li></ul>" } }
      ]
    }
  ]
}
{% endschema %}
