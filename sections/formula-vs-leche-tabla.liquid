{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.body_font == 'secondary'
    assign body_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign body_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif

  assign has_bg_image = false
  if s.background_image != blank
    assign has_bg_image = true
  endif

  assign row_blocks = section.blocks | where: 'type', 'row'
  assign rows_count = row_blocks | size
-%}

<section class="fvl-table fvl-table-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="formula-vs-leche-tabla"
         style="
           {% if s.use_bg_color %}--ft-bg: {{ s.background_color }};{% else %}--ft-bg: transparent;{% endif %}
           {% if has_bg_image %}--ft-bg-image: url('{{ s.background_image | image_url: width: 2000 }}');{% endif %}
           --ft-half-top-color: {{ s.half_top_color }};
           --ft-half-bottom-color: {{ s.half_bottom_color }};
           --ft-intro-color: {{ s.intro_color }};
           --ft-highlight-color: {{ s.highlight_color }};
           --ft-head-color: {{ s.head_color }};
           --ft-head-hipp-color: {{ s.head_hipp_color }};
           --ft-head-cow-color: {{ s.head_cow_color }};
           --ft-head-bg: {{ s.head_bg_color }};
           --ft-row-name-color: {{ s.row_name_color }};
           --ft-row-bg-odd: {{ s.row_bg_odd }};
           --ft-row-bg-even: {{ s.row_bg_even }};
           --ft-hipp-col-bg: {{ s.hipp_col_bg }};
           --ft-border-color: {{ s.border_color }};
           --ft-check-color: {{ s.check_color }};
           --ft-cross-color: {{ s.cross_color }};
           --ft-footnote-color: {{ s.footnote_color }};
           --ft-title-font: {{ title_font_var }};
           --ft-body-font: {{ body_font_var }};
           --ft-intro-size-d: {{ s.intro_size_desktop }}px;
           --ft-intro-size-m: {{ s.intro_size_mobile }}px;
           --ft-cell-size-d: {{ s.cell_size_desktop }}px;
           --ft-cell-size-m: {{ s.cell_size_mobile }}px;
           --ft-icon-size-d: {{ s.icon_size_desktop }}px;
           --ft-icon-size-m: {{ s.icon_size_mobile }}px;
           --ft-head-icon-size-d: {{ s.head_icon_size_desktop }}px;
           --ft-head-icon-size-m: {{ s.head_icon_size_mobile }}px;
           --ft-table-radius: {{ s.table_radius }}px;
           --ft-pad-top-d: {{ s.padding_top_desktop }}px;
           --ft-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --ft-pad-top-m: {{ s.padding_top_mobile }}px;
           --ft-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --ft-max-width: {{ s.content_max_width }}px;
         ">

  {%- if s.show_half_top -%}
    <div class="fvl-table-half fvl-table-half-top" aria-hidden="true"></div>
  {%- endif -%}
  {%- if s.show_half_bottom -%}
    <div class="fvl-table-half fvl-table-half-bottom" aria-hidden="true"></div>
  {%- endif -%}

  {%- if s.wave_image_top != blank -%}
    <div class="fvl-table-wave fvl-table-wave-top" aria-hidden="true">
      <img src="{{ s.wave_image_top | image_url: width: 2400 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

  <div class="fvl-table-inner">

    {%- if s.show_intro and s.intro != blank -%}
      <div class="fvl-table-intro">{{ s.intro }}</div>
    {%- endif -%}

    {%- if rows_count > 0 -%}
      <div class="fvl-table-wrap">
        <table class="fvl-table-grid">
          <thead>
            <tr>
              <th class="fvl-th fvl-th-name">
                {%- if s.head_col1_image != blank -%}
                  <span class="fvl-th-icon"><img src="{{ s.head_col1_image | image_url: width: 160 }}" alt="" loading="lazy"></span>
                {%- endif -%}
                <span class="fvl-th-label">{{ s.head_col1_label }}</span>
              </th>
              <th class="fvl-th fvl-th-hipp">
                {%- if s.head_col2_image != blank -%}
                  <span class="fvl-th-icon"><img src="{{ s.head_col2_image | image_url: width: 200 }}" alt="" loading="lazy"></span>
                {%- endif -%}
                <span class="fvl-th-label">{{ s.head_col2_label }}</span>
              </th>
              <th class="fvl-th fvl-th-cow">
                {%- if s.head_col3_image != blank -%}
                  <span class="fvl-th-icon"><img src="{{ s.head_col3_image | image_url: width: 200 }}" alt="" loading="lazy"></span>
                {%- endif -%}
                <span class="fvl-th-label">{{ s.head_col3_label }}</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {%- for block in row_blocks -%}
              <tr class="fvl-tr" {{ block.shopify_attributes }}>
                <td class="fvl-td fvl-td-name">{{ block.settings.name }}</td>

                <td class="fvl-td fvl-td-hipp">
                  {%- if block.settings.hipp_value -%}
                    {%- if s.check_icon_image != blank -%}
                      <img class="fvl-cell-icon" src="{{ s.check_icon_image | image_url: width: 80 }}" alt="Sí">
                    {%- else -%}
                      <svg class="fvl-cell-icon fvl-check" viewBox="0 0 24 24" aria-label="Sí"><circle cx="12" cy="12" r="11" fill="var(--ft-check-color)"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endif -%}
                  {%- else -%}
                    {%- if s.cross_icon_image != blank -%}
                      <img class="fvl-cell-icon" src="{{ s.cross_icon_image | image_url: width: 80 }}" alt="No">
                    {%- else -%}
                      <svg class="fvl-cell-icon fvl-cross" viewBox="0 0 24 24" aria-label="No"><circle cx="12" cy="12" r="11" fill="var(--ft-cross-color)"/><path d="M8 8l8 8M16 8l-8 8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
                    {%- endif -%}
                  {%- endif -%}
                </td>

                <td class="fvl-td fvl-td-cow">
                  {%- if block.settings.cow_value -%}
                    {%- if s.check_icon_image != blank -%}
                      <img class="fvl-cell-icon" src="{{ s.check_icon_image | image_url: width: 80 }}" alt="Sí">
                    {%- else -%}
                      <svg class="fvl-cell-icon fvl-check" viewBox="0 0 24 24" aria-label="Sí"><circle cx="12" cy="12" r="11" fill="var(--ft-check-color)"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {%- endif -%}
                  {%- else -%}
                    {%- if s.cross_icon_image != blank -%}
                      <img class="fvl-cell-icon" src="{{ s.cross_icon_image | image_url: width: 80 }}" alt="No">
                    {%- else -%}
                      <svg class="fvl-cell-icon fvl-cross" viewBox="0 0 24 24" aria-label="No"><circle cx="12" cy="12" r="11" fill="var(--ft-cross-color)"/><path d="M8 8l8 8M16 8l-8 8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
                    {%- endif -%}
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if s.show_footnote and s.footnote != blank -%}
      <div class="fvl-table-footnote">{{ s.footnote }}</div>
    {%- endif -%}

  </div>

  {%- if s.wave_image_bottom != blank -%}
    <div class="fvl-table-wave fvl-table-wave-bottom" aria-hidden="true">
      <img src="{{ s.wave_image_bottom | image_url: width: 2400 }}" alt="" loading="lazy">
    </div>
  {%- endif -%}

</section>

{% style %}
.fvl-table-{{ uid }} {
  position: relative;
  background-color: var(--ft-bg, transparent);
  {% if has_bg_image %}
  background-image: var(--ft-bg-image);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  {% endif %}
  padding: var(--ft-pad-top-m, 48px) 20px var(--ft-pad-bottom-m, 48px);
  overflow: hidden;
}

.fvl-table-{{ uid }} .fvl-table-half {
  position: absolute; left: 0; width: 100%; height: 50%; z-index: 0; pointer-events: none;
}
.fvl-table-{{ uid }} .fvl-table-half-top { top: 0; background: var(--ft-half-top-color, #c8d9b6); }
.fvl-table-{{ uid }} .fvl-table-half-bottom { bottom: 0; background: var(--ft-half-bottom-color, #c8d9b6); }

.fvl-table-{{ uid }} .fvl-table-wave {
  position: absolute; left: 0; width: 100%; line-height: 0; pointer-events: none; z-index: 1;
}
.fvl-table-{{ uid }} .fvl-table-wave img { width: 100%; height: auto; display: block; }
.fvl-table-{{ uid }} .fvl-table-wave-top { top: 0; }
.fvl-table-{{ uid }} .fvl-table-wave-bottom { bottom: 0; }

.fvl-table-{{ uid }} .fvl-table-inner {
  position: relative; z-index: 2;
  max-width: var(--ft-max-width, 1080);
  margin: 0 auto;
}

.fvl-table-{{ uid }} .fvl-table-intro {
  font-family: var(--ft-body-font);
  font-size: var(--ft-intro-size-m, 16px);
  line-height: 1.45;
  color: var(--ft-intro-color, #1f5a2c);
  text-align: center;
  margin-bottom: 28px;
}
.fvl-table-{{ uid }} .fvl-table-intro strong,
.fvl-table-{{ uid }} .fvl-table-intro b { color: var(--ft-highlight-color, #1f5a2c); font-weight: 700; }
.fvl-table-{{ uid }} .fvl-table-intro p { margin: 0; }

.fvl-table-{{ uid }} .fvl-table-wrap {
  border-radius: var(--ft-table-radius, 10px);
  overflow: hidden;
}

.fvl-table-{{ uid }} .fvl-table-grid {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.fvl-table-{{ uid }} .fvl-th {
  background: var(--ft-head-bg, transparent);
  padding: 14px 8px;
  text-align: center;
  vertical-align: bottom;
  border: 1px solid var(--ft-border-color, #8fc5e8);
}

.fvl-table-{{ uid }} .fvl-th-name { width: 40%; }

.fvl-table-{{ uid }} .fvl-th-icon {
  display: block;
  margin: 0 auto 6px;
  height: var(--ft-head-icon-size-m, 34px);
}
.fvl-table-{{ uid }} .fvl-th-icon img {
  height: 100%; width: auto; max-width: 100%; object-fit: contain; margin: 0 auto; display: block;
}

.fvl-table-{{ uid }} .fvl-th-label {
  display: block;
  font-family: var(--ft-body-font);
  font-weight: 700;
  font-size: var(--ft-cell-size-m, 11px);
  line-height: 1.25;
}
.fvl-table-{{ uid }} .fvl-th-name .fvl-th-label { color: var(--ft-head-color, #2d7a3e); }
.fvl-table-{{ uid }} .fvl-th-hipp .fvl-th-label { color: var(--ft-head-hipp-color, #2d7a3e); }
.fvl-table-{{ uid }} .fvl-th-cow .fvl-th-label { color: var(--ft-head-cow-color, #c45e3f); }

.fvl-table-{{ uid }} .fvl-td {
  padding: 12px 8px;
  text-align: center;
  border: 1px solid var(--ft-border-color, #8fc5e8);
}

.fvl-table-{{ uid }} .fvl-td-name {
  text-align: center;
  font-family: var(--ft-body-font);
  font-size: var(--ft-cell-size-m, 11px);
  color: var(--ft-row-name-color, #2d7a3e);
  font-weight: 600;
}

.fvl-table-{{ uid }} .fvl-td-hipp { background: var(--ft-hipp-col-bg, #dcecc9); }

.fvl-table-{{ uid }} .fvl-tr:nth-child(odd) .fvl-td-name,
.fvl-table-{{ uid }} .fvl-tr:nth-child(odd) .fvl-td-cow { background: var(--ft-row-bg-odd, #ffffff); }
.fvl-table-{{ uid }} .fvl-tr:nth-child(even) .fvl-td-name,
.fvl-table-{{ uid }} .fvl-tr:nth-child(even) .fvl-td-cow { background: var(--ft-row-bg-even, #f1f7ea); }

.fvl-table-{{ uid }} .fvl-cell-icon {
  width: var(--ft-icon-size-m, 24px);
  height: var(--ft-icon-size-m, 24px);
  display: inline-block;
  vertical-align: middle;
  object-fit: contain;
}

.fvl-table-{{ uid }} .fvl-table-footnote {
  font-family: var(--ft-body-font);
  font-size: 11px;
  line-height: 1.45;
  color: var(--ft-footnote-color, #6f8a5f);
  text-align: center;
  margin-top: 20px;
}
.fvl-table-{{ uid }} .fvl-table-footnote p { margin: 0; }

@media (min-width: 768px) {
  .fvl-table-{{ uid }} {
    padding: var(--ft-pad-top-d, 72px) 40px var(--ft-pad-bottom-d, 72px);
  }
  .fvl-table-{{ uid }} .fvl-table-intro { font-size: var(--ft-intro-size-d, 20px); margin-bottom: 36px; }
  .fvl-table-{{ uid }} .fvl-th { padding: 18px 12px; }
  .fvl-table-{{ uid }} .fvl-th-icon { height: var(--ft-head-icon-size-d, 44px); }
  .fvl-table-{{ uid }} .fvl-th-label { font-size: var(--ft-cell-size-d, 14px); }
  .fvl-table-{{ uid }} .fvl-td { padding: 15px 12px; }
  .fvl-table-{{ uid }} .fvl-td-name { font-size: var(--ft-cell-size-d, 14px); }
  .fvl-table-{{ uid }} .fvl-cell-icon { width: var(--ft-icon-size-d, 28px); height: var(--ft-icon-size-d, 28px); }
  .fvl-table-{{ uid }} .fvl-table-footnote { font-size: 12px; }
}
{% endstyle %}

{% schema %}
{
  "name": "FvL · Tabla",
  "tag": "section",
  "class": "fvl-table-section",
  "settings": [
    {
      "type": "header",
      "content": "📝 Texto introductorio"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Quote / introducción",
      "info": "Usa negrita para resaltar frases con el color de acento.",
      "default": "<p>La fórmula de continuación HiPP ofrece una <strong>composición nutricional adaptada</strong> a las necesidades específicas de tu bebé, algo que la leche de vaca convencional no puede garantizar.</p>"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "<p>*Referencia comparativa con la leche orgánica de vaca. Tabla comparativa de referencia nutrimental de etiquetas de HiPP etapa 1 - 3 años vs leche orgánica de vaca.</p>"
    },
    {
      "type": "header",
      "content": "👁 Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Mostrar introducción",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_footnote",
      "label": "Mostrar nota al pie",
      "default": true
    },
    {
      "type": "header",
      "content": "🏷 Encabezados de columna"
    },
    {
      "type": "image_picker",
      "id": "head_col1_image",
      "label": "Ícono columna 1 (Información Nutricional)"
    },
    {
      "type": "text",
      "id": "head_col1_label",
      "label": "Texto columna 1",
      "default": "Información Nutricional"
    },
    {
      "type": "image_picker",
      "id": "head_col2_image",
      "label": "Ícono/logo columna 2 (HiPP)"
    },
    {
      "type": "text",
      "id": "head_col2_label",
      "label": "Texto columna 2",
      "default": "Datos en una toma de 240 ml"
    },
    {
      "type": "image_picker",
      "id": "head_col3_image",
      "label": "Ícono columna 3 (vaca)"
    },
    {
      "type": "text",
      "id": "head_col3_label",
      "label": "Texto columna 3",
      "default": "Datos en una toma de 240 ml"
    },
    {
      "type": "header",
      "content": "✓ ✗ Íconos de celda"
    },
    {
      "type": "image_picker",
      "id": "check_icon_image",
      "label": "Ícono \"Sí\" (opcional)",
      "info": "Si lo subes, reemplaza la palomita por defecto."
    },
    {
      "type": "image_picker",
      "id": "cross_icon_image",
      "label": "Ícono \"No\" (opcional)",
      "info": "Si lo subes, reemplaza el tache por defecto."
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Color de la palomita (por defecto)",
      "default": "#5fa83f"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Color del tache (por defecto)",
      "default": "#d98a9a"
    },
    {
      "type": "header",
      "content": "🖼 Fondo"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "checkbox",
      "id": "use_bg_color",
      "label": "Usar color de fondo sólido",
      "info": "Apagado = fondo transparente.",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#c8d9b6"
    },
    {
      "type": "header",
      "content": "🟩 Fondo por mitades"
    },
    {
      "type": "paragraph",
      "content": "Pinta la mitad superior o inferior de la sección con un color sólido."
    },
    {
      "type": "checkbox",
      "id": "show_half_top",
      "label": "Fondo en la mitad superior",
      "default": false
    },
    {
      "type": "color",
      "id": "half_top_color",
      "label": "Color mitad superior",
      "default": "#c8d9b6"
    },
    {
      "type": "checkbox",
      "id": "show_half_bottom",
      "label": "Fondo en la mitad inferior",
      "default": false
    },
    {
      "type": "color",
      "id": "half_bottom_color",
      "label": "Color mitad inferior",
      "default": "#c8d9b6"
    },
    {
      "type": "header",
      "content": "🌊 Ondas de leche"
    },
    {
      "type": "image_picker",
      "id": "wave_image_top",
      "label": "Onda superior (SVG/PNG)"
    },
    {
      "type": "image_picker",
      "id": "wave_image_bottom",
      "label": "Onda inferior (SVG/PNG)"
    },
    {
      "type": "header",
      "content": "🎨 Colores de la tabla"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Color del texto introductorio",
      "default": "#1f5a2c"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Color de texto resaltado",
      "default": "#1f5a2c"
    },
    {
      "type": "color",
      "id": "head_bg_color",
      "label": "Fondo de encabezados",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "head_color",
      "label": "Texto encabezado columna 1",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "head_hipp_color",
      "label": "Texto encabezado HiPP",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "head_cow_color",
      "label": "Texto encabezado vaca",
      "default": "#c45e3f"
    },
    {
      "type": "color",
      "id": "row_name_color",
      "label": "Color del nombre de nutriente",
      "default": "#2d7a3e"
    },
    {
      "type": "color",
      "id": "row_bg_odd",
      "label": "Fondo filas impares",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "row_bg_even",
      "label": "Fondo filas pares",
      "default": "#f1f7ea"
    },
    {
      "type": "color",
      "id": "hipp_col_bg",
      "label": "Fondo columna HiPP (resaltado)",
      "default": "#dcecc9"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde de celdas",
      "default": "#8fc5e8"
    },
    {
      "type": "color",
      "id": "footnote_color",
      "label": "Color de la nota al pie",
      "default": "#6f8a5f"
    },
    {
      "type": "header",
      "content": "🔤 Tipografía"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Fuente de títulos",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Fuente de textos",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    {
      "type": "range",
      "id": "intro_size_desktop",
      "label": "Tamaño intro — Escritorio",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "intro_size_mobile",
      "label": "Tamaño intro — Móvil",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "cell_size_desktop",
      "label": "Tamaño texto de celdas — Escritorio",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "cell_size_mobile",
      "label": "Tamaño texto de celdas — Móvil",
      "min": 9,
      "max": 16,
      "step": 1,
