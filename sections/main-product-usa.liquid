{%- comment -%}
  HiPP USA — página de producto.

  Reemplaza a sections/main-product.liquid + snippets/main-product-form.liquid,
  que dependian de: el widget de ReCharge inyectado por id, un form de Klaviyo
  de cumpleanos, un cross-sell de Rebuy, los metafields custom.regalo_1/_2 y
  custom.suscripcion, el custom element <variant-radios> definido dentro de
  js-main-product.js (813 KB de webpack sin fuente), y un {% style %} que
  escondia la variante "4 Suscripción" por su data-title en español.

  Toma la mecanica de la pagina shop del diseno aprobado: elegi el bundle,
  elegi como lo queres, y un resumen oscuro con el total y el boton.

  DOS DECISIONES QUE CONVIENE SABER

  1. SIN JAVASCRIPT TAMBIEN FUNCIONA. Cuando el producto tiene una sola opcion
     (el caso real: "Boxes" 4/8/16), los radios se llaman name="id" y su value
     ES el id de la variante, asi que el form nativo ya manda la variante
     correcta. El JS solo refresca precio, imagen y disponibilidad. Con dos o
     tres opciones cae a un <select name="id"> con todas las combinaciones.
     Por eso NO hay un input hidden name="id": tener dos campos con ese nombre
     haria que el navegador mandara los dos.

  2. LA SUSCRIPCION VA CONTRA SELLING PLANS NATIVOS
     (product.selling_plan_groups), no contra un metafield ni contra una
     variante llamada "4 Suscripción". Shopify Subscriptions y ReCharge (en su
     integracion actual) registran los dos selling plans, asi que esta UI sirve
     con cualquiera de los dos y la decision se puede tomar despues. Si el
     producto no tiene ningun selling plan, el bloque entero no se renderiza y
     queda una compra unica: nunca aparece una opcion que no se pueda comprar.
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current = product.selected_or_first_available_variant
  assign single_option = false
  if product.options_with_values.size == 1 and product.has_only_default_variant == false
    assign single_option = true
  endif

  assign plan_group = product.selling_plan_groups | first
  assign has_plans = false
  if plan_group != blank and plan_group.selling_plans.size > 0
    assign has_plans = true
  endif

  assign subtitle = product.metafields.custom.subtitle.value
  if subtitle == blank
    assign subtitle = section.settings.fallback_subtitle
  endif

  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign accordions = section.blocks | where: 'type', 'accordion'
-%}

<section
  class="hp-pdp hp-section--tight"
  data-hp-product
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  data-label-add="{% if section.settings.add_label != blank %}{{ section.settings.add_label | escape }}{% else %}{{ 'products.product.add_to_cart' | t | escape }}{% endif %}"
  data-label-soldout="{{ 'products.product.sold_out' | t | escape }}"
>
  <div class="hp-wrap">
    <div class="hp-pdp__grid">
      {%- comment -%} ---------- Galeria ---------- {%- endcomment -%}
      <div class="hp-pdp__media">
        <div class="hp-pdp__stage">
          {%- if product.featured_image != blank -%}
            <img
              class="hp-pdp__img"
              data-hp-main-image
              src="{{ product.featured_image | image_url: width: 900 }}"
              srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 990px) 520px, 92vw"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hp-pdp__img hp-pdp__img--placeholder' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="hp-pdp__thumbs">
            {%- for image in product.images limit: 6 -%}
              <button
                type="button"
                class="hp-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-hp-thumb
                data-full="{{ image | image_url: width: 900 }}"
                data-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Compra ---------- {%- endcomment -%}
      <div class="hp-pdp__buy">
        {%- if product.type != blank -%}
          <p class="hp-kicker">{{ product.type }}</p>
        {%- endif -%}

        <h1 class="hp-pdp__title">{{ product.title }}</h1>

        {%- if subtitle != blank -%}
          <p class="hp-pdp__for">{{ subtitle }}</p>
        {%- endif -%}

        <p class="hp-pdp__price" data-hp-price>
          <span data-hp-price-current>{{ current.price | money }}</span>
          {%- if current.compare_at_price > current.price -%}
            <s data-hp-price-was>{{ current.compare_at_price | money }}</s>
          {%- else -%}
            <s data-hp-price-was hidden></s>
          {%- endif -%}
        </p>

        {%- if section.settings.shipping_note != blank -%}
          <p class="hp-pdp__ship">{{ section.settings.shipping_note }}</p>
        {%- endif -%}

        {%- form 'product', product, id: product_form_id, class: 'hp-pdp__form', novalidate: 'novalidate' -%}
          {%- comment -%} ---------- Paso 1: bundle ---------- {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            {%- if single_option -%}
              {%- assign option = product.options_with_values[0] -%}
              <fieldset class="hp-step">
                <legend class="hp-step__label">
                  <span class="hp-step__n">{{ section.settings.step_1_number }}</span>
                  <span class="hp-step__title">{{ section.settings.step_1_title | default: option.name }}</span>
                </legend>

                <div class="hp-tiles hp-tiles--3">
                  {%- for variant in product.variants -%}
                    <input
                      class="hp-tile__input"
                      type="radio"
                      name="id"
                      id="{{ section.id }}-variant-{{ variant.id }}"
                      value="{{ variant.id }}"
                      data-hp-variant="{{ variant.id }}"
                      {% if variant == current %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label class="hp-tile" for="{{ section.id }}-variant-{{ variant.id }}">
                      {%- if variant.metafields.custom.badge.value != blank -%}
                        <span class="hp-tile__badge">{{ variant.metafields.custom.badge.value }}</span>
                      {%- endif -%}
                      <span class="hp-tile__count">{{ variant.title }}</span>
                      <span class="hp-tile__unit">{{ section.settings.unit_label }}</span>
                      <span class="hp-tile__price">
                        {%- if variant.available -%}
                          {{ variant.price | money }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </label>
                  {%- endfor -%}
                </div>

                {%- if section.settings.unit_price_note != blank -%}
                  <p class="hp-step__note">{{ section.settings.unit_price_note }}</p>
                {%- endif -%}
              </fieldset>
            {%- else -%}
              {%- comment -%}
                Mas de una opcion: un unico <select> con todas las variantes.
                Es menos vistoso pero es correcto sin JS y no necesita resolver
                combinaciones invalidas en el cliente.
              {%- endcomment -%}
              <div class="hp-step">
                <label class="hp-step__label" for="{{ section.id }}-variant-select">
                  <span class="hp-step__title">{{ 'products.product.product_variants' | t }}</span>
                </label>
                <select class="hp-select" name="id" id="{{ section.id }}-variant-select">
                  {%- for variant in product.variants -%}
                    <option value="{{ variant.id }}" {% if variant == current %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                      {{ variant.title }} — {{ variant.price | money }}
                      {%- unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          {%- else -%}
            <input type="hidden" name="id" value="{{ current.id }}">
          {%- endunless -%}

          {%- comment -%} ---------- Paso 2: compra unica o suscripcion ---------- {%- endcomment -%}
          {%- if section.settings.subscription_ui == 'app' -%}
            {%- comment -%}
              Widget de la app Shopify Subscriptions.

              NO se renderiza junto con los tiles nativos: los dos escriben el
              campo `selling_plan` del mismo form, asi que tener los dos daria
              dos selectores compitiendo y el ultimo en pintar ganaria.

              Va DENTRO del <form> a proposito: el script de la app busca este
              div y monta ahi sus controles, que tienen que quedar en el mismo
              form que el boton de compra.

              Para que aparezca hace falta ademas tener activado el app embed de
              Shopify Subscriptions en Ajustes del tema > Incrustaciones de apps.
            {%- endcomment -%}
            <div class="hp-step hp-step--app">
              <div class="hp-step__label">
                <span class="hp-step__n">{{ section.settings.step_2_number }}</span>
                <span class="hp-step__title">{{ section.settings.step_2_title }}</span>
              </div>
              <div class="subscriptions_app_embed_block"></div>
            </div>
          {%- elsif has_plans -%}
            <fieldset class="hp-step">
              <legend class="hp-step__label">
                <span class="hp-step__n">{{ section.settings.step_2_number }}</span>
                <span class="hp-step__title">{{ section.settings.step_2_title }}</span>
              </legend>

              <div class="hp-tiles hp-tiles--2">
                <input class="hp-tile__input" type="radio" name="selling_plan" id="{{ section.id }}-plan-none" value="" checked>
                <label class="hp-tile hp-tile--wide" for="{{ section.id }}-plan-none">
                  <span class="hp-tile__head">{{ section.settings.onetime_title }}</span>
                  <span class="hp-tile__text">{{ section.settings.onetime_text }}</span>
                </label>

                {%- for plan in plan_group.selling_plans -%}
                  <input class="hp-tile__input" type="radio" name="selling_plan" id="{{ section.id }}-plan-{{ plan.id }}" value="{{ plan.id }}">
                  <label class="hp-tile hp-tile--wide" for="{{ section.id }}-plan-{{ plan.id }}">
                    <span class="hp-tile__head">{{ plan.name }}</span>
                    {%- assign allocation = current.selling_plan_allocations | where: 'selling_plan_id', plan.id | first -%}
                    {%- if allocation.price_adjustments.size > 0 -%}
                      <span class="hp-tile__text">{{ allocation.price | money }}</span>
                    {%- else -%}
                      <span class="hp-tile__text">{{ plan.description | default: section.settings.subscribe_text }}</span>
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- else -%}
            {%- if section.settings.subscription_pending_note != blank -%}
              <p class="hp-step__note hp-step__note--standalone">{{ section.settings.subscription_pending_note }}</p>
            {%- endif -%}
          {%- endif -%}

          {%- comment -%} ---------- Resumen ---------- {%- endcomment -%}
          <div class="hp-summary">
            <h2 class="hp-summary__title">{{ section.settings.summary_title }}</h2>
            <div class="hp-summary__row">
              <span>{{ product.title }}</span>
              <span data-hp-summary-variant>{{ current.title }}</span>
            </div>
            <div class="hp-summary__row">
              <span>{{ section.settings.shipping_row_label }}</span>
              <span class="hp-summary__free">{{ section.settings.shipping_row_value }}</span>
            </div>
            <div class="hp-summary__row hp-summary__row--total">
              <span>{{ section.settings.total_label }}</span>
              <span data-hp-summary-total>{{ current.price | money }}</span>
            </div>

            <button
              class="hp-btn hp-btn--clay hp-btn--block hp-summary__cta"
              type="submit"
              name="add"
              data-hp-atc
              {% unless current.available %}disabled{% endunless %}
            >
              {%- comment -%}
                Ojo con `| default: 'una.clave' | t`: si el setting TIENE valor,
                el filtro t igual se aplica sobre ese texto y devuelve
                "Translation missing". Por eso el fallback va con un if.
              {%- endcomment -%}
              <span data-hp-atc-label>
                {%- if current.available == false -%}
                  {{ 'products.product.sold_out' | t }}
                {%- elsif section.settings.add_label != blank -%}
                  {{ section.settings.add_label }}
                {%- else -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- endif -%}
              </span>
            </button>

            {%- if section.settings.summary_note != blank -%}
              <p class="hp-summary__note">{{ section.settings.summary_note }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}

        {%- if trust_blocks.size > 0 -%}
          <div class="hp-trust">
            {%- for block in trust_blocks -%}
              <div {{ block.shopify_attributes }}>
                <strong>{{ block.settings.title }}</strong>
                {{ block.settings.text }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.description != blank or accordions.size > 0 -%}
          <div class="hp-faq__list hp-pdp__details">
            {%- if product.description != blank -%}
              <details class="hp-faq__item" open>
                <summary class="hp-faq__q">{{ section.settings.description_title }}</summary>
                <div class="hp-faq__a hp-rte">{{ product.description }}</div>
              </details>
            {%- endif -%}
            {%- for block in accordions -%}
              <details class="hp-faq__item" {{ block.shopify_attributes }}>
                <summary class="hp-faq__q">{{ block.settings.title }}</summary>
                <div class="hp-faq__a hp-rte">{{ block.settings.content }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    Los datos de variante para el JS. Van en un <script type="application/json">
    y no en atributos data-*: asi el precio formateado sale del filtro | money
    de Liquid, que respeta el formato de moneda de la tienda, en vez de que el
    cliente lo re-arme y se desincronice.
  {%- endcomment -%}
  <script type="application/json" data-hp-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available }},
          "price": {{ variant.price | money | strip_html | json }},
          "compare_at_price": {{ variant.compare_at_price | money | strip_html | json }},
          "has_compare_at": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
          "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: 'HiPP' | json }} },
    {%- if product.featured_image -%}
      "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "sku": {{ current.sku | json }},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Producto",
  "class": "hp-product-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "fallback_subtitle",
      "label": "Bajada por defecto",
      "info": "Se usa si el producto no tiene el metafield custom.subtitle.",
      "default": "Sourced direct from HiPP in Germany"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Nota de envío",
      "default": "Free 2 day shipping across the USA, on every order."
    },
    {
      "type": "header",
      "content": "Paso 1 · Bundle"
    },
    {
      "type": "text",
      "id": "step_1_number",
      "label": "Numeral",
      "default": "Step 1"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Título",
      "default": "Choose your bundle"
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Unidad",
      "default": "boxes"
    },
    {
      "type": "text",
      "id": "unit_price_note",
      "label": "Nota bajo los bundles",
      "default": "$29 per box on every bundle."
    },
    {
      "type": "header",
      "content": "Paso 2 · Suscripción"
    },
    {
      "type": "select",
      "id": "subscription_ui",
      "label": "Selector de suscripción",
      "info": "El diseño HiPP lee los planes de Shopify Subscriptions directamente. Usá el widget de la app solo si necesitás sus controles propios; requiere activar su app embed en Ajustes del tema.",
      "options": [
        { "value": "native", "label": "Diseño HiPP" },
        { "value": "app", "label": "Widget de Shopify Subscriptions" }
      ],
      "default": "native"
    },
    {
      "type": "text",
      "id": "step_2_number",
      "label": "Numeral",
      "default": "Step 2"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Título",
      "default": "How would you like it?"
    },
    {
      "type": "text",
      "id": "onetime_title",
      "label": "Compra única · título",
      "default": "One time"
    },
    {
      "type": "text",
      "id": "onetime_text",
      "label": "Compra única · texto",
      "default": "A single delivery, free, at your door in 2 days."
    },
    {
      "type": "text",
      "id": "subscribe_text",
      "label": "Suscripción · texto por defecto",
      "default": "Delivered on your rhythm. Skip, switch or cancel anytime."
    },
    {
      "type": "text",
      "id": "subscription_pending_note",
      "label": "Nota si no hay suscripción activa",
      "info": "Se muestra solo cuando el producto todavía no tiene planes de suscripción. Vacío = no se muestra nada."
    },
    {
      "type": "header",
      "content": "Resumen"
    },
    {
      "type": "text",
      "id": "summary_title",
      "label": "Título",
      "default": "Your bundle"
    },
    {
      "type": "text",
      "id": "shipping_row_label",
      "label": "Fila de envío · etiqueta",
      "default": "2 day shipping"
    },
    {
      "type": "text",
      "id": "shipping_row_value",
      "label": "Fila de envío · valor",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Botón de compra",
      "default": "Checkout, at your door in 2 days"
    },
    {
      "type": "text",
      "id": "summary_note",
      "label": "Nota bajo el botón",
      "default": "Order by noon and it arrives within 2 days."
    },
    {
      "type": "header",
      "content": "Descripción"
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Título del acordeón",
      "default": "About this formula"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Garantía",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "2 day shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "free on every order"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Acordeón",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "How to prepare"
        },
        {
