{{- 'css-faqs.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'js-faqs.js' | asset_url }}" defer></script>

{%- liquid
  assign valid_blocks = ''
  for block in section.blocks
    if block.settings.title != blank and block.settings.answer != blank
      assign valid_blocks = valid_blocks | append: block.id | append: ','
    endif
  endfor
  assign valid_count = 0
  if valid_blocks != blank
    assign valid_count = valid_blocks | split: ',' | size
  endif
-%}

{%- if valid_count > 0 -%}
  <div class="faqs-section page-content" data-section-id="{{- section.id -}}" data-section-type="faqs">
    {%- for block in section.blocks -%}
      {%- liquid
        assign title = block.settings.title
        assign answer = block.settings.answer
      -%}
      {%- if title != blank and answer != blank -%}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <div class="faq-item-header">
            <p class="faq-item-title">{{- title -}}</p>
            <span class="faq-item-icon"></span>
          </div>
          <div class="faq-item-content-wrapper">
            <div class="faq-item-content page-text page-text-fit">{{- answer -}}</div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign printed = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank and block.settings.answer != blank -%}
          {%- if printed > 0 -%},{%- endif -%}
          {
            "@type": "Question",
            "name": {{ block.settings.title | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }
          {%- assign printed = printed | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
