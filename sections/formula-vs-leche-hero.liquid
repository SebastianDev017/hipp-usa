{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  if s.intro_font == 'secondary'
    assign intro_font_var = 'var(--secondary-font, Helvetica, Arial, sans-serif)'
  else
    assign intro_font_var = 'var(--primary-font, Helvetica, Arial, sans-serif)'
  endif
-%}

<section class="fvl-hero fvl-hero-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="formula-vs-leche-hero"
         style="
           --fh-section-bg: {{ s.section_bg_color }};
           --fh-content-bg: {{ s.content_bg_color }};
           {% if s.wave_image_top != blank %}--fh-wave-top: url('{{ s.wave_image_top | image_url: width: 2400 }}');{% endif %}
           {% if s.wave_image_bottom != blank %}--fh-wave-bottom: url('{{ s.wave_image_bottom | image_url: width: 2400 }}');{% endif %}
           --fh-wave-h-d: {{ s.wave_height_desktop }}px;
           --fh-wave-h-m: {{ s.wave_height_mobile }}px;
           --fh-title-color: {{ s.title_color }};
           --fh-vs-color: {{ s.vs_color }};
           --fh-intro-color: {{ s.intro_color }};
           --fh-highlight-color: {{ s.highlight_color }};
           --fh-title-font: {{ title_font_var }};
           --fh-intro-font: {{ intro_font_var }};
           --fh-title-size-d: {{ s.title_size_desktop }}px;
           --fh-title-size-m: {{ s.title_size_mobile }}px;
           --fh-title-lh: {{ s.title_line_height }};
           --fh-intro-size-d: {{ s.intro_size_desktop }}px;
           --fh-intro-size-m: {{ s.intro_size_mobile }}px;
           --fh-pad-top-d: {{ s.padding_top_desktop }}px;
           --fh-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --fh-pad-top-m: {{ s.padding_top_mobile }}px;
           --fh-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
           --fh-max-width: {{ s.content_max_width }}px;
           --fh-text-align: {{ s.text_align }};
         ">

  {%- comment -%} Onda superior: tira de altura fija; su borde verde conecta con el relleno. {%- endcomment -%}
  {%- if s.wave_image_top != blank -%}
    <div class="fvl-hero-wave fvl-hero-wave-top" aria-hidden="true"></div>
  {%- endif -%}

  <div class="fvl-hero-fill">
    <div class="fvl-hero-inner">

      {%- if s.title_main != blank or s.title_vs != blank or s.title_secondary != blank -%}
        <h1 class="fvl-hero-title">
          {%- unless s.title_main == blank -%}
            <span class="fvl-hero-title-main">{{ s.title_main }}</span>
          {%- endunless -%}

          {%- if s.show_vs and s.title_vs != blank -%}
            <span class="fvl-hero-title-vs">{{ s.title_vs }}</span>
          {%- endif -%}

          {%- unless s.title_secondary == blank -%}
            <span class="fvl-hero-title-secondary">{{ s.title_secondary }}</span>
          {%- endunless -%}
        </h1>
      {%- endif -%}

      {%- if s.show_intro and s.intro != blank -%}
        <div class="fvl-hero-intro">{{ s.intro }}</div>
      {%- endif -%}

    </div>
  </div>

  {%- if s.wave_image_bottom != blank -%}
    <div class="fvl-hero-wave fvl-hero-wave-bottom" aria-hidden="true"></div>
  {%- endif -%}

</section>

{% style %}
.fvl-hero-{{ uid }} {
  position: relative;
  background-color: var(--fh-section-bg, transparent);
  text-align: var(--fh-text-align, center);
  overflow: hidden;
}

/* Ondas: tira de altura FIJA (igual en móvil y desktop, no escala con el ancho).
   La imagen (verde + transparente) se pega al borde; su borde verde toca el relleno. */
.fvl-hero-{{ uid }} .fvl-hero-wave {
  width: 100%;
  height: var(--fh-wave-h-m, 120px);
  /* Onda seamless (tile espejo): mantiene su tamaño natural y se repite en X
     sin costura ni líneas blancas, en cualquier ancho de pantalla. */
  background-repeat: repeat-x;
  background-size: 1000px;
  line-height: 0;
  overflow: hidden;
}
.fvl-hero-{{ uid }} .fvl-hero-wave-top {
  background-image: var(--fh-wave-top);
  background-position: top center;
}
.fvl-hero-{{ uid }} .fvl-hero-wave-bottom {
  background-image: var(--fh-wave-bottom);
  background-position: bottom center;
}

/* Relleno verde SOLO detrás del contenido */
.fvl-hero-{{ uid }} .fvl-hero-fill {
  background: var(--fh-content-bg, #e8efe2);
  padding: var(--fh-pad-top-m, 40px) 20px var(--fh-pad-bottom-m, 40px);
}

.fvl-hero-{{ uid }} .fvl-hero-inner {
  max-width: var(--fh-max-width, 680px);
  margin: 0 auto;
}

.fvl-hero-{{ uid }} .fvl-hero-title {
  font-family: var(--fh-title-font);
  font-size: var(--fh-title-size-m, 28px);
  line-height: var(--fh-title-lh, 1.15);
  color: var(--fh-title-color, #1f5a2c);
  font-weight: 700;
  margin: 0 0 16px;
}

.fvl-hero-{{ uid }} .fvl-hero-title-main,
.fvl-hero-{{ uid }} .fvl-hero-title-secondary { display: block; }

.fvl-hero-{{ uid }} .fvl-hero-title-vs {
  display: block;
  color: var(--fh-vs-color, #1f5a2c);
}

.fvl-hero-{{ uid }} .fvl-hero-intro {
  font-family: var(--fh-intro-font);
  font-size: var(--fh-intro-size-m, 14.5px);
  line-height: 1.6;
  color: var(--fh-intro-color, #2c1a0e);
}

.fvl-hero-{{ uid }} .fvl-hero-intro strong,
.fvl-hero-{{ uid }} .fvl-hero-intro b {
  color: var(--fh-highlight-color, #2d7a3e);
  font-weight: 700;
}

.fvl-hero-{{ uid }} .fvl-hero-intro p { margin: 0; }
.fvl-hero-{{ uid }} .fvl-hero-intro p + p { margin-top: 12px; }

@media (min-width: 768px) {
  .fvl-hero-{{ uid }} .fvl-hero-wave { height: var(--fh-wave-h-d, 160px); }

  .fvl-hero-{{ uid }} .fvl-hero-fill {
    padding: var(--fh-pad-top-d, 64px) 40px var(--fh-pad-bottom-d, 64px);
  }

  .fvl-hero-{{ uid }} .fvl-hero-title { font-size: var(--fh-title-size-d, 48px); }
  .fvl-hero-{{ uid }} .fvl-hero-intro { font-size: var(--fh-intro-size-d, 17px); }
}
{% endstyle %}

{% schema %}
{
  "name": "FvL · Hero",
  "tag": "section",
  "class": "fvl-hero-section",
  "settings": [
    { "type": "header", "content": "📝 Contenido del título" },
    { "type": "text", "id": "title_main", "label": "Línea principal", "default": "Fórmula de continuación HiPP" },
    { "type": "text", "id": "title_vs", "label": "Conector central", "default": "VS" },
    { "type": "text", "id": "title_secondary", "label": "Línea secundaria", "default": "Leche orgánica de vaca" },
    { "type": "richtext", "id": "intro", "label": "Párrafo introductorio (opcional)", "info": "Usa negrita para resaltar texto con el color de acento." },

    { "type": "header", "content": "👁 Visibilidad de elementos" },
    { "type": "checkbox", "id": "show_vs", "label": "Mostrar conector central (VS)", "default": true },
    { "type": "checkbox", "id": "show_intro", "label": "Mostrar párrafo introductorio", "default": false },

    { "type": "header", "content": "🌊 Ondas + fondo" },
    { "type": "paragraph", "content": "Las ondas son tiras de altura FIJA (igual en móvil y desktop). El verde va SOLO detrás del contenido, así la onda transparente deja ver el blanco de la página. El verde del relleno debe ser el MISMO verde de tus PNG (#e8efe2)." },
    { "type": "image_picker", "id": "wave_image_top", "label": "Onda superior (PNG transparente)", "info": "Déjalo vacío si no quieres onda arriba." },
    { "type": "image_picker", "id": "wave_image_bottom", "label": "Onda inferior (PNG transparente)", "info": "Déjalo vacío si no quieres onda abajo." },
    { "type": "range", "id": "wave_height_desktop", "label": "Alto de la onda — Escritorio", "min": 60, "max": 360, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "wave_height_mobile", "label": "Alto de la onda — Móvil", "min": 40, "max": 260, "step": 10, "unit": "px", "default": 120 },
    { "type": "color", "id": "content_bg_color", "label": "Verde detrás del contenido", "default": "#e8efe2" },
    { "type": "color", "id": "section_bg_color", "label": "Color de toda la sección (opcional)", "info": "Déjalo vacío = transparente (recomendado). Si le pones color, tapará el blanco que deja ver la onda." },

    { "type": "header", "content": "🎨 Colores de texto" },
    { "type": "color", "id": "title_color", "label": "Color del título", "default": "#1f5a2c" },
    { "type": "color", "id": "vs_color", "label": "Color del conector (VS)", "default": "#1f5a2c" },
    { "type": "color", "id": "intro_color", "label": "Color del párrafo", "default": "#2c1a0e" },
    { "type": "color", "id": "highlight_color", "label": "Color de texto resaltado (negritas)", "default": "#2d7a3e" },

    { "type": "header", "content": "🔤 Tipografía" },
    {
      "type": "select", "id": "title_font", "label": "Fuente del título",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "secondary"
    },
    {
      "type": "select", "id": "intro_font", "label": "Fuente del párrafo",
      "options": [
        { "value": "primary", "label": "Primaria del tema (sans)" },
        { "value": "secondary", "label": "Secundaria del tema (serif)" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "title_size_desktop", "label": "Tamaño del título — Escritorio", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "title_size_mobile", "label": "Tamaño del título — Móvil", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "title_line_height", "label": "Interlineado del título", "min": 1, "max": 1.6, "step": 0.1, "default": 1.2 },
    { "type": "range", "id": "intro_size_desktop", "label": "Tamaño del párrafo — Escritorio", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "intro_size_mobile", "label": "Tamaño del párrafo — Móvil", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 15 },

    { "type": "header", "content": "📐 Diseño y espaciado" },
    {
      "type": "select", "id": "text_align", "label": "Alineación del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "content_max_width", "label": "Ancho máximo del contenido", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaciado superior del contenido — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaciado inferior del contenido — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaciado superior del contenido — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaciado inferior del contenido — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "FvL · Hero", "category": "Formula vs Leche de Vaca" }
  ]
}
{% endschema %}
