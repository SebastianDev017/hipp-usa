{%- liquid
  assign uid = section.id | replace: '-', '' | downcase
  assign s = section.settings

  if s.title_font == 'primary'
    assign title_font_var = 'var(--primary-font-bold, Georgia, serif)'
  else
    assign title_font_var = 'var(--secondary-font-bold, Georgia, serif)'
  endif

  assign blocks_size = section.blocks | size
-%}

<section class="pau-ib pau-ib-{{ uid }}"
         data-section-id="{{ section.id }}"
         data-section-type="page-about-us-icon-blocks"
         style="
           {% if s.use_bg_color %}--pi-bg: {{ s.background_color }};{% else %}--pi-bg: transparent;{% endif %}
           --pi-eyebrow-color: {{ s.eyebrow_color }};
           --pi-title-color: {{ s.title_color }};
           --pi-row-title-color: {{ s.row_title_color }};
           --pi-item-color: {{ s.item_text_color }};
           --pi-title-font: {{ title_font_var }};
           --pi-cols-d: {{ s.desktop_columns }};
           --pi-cols-m: {{ s.mobile_columns }};
           --pi-circle-d: {{ s.circle_size_desktop }}px;
           --pi-circle-m: {{ s.circle_size_mobile }}px;
           --pi-icon-ratio: {{ s.icon_ratio }}%;
           --pi-colgap-d: {{ s.col_gap_desktop }}px;
           --pi-colgap-m: {{ s.col_gap_mobile }}px;
           --pi-rowgap: {{ s.row_gap }}px;
           --pi-rows-gap: {{ s.rows_gap }}px;
           --pi-eyebrow-d: {{ s.eyebrow_size_desktop }}px;
           --pi-eyebrow-m: {{ s.eyebrow_size_mobile }}px;
           --pi-title-d: {{ s.title_size_desktop }}px;
           --pi-title-m: {{ s.title_size_mobile }}px;
           --pi-rowtitle-d: {{ s.row_title_size_desktop }}px;
           --pi-rowtitle-m: {{ s.row_title_size_mobile }}px;
           --pi-item-d: {{ s.item_text_size_desktop }}px;
           --pi-item-m: {{ s.item_text_size_mobile }}px;
           --pi-max-width: {{ s.content_max_width }}px;
           --pi-pad-top-d: {{ s.padding_top_desktop }}px;
           --pi-pad-bottom-d: {{ s.padding_bottom_desktop }}px;
           --pi-pad-top-m: {{ s.padding_top_mobile }}px;
           --pi-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
         ">
  <div class="pau-ib-content">

    {%- if s.title_1 != blank or s.title_2 != blank -%}
      <header class="pau-ib-header">
        {%- unless s.title_1 == blank -%}
          <p class="pau-ib-eyebrow">{{ s.title_1 }}</p>
        {%- endunless -%}
        {%- unless s.title_2 == blank -%}
          <h2 class="pau-ib-title">{{ s.title_2 }}</h2>
        {%- endunless -%}
      </header>
    {%- endif -%}

    {%- if blocks_size > 0 -%}

      {%- comment -%} Fila 1: bloques 1-4 {%- endcomment -%}
      <div class="pau-ib-row">
        {%- unless s.row_1_title == blank -%}
          <h3 class="pau-ib-row-title">{{ s.row_1_title }}</h3>
        {%- endunless -%}
        <div class="pau-ib-grid">
          {%- for block in section.blocks limit: 4 -%}
            {%- if block.settings.url != blank -%}
              <a class="pau-ib-item" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="pau-ib-item" {{ block.shopify_attributes }}>
            {%- endif -%}
              <span class="pau-ib-circle" style="background: {{ block.settings.circle_color }};">
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 240 }}" alt="{{ block.settings.text | escape }}" loading="lazy" width="120" height="120">
                {%- endif -%}
              </span>
              {%- if block.settings.text != blank -%}
                <span class="pau-ib-item-text">{{ block.settings.text }}</span>
              {%- endif -%}
            {%- if block.settings.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Fila 2: bloques 5-8 (solo si existen o hay titulo) {%- endcomment -%}
      {%- if s.row_2_title != blank or blocks_size > 4 -%}
        <div class="pau-ib-row">
          {%- unless s.row_2_title == blank -%}
            <h3 class="pau-ib-row-title">{{ s.row_2_title }}</h3>
          {%- endunless -%}
          <div class="pau-ib-grid">
            {%- for block in section.blocks offset: 4 limit: 4 -%}
              {%- if block.settings.url != blank -%}
                <a class="pau-ib-item" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="pau-ib-item" {{ block.shopify_attributes }}>
              {%- endif -%}
                <span class="pau-ib-circle" style="background: {{ block.settings.circle_color }};">
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 240 }}" alt="{{ block.settings.text | escape }}" loading="lazy" width="120" height="120">
                  {%- endif -%}
                </span>
                {%- if block.settings.text != blank -%}
                  <span class="pau-ib-item-text">{{ block.settings.text }}</span>
                {%- endif -%}
              {%- if block.settings.url != blank -%}</a>{%- else -%}</div>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</section>

{% style %}
.pau-ib-{{ uid }} {
  background-color: var(--pi-bg, transparent);
  padding: var(--pi-pad-top-m, 48px) 20px var(--pi-pad-bottom-m, 48px);
}

.pau-ib-{{ uid }} .pau-ib-content {
  max-width: var(--pi-max-width, 1100px);
  margin: 0 auto;
}

.pau-ib-{{ uid }} .pau-ib-header {
  text-align: center;
  margin: 0 0 32px;
}

.pau-ib-{{ uid }} .pau-ib-eyebrow {
  font-family: var(--primary-font, Helvetica, Arial, sans-serif);
  font-size: var(--pi-eyebrow-m, 13px);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--pi-eyebrow-color, #5a8a5f);
  margin: 0 0 6px;
}

.pau-ib-{{ uid }} .pau-ib-title {
  font-family: "Advert Bold";
  font-size: var(--pi-title-m, 28px);
  line-height: 1.15;
  font-weight: 700;
  color: var(--pi-title-color, #1f5a2c);
  margin: 0;
}

.pau-ib-{{ uid }} .pau-ib-title strong,
.pau-ib-{{ uid }} .pau-ib-title b { font-weight: 800; }

.pau-ib-{{ uid }} .pau-ib-row + .pau-ib-row {
  margin-top: var(--pi-rows-gap, 40px);
}

.pau-ib-{{ uid }} .pau-ib-row-title {
  text-align: center;
  font-family: "Advert Bold";
  font-size: var(--pi-rowtitle-m, 20px);
  font-weight: 700;
  color: var(--pi-row-title-color, #1f5a2c);
  margin: 0 0 24px;
}

.pau-ib-{{ uid }} .pau-ib-grid {
  display: grid;
  grid-template-columns: repeat(var(--pi-cols-m, 2), minmax(0, 1fr));
  column-gap: var(--pi-colgap-m, 16px);
  row-gap: var(--pi-rowgap, 28px);
  align-items: start;
  justify-items: center;
}

.pau-ib-{{ uid }} .pau-ib-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  text-decoration: none;
  color: inherit;
  width: 100%;
  max-width: 200px;
}

.pau-ib-{{ uid }} a.pau-ib-item { cursor: pointer; }
.pau-ib-{{ uid }} a.pau-ib-item:hover .pau-ib-circle { transform: translateY(-3px); }

.pau-ib-{{ uid }} .pau-ib-circle {
  width: var(--pi-circle-m, 78px);
  height: var(--pi-circle-m, 78px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 12px;
  transition: transform 0.25s ease;
  flex: none;
}

.pau-ib-{{ uid }} .pau-ib-circle img {
  width: var(--pi-icon-ratio, 52%);
  height: var(--pi-icon-ratio, 52%);
  object-fit: contain;
}

.pau-ib-{{ uid }} .pau-ib-item-text {
  font-family: var(--primary-font, Helvetica, Arial, sans-serif);
  font-size: var(--pi-item-m, 14px);
  line-height: 1.3;
  font-weight: 700;
  color: var(--pi-item-color, #1f5a2c);
}

@media (min-width: 768px) {
  .pau-ib-{{ uid }} {
    padding: var(--pi-pad-top-d, 72px) 40px var(--pi-pad-bottom-d, 72px);
  }
  .pau-ib-{{ uid }} .pau-ib-eyebrow { font-size: var(--pi-eyebrow-d, 14px); }
  .pau-ib-{{ uid }} .pau-ib-title { font-size: var(--pi-title-d, 44px); }
  .pau-ib-{{ uid }} .pau-ib-row-title { font-size: var(--pi-rowtitle-d, 26px); }
  .pau-ib-{{ uid }} .pau-ib-item-text { font-size: var(--pi-item-d, 15px); }
  .pau-ib-{{ uid }} .pau-ib-grid {
    grid-template-columns: repeat(var(--pi-cols-d, 4), minmax(0, 1fr));
    column-gap: var(--pi-colgap-d, 24px);
  }
  .pau-ib-{{ uid }} .pau-ib-circle {
    width: var(--pi-circle-d, 96px);
    height: var(--pi-circle-d, 96px);
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Bloques de íconos",
  "tag": "section",
  "class": "pau-ib-section",
  "settings": [
    { "type": "header", "content": "📝 Encabezado" },
    { "type": "text", "id": "title_1", "label": "Título 1 (antetítulo)", "default": "Lo más natural para tu bebé" },
    { "type": "inline_richtext", "id": "title_2", "label": "Título 2", "default": "HiPP evita el uso de:" },

    { "type": "header", "content": "🏷 Fila 1" },
    { "type": "text", "id": "row_1_title", "label": "Título de la fila 1", "default": "Residuos tóxicos" },

    { "type": "header", "content": "🏷 Fila 2" },
    { "type": "text", "id": "row_2_title", "label": "Título de la fila 2", "default": "Ingredientes no deseados" },

    { "type": "header", "content": "📐 Columnas del grid" },
    {
      "type": "select", "id": "desktop_columns", "label": "Columnas — Escritorio",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select", "id": "mobile_columns", "label": "Columnas — Móvil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },

    { "type": "header", "content": "⭕ Círculos e íconos" },
    { "type": "range", "id": "circle_size_desktop", "label": "Tamaño del círculo — Escritorio", "min": 60, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "circle_size_mobile", "label": "Tamaño del círculo — Móvil", "min": 48, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "icon_ratio", "label": "Tamaño del ícono (% del círculo)", "min": 30, "max": 80, "step": 5, "unit": "%", "default": 50 },

    { "type": "header", "content": "↔ Espaciado del grid" },
    { "type": "range", "id": "col_gap_desktop", "label": "Separación horizontal — Escritorio", "min": 8, "max": 64, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "col_gap_mobile", "label": "Separación horizontal — Móvil", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "row_gap", "label": "Separación vertical entre ítems", "min": 8, "max": 64, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "rows_gap", "label": "Separación entre Fila 1 y Fila 2", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 40 },

    { "type": "header", "content": "🎨 Colores" },
    { "type": "checkbox", "id": "use_bg_color", "label": "Usar color de fondo", "default": false },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#e8efe2" },
    { "type": "color", "id": "eyebrow_color", "label": "Color del antetítulo", "default": "#5a8a5f" },
    { "type": "color", "id": "title_color", "label": "Color del Título 2", "default": "#1f5a2c" },
    { "type": "color", "id": "row_title_color", "label": "Color de títulos de fila", "default": "#1f5a2c" },
    { "type": "color", "id": "item_text_color", "label": "Color del texto de ítems", "default": "#1f5a2c" },

    { "type": "header", "content": "🔤 Tipografía y tamaños" },
    {
      "type": "select", "id": "title_font", "label": "Fuente de títulos",
      "options": [
        { "value": "secondary", "label": "Secundaria del tema (serif)" },
        { "value": "primary", "label": "Primaria del tema (sans)" }
      ],
      "default": "primary"
    },
    { "type": "range", "id": "eyebrow_size_desktop", "label": "Antetítulo — Escritorio", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "eyebrow_size_mobile", "label": "Antetítulo — Móvil", "min": 9, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "title_size_desktop", "label": "Título 2 — Escritorio", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "title_size_mobile", "label": "Título 2 — Móvil", "min": 18, "max": 44, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "row_title_size_desktop", "label": "Título de fila — Escritorio", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "row_title_size_mobile", "label": "Título de fila — Móvil", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "item_text_size_desktop", "label": "Texto de ítem — Escritorio", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "item_text_size_mobile", "label": "Texto de ítem — Móvil", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 14 },

    { "type": "header", "content": "📐 Diseño general" },
    { "type": "range", "id": "content_max_width", "label": "Ancho máximo del contenido", "min": 600, "max": 1300, "step": 20, "unit": "px", "default": 1100 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaciado superior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaciado inferior — Escritorio", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaciado superior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaciado inferior — Móvil", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "image",
      "limit": 8,
      "name": "Ícono con texto",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Ícono" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "color", "id": "circle_color", "label": "Color del círculo", "default": "#d9e8c8" },
        { "type": "url", "id": "url", "label": "URL (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nosotros - Bloques de íconos",
      "blocks": [
        { "type": "image", "settings": { "text": "Fertilizantes artificiales", "circle_color": "#d9e8c8" } },
        { "type": "image", "settings": { "text": "Hormonas sintéticas y de crecimiento", "circle_color": "#d9e8c8" } },
        { "type": "image", "settings": { "text": "GMO's", "circle_color": "#f3dde2" } },
        { "type": "image", "settings": { "text": "Pesticidas", "circle_color": "#ecdff0" } },
        { "type": "image", "settings": { "text": "Azúcares añadidos", "circle_color": "#d6e6f0" } },
        { "type": "image", "settings": { "text": "Colorantes o saborizantes", "circle_color": "#f4e6d2" } },
        { "type": "image", "settings": { "text": "Soya", "circle_color": "#d9e8c8" } },
        { "type": "image", "settings": { "text": "Gluten", "circle_color": "#f3dde2" } }
      ]
    }
  ]
}
{% endschema %}
