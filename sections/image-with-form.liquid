{%- liquid 
  assign title = section.settings.title
  assign text = section.settings.text
  assign blocks = section.blocks
  assign blocks_size = blocks | size
-%}

{{- 'css-image-with-form.css' | asset_url | stylesheet_tag -}}

<div class="iwf section" 
     data-section-id="{{- section.id -}}" 
     data-section-type="iwf"
     style="--iwf-blocks: {{ blocks_size }};">

  {%- if title != blank or text != blank -%}
    <div class="iwf-content-wrapper">
      <div class="iwf-content section-content text-center">
        {%- unless title == blank -%}
          <header class="iwf-title-wrapper" data-aos="fade-up">
            <h2 class="iwf-title section-title-richtext color-green">{{- title -}}</h2>
          </header>
        {%- endunless -%}
        {%- unless text == blank -%}
          <p class="iwf-text section-title-richtext color-green" data-aos="fade-up">{{- text -}}</p>
        {%- endunless -%}
      </div>
    </div>
  {%- endif -%}

  {%- if blocks_size > 0 -%}
    <div class="iwf-blocks-grid iwf-blocks-grid--cols-{{ blocks_size }}">
      {%- for block in blocks -%}
        <div class="iwf-block" data-aos="fade-up" {{ block.shopify_attributes }}>

          {%- unless block.settings.block_title == blank -%}
            <h3 class="iwf-block-title color-green">{{ block.settings.block_title }}</h3>
          {%- endunless -%}

          <div class="iwf-grid">
            <div class="iwf-image-wrapper">
              {%- unless block.settings.image == blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" 
                     alt="{{ block.settings.image.alt }}" 
                     class="iwf-image"
                     loading="lazy">
              {%- endunless -%}
            </div>

            <div class="iwf-cta-wrapper">

              {%- case block.settings.cta_type -%}

                {%- when 'form' -%}
                  <div class="iwf-form">
                    {%- unless block.settings.form_title == blank -%}
                      <p class="iwf-form-title color-green secondary-font-bold">{{ block.settings.form_title }}</p>
                    {%- endunless -%}
                    {%- if block.settings.klaviyo_form_id != blank -%}
                      <div class="iwf-klaviyo-form">
                        <div class="recetario-form klaviyo-form-{{ block.settings.klaviyo_form_id }}" 
                             id="recetario-form-{{ block.id }}"></div>
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                    {%- capture target -%}
                      {%- if block.settings.button_link contains 'http' or block.settings.button_link contains 'tel:' or block.settings.button_link contains 'mailto:' -%}
                        target="_blank" rel="noopener"
                      {%- endif -%}
                    {%- endcapture -%}
                    <div class="iwf-button-wrapper">
                      <a href="{{ block.settings.button_link }}" 
                         class="iwf-button" 
                         {{ target }}>
                        {{ block.settings.button_label }}
                      </a>
                    </div>
                  {%- endif -%}

              {%- endcase -%}

            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Imagen con formulario",
  "tag": "section",
  "class": "iwf-section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido general"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texto"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "name": "Libro/Formulario",
      "type": "book",
      "settings": [
        {
          "type": "header",
          "content": "Contenido del bloque"
        },
        {
          "type": "text",
          "id": "block_title",
          "label": "Título del bloque",
          "info": "Ej: +6 meses, De 1 año en adelante"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del libro"
        },
        {
          "type": "header",
          "content": "Tipo de acción"
        },
        {
          "type": "select",
          "id": "cta_type",
          "label": "¿Qué mostrar bajo la imagen?",
          "options": [
            { "value": "form", "label": "Formulario Klaviyo" },
            { "value": "button", "label": "Botón con enlace" }
          ],
          "default": "button"
        },
        {
          "type": "header",
          "content": "Opción A — Formulario Klaviyo"
        },
        {
          "type": "text",
          "id": "form_title",
          "label": "Título del formulario",
          "info": "Opcional — Ej: ¡Lo quiero!"
        },
        {
          "type": "text",
          "id": "klaviyo_form_id",
          "label": "ID del formulario Klaviyo",
          "info": "Solo el código — Ej: YsGdVL"
        },
        {
          "type": "header",
          "content": "Opción B — Botón con enlace"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "¡Lo quiero!"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Homepage",
      "name": "Imagen con formulario"
    }
  ]
}
{% endschema %}

{% style %}

/* ── Styling de formularios Klaviyo ── */
.iwf [class^="klaviyo-form-"] form,
.iwf [class*=" klaviyo-form-"] form {
  padding: 0 !important;
}
.iwf [class^="klaviyo-form-"] form > div,
.iwf [class*=" klaviyo-form-"] form > div {
  min-height: auto !important;
}
.iwf [class^="klaviyo-form-"] input,
.iwf [class*=" klaviyo-form-"] input {
  height: clamp(58px, calc(58px + (72 - 58) * ((100vw - 680px) / (681 - 680))), 72px) !important;
  background: #f8faf3 !important;
  border-color: #f8faf3 !important;
  padding: 26px 10px 26px 26px !important;
  border-radius: 5px !important;
}
.iwf [class^="klaviyo-form-"] button,
.iwf [class*=" klaviyo-form-"] button {
  --background-color: #73af4c;
  --hover-background-color: #125b4e;
  max-width: 100% !important;
  width: 224px !important;
  height: 54px !important;
  background-color: var(--background-color) !important;
  border: 0 !important;
  border-radius: 5px !important;
  color: var(--white, #fff) !important;
  font-size: 18px !important;
  cursor: pointer !important;
}
.iwf [class^="klaviyo-form-"] button:hover,
.iwf [class*=" klaviyo-form-"] button:hover {
  background-color: var(--hover-background-color) !important;
}

/* ── Botón con enlace ── */
.iwf-button-wrapper {
  display: flex;
  justify-content: center;
  padding-top: 20px;
}

.iwf-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 224px;
  height: 54px;
  padding: 0 32px;
  background-color: #73af4c;
  color: #fff;
  border-radius: 5px;
  font-family: var(--secondary-font-bold, sans-serif);
  font-size: 18px;
  font-weight: 400;
  text-decoration: none;
  text-align: center;
  transition: background-color 0.3s ease;
  border-radius: 999px; /* Pill, como el diseño de referencia */
}

.iwf-button:hover {
  background-color: #125b4e;
  color: #fff;
  text-decoration: none;
}

/* ── Layout de los bloques ── */
.iwf-blocks-grid {
  display: grid;
  gap: 48px;
  max-width: 1440px;
  margin: 40px auto 0;
  padding: 0 63px;
}

@media (min-width: 834px) {
  .iwf-blocks-grid--cols-2,
  .iwf-blocks-grid--cols-3,
  .iwf-blocks-grid--cols-4,
  .iwf-blocks-grid--cols-5,
  .iwf-blocks-grid--cols-6 {
    grid-template-columns: repeat(2, 1fr);
    gap: 60px 48px;
  }
}

.iwf-blocks-grid--cols-1 .iwf-block {
  max-width: 100%;
}

.iwf-block {
  display: flex;
  flex-direction: column;
}

.iwf-block-title {
  font-size: clamp(22px, calc(22px + (32 - 22) * ((100vw - 1024px) / (1440 - 1024))), 32px);
  text-align: center;
  margin-bottom: 20px;
  font-weight: 700;
}

.iwf-blocks-grid--cols-2 .iwf-grid,
.iwf-blocks-grid--cols-3 .iwf-grid,
.iwf-blocks-grid--cols-4 .iwf-grid {
  grid-template-columns: minmax(0, 1fr);
  grid-row-gap: 20px;
}

.iwf-blocks-grid--cols-2 .iwf-cta-wrapper,
.iwf-blocks-grid--cols-3 .iwf-cta-wrapper,
.iwf-blocks-grid--cols-4 .iwf-cta-wrapper {
  padding-right: 0;
  max-width: 100%;
}

.iwf-blocks-grid--cols-2 .iwf-image-wrapper,
.iwf-blocks-grid--cols-3 .iwf-image-wrapper,
.iwf-blocks-grid--cols-4 .iwf-image-wrapper {
  aspect-ratio: 4/3;
}

/* Mobile */
@media (max-width: 833px) {
  .iwf-blocks-grid {
    grid-template-columns: minmax(0, 1fr) !important;
    padding: 0 21px;
    gap: 40px;
    margin-top: 24px;
  }

  .iwf-block-title {
    text-align: center;
    margin-bottom: 16px;
  }
}

{% endstyle %}
