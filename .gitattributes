# El tema viene con finales de linea LF y Shopify los espera asi.
# Esto evita que Windows convierta a CRLF y ensucie los diffs.
* text=auto eol=lf

*.liquid  text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.svg     text eol=lf
*.md      text eol=lf

# Binarios: nunca tocar
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.zip     binary
