{%- comment -%}
  reviews-collapse.liquid
  Colapsable para el widget de reseñas de Judge.me.
  - Mantiene el HEADER visible (rating, "Verificado" y medallas/sellos).
  - Colapsa solo la LISTA de reseñas (y oculta filtros/orden mientras está cerrado).
  - Botón "Ver reseñas / Ocultar reseñas". Cerrado por defecto.

  Uso: pega  {% render 'reviews-collapse' %}  dentro de la sección de reseñas
  (main-product-reviews), al final del bloque del widget.

  No modifica el DOM interno de Judge.me: el estado vive en el contenedor del
  tema (.product-reviews-widget), así que aguanta los re-render de la app.
{%- endcomment -%}

<style>
  .product-reviews-widget .jm-review-widget__body,
  .product-reviews-widget .jdgm-review-list {
    overflow: hidden;
    max-height: 8000px;
    opacity: 1;
    transition: max-height .55s ease, opacity .4s ease;
  }
  .product-reviews-widget.jdgm-reviews-collapsed .jm-review-widget__body,
  .product-reviews-widget.jdgm-reviews-collapsed .jdgm-review-list {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* Filtros/orden ocultos mientras está colapsado (rating y sellos se quedan) */
  .product-reviews-widget.jdgm-reviews-collapsed .jm-review-widget-minimal-header__filter-container {
    display: none !important;
  }

  .hipp-reviews-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 18px auto 4px;
    padding: 12px 28px;
    background: #1f5a2c;
    color: #fff;
    border: none;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background .2s ease;
    font-family: inherit;
  }
  .hipp-reviews-toggle:hover { background: #2d7a3e; }
  .hipp-reviews-toggle:focus-visible { outline: 2px solid #2d7a3e; outline-offset: 3px; }
  .hipp-reviews-toggle__chevron {
    display: inline-block;
    font-size: 12px;
    line-height: 1;
    transition: transform .3s ease;
  }
  .product-reviews-widget:not(.jdgm-reviews-collapsed) .hipp-reviews-toggle__chevron {
    transform: rotate(180deg);
  }
</style>

<script>
(function () {
  function setup(wrapper) {
    if (wrapper.dataset.hippCollapse) return true;            // ya configurado
    var widget = wrapper.querySelector('#judgeme_product_reviews, .jdgm-review-widget');
    var body   = wrapper.querySelector('.jm-review-widget__body, .jdgm-review-list');
    if (!widget || !body) return false;                       // Judge.me aún no renderiza

    wrapper.dataset.hippCollapse = '1';
    wrapper.classList.add('jdgm-reviews-collapsed');          // cerrado por defecto

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'hipp-reviews-toggle';
    btn.setAttribute('aria-expanded', 'false');
    btn.innerHTML =
      '<span class="hipp-reviews-toggle__label">Ver reseñas</span>' +
      '<span class="hipp-reviews-toggle__chevron" aria-hidden="true">&#9662;</span>';

    var anchor = wrapper.querySelector('.shopify-app-block') || widget;
    anchor.insertAdjacentElement('afterend', btn);

    btn.addEventListener('click', function () {
      var collapsed = wrapper.classList.toggle('jdgm-reviews-collapsed');
      btn.setAttribute('aria-expanded', String(!collapsed));
      wrapper.querySelector('.hipp-reviews-toggle__label').textContent =
        collapsed ? 'Ver reseñas' : 'Ocultar reseñas';
    });
    return true;
  }

  function init() {
    var all = document.querySelectorAll('.product-reviews-widget');
    var done = true;
    all.forEach(function (w) { if (!setup(w)) done = false; });
    return done;
  }

  function start() {
    if (init()) return;
    var obs = new MutationObserver(function () { if (init()) obs.disconnect(); });
    obs.observe(document.documentElement, { childList: true, subtree: true });
    setTimeout(function () { obs.disconnect(); }, 20000);     // corte de seguridad
  }

  if (document.readyState !== 'loading') start();
  else document.addEventListener('DOMContentLoaded', start);
})();
</script>
