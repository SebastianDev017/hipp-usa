{%- comment -%}
  HiPP USA — ilustracion del hero (colinas de Baviera).

  Va como SVG inline y no como imagen porque las 4 capas se mueven a distinta
  velocidad con el scroll: hipp-usa.js escribe un transform en cada <g> por su
  data attribute. Un <img> no permite eso, y separarlo en 4 archivos serian 4
  requests para algo que pesa 2 KB de markup.

  aria-hidden porque es decorativa: no aporta informacion que no este ya en el
  titulo y el parrafo del hero.
{%- endcomment -%}

<div class="hp-hero__art" aria-hidden="true">
  <svg viewBox="0 0 1440 360" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax slice" focusable="false">
    <g data-hp-sun>
      <circle cx="1096" cy="74" r="46" fill="#E0BA78"/>
      <circle cx="1096" cy="74" r="66" fill="#E0BA78" opacity="0.25"/>
    </g>
    <g data-hp-back>
      <path d="M0,206 C240,142 480,152 720,186 C960,220 1200,150 1440,182 L1440,360 L0,360 Z" fill="#D3E1BC"/>
    </g>
    <g data-hp-mid>
      <path d="M0,252 C200,202 420,206 640,236 C900,270 1150,206 1440,246 L1440,360 L0,360 Z" fill="#B4CE96"/>
      <g>
        <rect x="332" y="212" width="34" height="22" rx="2" fill="#FAF8F3"/>
        <path d="M328,214 L349,198 L370,214 Z" fill="#7A5B43"/>
        <rect x="344" y="222" width="8" height="12" rx="1" fill="#7A5B43" opacity="0.7"/>
      </g>
      <g fill="#46703A">
        <ellipse cx="946" cy="216" rx="17" ry="20"/><rect x="943" y="228" width="6" height="12" rx="2" fill="#6E5540"/>
        <ellipse cx="986" cy="208" rx="21" ry="25"/><rect x="983" y="224" width="6" height="14" rx="2" fill="#6E5540"/>
        <ellipse cx="1028" cy="218" rx="15" ry="18"/><rect x="1025" y="228" width="6" height="12" rx="2" fill="#6E5540"/>
        <ellipse cx="128" cy="232" rx="16" ry="19"/><rect x="125" y="242" width="6" height="12" rx="2" fill="#6E5540"/>
      </g>
    </g>
    <g data-hp-front>
      <path d="M0,300 C260,256 520,266 780,290 C1040,314 1240,270 1440,296 L1440,360 L0,360 Z" fill="#8FB271"/>
      <g fill="#FAF8F3">
        <ellipse cx="560" cy="308" rx="12" ry="7"/><circle cx="571" cy="304" r="4"/>
        <ellipse cx="640" cy="316" rx="10" ry="6"/><circle cx="649" cy="313" r="3.4"/>
        <ellipse cx="1180" cy="312" rx="11" ry="6.5"/><circle cx="1190" cy="308" r="3.6"/>
      </g>
      <path d="M0,332 C360,312 720,320 1080,330 C1260,334 1360,326 1440,331 L1440,360 L0,360 Z" fill="#6B9152"/>
      <g>
        <circle cx="210" cy="340" r="3" fill="#E0BA78"/><circle cx="255" cy="346" r="2.4" fill="#FAF8F3"/>
        <circle cx="850" cy="344" r="3" fill="#E0BA78"/><circle cx="905" cy="338" r="2.4" fill="#FAF8F3"/>
        <circle cx="1320" cy="342" r="3" fill="#E0BA78"/>
      </g>
    </g>
  </svg>
</div>
