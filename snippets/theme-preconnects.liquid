{% comment %}
---------------------------------------------------------------------
FUENTES
---------------------------------------------------------------------
{% endcomment %}
{%- comment -%}
  Solo el subset latin: es el que cubre el storefront en ingles. latin-ext se descarga
  bajo demanda por unicode-range. Estas URLs salen del mismo asset_url que los @font-face
  de snippets/hipp-fonts.liquid, asi que coinciden exacto y no hay doble descarga.
{%- endcomment -%}
<link rel="preload" href="{{- 'inter-latin.woff2' | asset_url -}}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{- 'fraunces-latin.woff2' | asset_url -}}" as="font" type="font/woff2" crossorigin>

{% comment %}
---------------------------------------------------------------------
CSS
---------------------------------------------------------------------
{% endcomment %}

<link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style">
<link rel="preload" href="{{ 'css-base.css' | asset_url }}" as="style">
<link rel="preload" href="{{ 'theme.js' | asset_url }}" as="script">
<link rel="preload" href="{{ 'js-commons.js' | asset_url }}" as="script">
<link rel="preload" href="{{ 'js-base.js' | asset_url }}" as="script">


{%- comment -%}
  La coleccion ya no precarga css-main-collection.css ni js-main-collection.js:
  la seccion nueva no los usa y precargar un asset que nadie consume tira el
  warning "preloaded but not used" y compite por ancho de banda con el LCP.
{%- endcomment -%}

{% if template.name == "product" %}
  <link rel="preload" href="{{ 'hipp-product.js' | asset_url }}" as="script">
{% endif %}

{% if template.name == "cart" %}
  <link rel="preload" href="{{ 'theme-cart.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'css-main-cart.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'js-main-cart.js' | asset_url }}" as="script">
{% endif %}

{% if template.directory == 'customers' %}
  <link rel="preload" href="{{ 'theme-customer.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'css-accounts.css' | asset_url }}" as="style">
{% endif %}
