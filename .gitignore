# --- Shopify ---
# Estado local del CLI (sesion, theme id de desarrollo). Nunca va al repo.
.shopify/
.shopifyignore

# Secretos
.env
.env.*
!.env.example
*.theme-access

# NOTA: config/settings_data.json SI se versiona.
# La integracion GitHub <-> Shopify lo sincroniza en las dos direcciones
# y contiene todo el contenido del customizer.

# --- Node / tooling ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
*.log

# --- Editores ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Sistema operativo ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Entregables / temporales ---
*.zip
*.tar.gz
/tmp/
/scratch/
